    "Who your emails come from, where replies go and your signatures.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Van wie jou e-posse kom, waarheen antwoorde gaan en jou handtekeninge."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من أين تأتي رسائلك، وإلى أين تذهب الردود، وتوقيعاتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ইমেল কার নামে যায়, উত্তর কোথায় যায় আর আপনার স্বাক্ষর।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "De qui venen els teus correus, on van les respostes i les teves signatures."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Od koho vaše zprávy chodí, kam jdou odpovědi a vaše podpisy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvem dine e-mails kommer fra, hvor svar sendes hen, og dine signaturer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Von wem deine E-Mails kommen, wohin Antworten gehen und deine Signaturen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Από ποιον έρχονται τα email σας, πού πάνε οι απαντήσεις και οι υπογραφές σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "De quién vienen tus correos, adónde van las respuestas y tus firmas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ایمیل‌هایتان از طرف چه کسی است، پاسخ‌ها کجا می‌روند و امضاهایتان."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Keneltä viestisi lähtevät, minne vastaukset menevät ja allekirjoituksesi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kanino galing ang mga email mo, saan napupunta ang mga reply at ang mga signature mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "De qui viennent vos e-mails, où vont les réponses, et vos signatures."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ממי ההודעות שלך מגיעות, לאן הולכות התשובות והחתימות שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके ईमेल किसकी ओर से जाते हैं, जवाब कहाँ जाते हैं और आपके सिग्नेचर।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Od koga stižu vaše e-poruke, kamo idu odgovori i vaši potpisi."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitől jönnek az e-mailjei, hová mennek a válaszok, és az aláírásai."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dari siapa email Anda dikirim, ke mana balasan dikirim, dan tanda tangan Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da chi arrivano le tue email, dove vanno le risposte e le tue firme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールの差出人、返信先、署名。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내는 주소, 회신 주소 및 서명."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Daripada siapa e-mel anda datang, ke mana balasan pergi dan tandatangan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvem e-postene dine kommer fra, hvor svar går, og signaturene dine."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Van wie je e-mails komen, waar antwoorden heen gaan en je handtekeningen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od kogo są Twoje wiadomości, dokąd idą odpowiedzi i Twoje podpisy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "De qual endereço seus e-mails saem, para onde vão as respostas e suas assinaturas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "De la cine pleacă e-mailurile, unde ajung răspunsurile și semnăturile tale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "От кого ваши письма, куда идут ответы и ваши подписи."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Od koho vaše správy chodia, kam idú odpovede a vaše podpisy."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Од кога стижу ваши имејлови, куда иду одговори и ваши потписи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vem dina mejl kommer från, vart svar går och dina signaturer."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Barua pepe zako zinatoka kwa nani, majibu yanaenda wapi na sahihi zako."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ ఈమెయిల్‌లు ఎవరి నుండి వెళ్తాయి, రిప్లైలు ఎక్కడికి వెళ్తాయి, మీ సిగ్నేచర్‌లు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีเมลของคุณส่งจากใคร การตอบกลับไปที่ใด และลายเซ็นของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "E-postalarınızın kimden geldiği, yanıtların nereye gittiği ve imzalarınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Від кого ваші листи, куди йдуть відповіді та ваші підписи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی ای میلز کس کی طرف سے آتی ہیں، جوابات کہاں جاتے ہیں اور آپ کے دستخط۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Email của bạn được gửi từ ai, thư trả lời đi đâu và chữ ký của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的邮件以谁的身份发出、回复发往何处以及你的签名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的郵件以誰的身分寄出、回覆寄往何處,以及你的簽名。"
          }
        }
      }
    },
