            "value": "سرور ایمیل شما درخواست را رد کرد: %@"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sähköpostipalvelimesi hylkäsi pyynnön: %@"
          }
        },
        "fil": {
          "stringUnit": {
