    "You can pick it up again from your Drafts folder.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jy kan later weer daarmee voortgaan vanuit jou Konsepte-vouer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكنك متابعتها لاحقًا من مجلد المسودات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার খসড়া ফোল্ডার থেকে আবার শুরু করতে পারবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El pots reprendre des de la carpeta Esborranys."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžete v ní pokračovat ze složky Koncepty."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fortsætte med den fra mappen Kladder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kannst sie später im Ordner „Entwürfe“ fortsetzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορείτε να το συνεχίσετε από τον φάκελο Πρόχειρα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Puedes retomarlo desde tu carpeta Borradores."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "می‌توانید از پوشه پیش‌نویس‌ها دوباره ادامه‌اش دهید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voit jatkaa sitä Luonnokset-kansiosta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Puwede mo itong ituloy ulit mula sa Drafts folder mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous pourrez le reprendre depuis votre dossier Brouillons."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להמשיך אותה מתיקיית הטיוטות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप इसे अपने ड्राफ़्ट फ़ोल्डर से फिर शुरू कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Možete je nastaviti iz mape Skice."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Később folytathatja a Piszkozatok mappából."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda dapat melanjutkannya dari folder Draf."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Puoi riprenderla dalla cartella Bozze."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下書きフォルダから再開できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "임시 저장 폴더에서 다시 이어서 작성할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda boleh menyambungnya semula dari folder Draf anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fortsette på det fra Utkast-mappen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je kunt het later weer oppakken in je map Concepten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Możesz do niej wrócić z folderu Wersje robocze."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você pode retomá-lo na pasta Rascunhos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O poți relua din dosarul Ciorne."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Его можно продолжить из папки «Черновики»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžete v nej pokračovať z priečinka Koncepty."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Можете га наставити из фасцикле Нацрти."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du kan fortsätta på det från mappen Utkast."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Unaweza kuiendeleza tena kutoka kwenye folda yako ya Rasimu."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు దీన్ని మీ డ్రాఫ్ట్‌లు ఫోల్డర్ నుండి మళ్లీ కొనసాగించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณสามารถเขียนต่อได้จากโฟลเดอร์ฉบับร่าง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Taslaklar klasörünüzden yeniden devam edebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Його можна продовжити з папки «Чернетки»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ اسے اپنے ڈرافٹس فولڈر سے دوبارہ جاری رکھ سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn có thể tiếp tục từ thư mục Nháp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以在“草稿”文件夹中继续编写。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你可以從「草稿」資料夾繼續撰寫。"
          }
        }
      }
    },
    "You're all caught up. Nothing unread in your inbox.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jy is op datum. Niks ongelees in jou inkassie nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لقد اطّلعت على كل شيء. لا يوجد غير مقروء في بريدك الوارد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি সব দেখে ফেলেছেন। ইনবক্সে কিছুই অপঠিত নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Estàs al dia. No hi ha res sense llegir a la safata d'entrada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte vše přečtené. V Přijatých nic nepřečteného není."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er ajour. Intet ulæst i din indbakke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist auf dem neuesten Stand. Nichts Ungelesenes im Posteingang."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είστε ενημερωμένοι. Τίποτα μη αναγνωσμένο στα Εισερχόμενα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estás al día. No hay nada sin leer en tu bandeja de entrada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه را دیده‌اید. چیز خوانده‌نشده‌ای در صندوق ورودی نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olet ajan tasalla. Saapuneissa ei ole lukemattomia."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakahabol ka na. Walang hindi pa nababasa sa inbox mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous êtes à jour. Rien de non lu dans votre boîte de réception."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתה מעודכן. אין שום דבר שלא נקרא בדואר הנכנס."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप पूरी तरह अप टू डेट हैं। आपके इनबॉक्स में कुछ भी अपठित नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sve ste pročitali. Nema nepročitanog u ulaznoj pošti."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindent elolvasott. Nincs olvasatlan a Bejövőben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua sudah terbaca. Tidak ada yang belum dibaca di kotak masuk."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sei in pari. Niente da leggere in In arrivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "すべて確認済みです。受信ボックスに未読はありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 확인했습니다. 받은 편지함에 읽지 않은 메일이 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Anda sudah mengikuti semuanya. Tiada yang belum dibaca dalam peti masuk anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er à jour. Ingenting ulest i innboksen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je bent helemaal bij. Niets ongelezen in Inkomend."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszystko nadrobione. Brak nieprzeczytanych w Odebranych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Você está em dia. Nada não lido na sua Caixa de Entrada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ești la zi. Nimic necitit în Intrări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вы всё прочитали. Во «Входящих» нет непрочитанного."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Máte všetko prečítané. V Prijatých nie je nič neprečítané."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Све сте прочитали. Нема непрочитаног у Пријемном сандучету."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Du är ikapp. Inget oläst i inkorgen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Umesoma zote. Hakuna kisichosomwa kwenye kikasha chako."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు అన్నీ చూశారు. మీ ఇన్‌బాక్స్‌లో చదవనివి ఏమీ లేవు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณอ่านครบแล้ว ไม่มีอีเมลที่ยังไม่ได้อ่านในกล่องจดหมายเข้า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hepsini okudunuz. Gelen kutunuzda okunmamış bir şey yok."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви все прочитали. У «Вхідних» немає непрочитаного."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ سب دیکھ چکے ہیں۔ آپ کے ان باکس میں کچھ غیر پڑھا نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn đã xem hết. Không có gì chưa đọc trong hộp thư đến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "全部看完了。收件箱中没有未读邮件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你已看完所有郵件。收件匣中沒有未讀郵件。"
          }
        }
      }
    },
    "You're offline. Check your connection and try again.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jy is vanlyn. Kontroleer jou verbinding en probeer weer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنت غير متصل. تحقق من الاتصال وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি অফলাইন। সংযোগ দেখে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No tens connexió. Comprova la connexió i torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jste offline. Zkontrolujte připojení a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du er offline. Tjek din forbindelse, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bist offline. Prüfe deine Verbindung und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Είστε εκτός σύνδεσης. Ελέγξτε τη σύνδεσή σας και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No tienes conexión. Compruébala e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آفلاین هستید. اتصال را بررسی کنید و دوباره امتحان کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
