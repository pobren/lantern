    "Apple Intelligence is still getting ready on this device. Try again later.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence maak nog gereed op hierdie toestel. Probeer later weer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تزال Apple Intelligence قيد التجهيز على هذا الجهاز. حاول مرة أخرى لاحقًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence এখনো এই ডিভাইসে তৈরি হচ্ছে। পরে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence encara s'està preparant en aquest dispositiu. Torna-ho a provar més tard."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence se na tomto zařízení ještě připravuje. Zkuste to později."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence er stadig ved at blive klar på denne enhed. Prøv igen senere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence wird auf diesem Gerät noch vorbereitet. Versuche es später erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Apple Intelligence ετοιμάζεται ακόμα σε αυτή τη συσκευή. Δοκιμάστε ξανά αργότερα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence aún se está preparando en este dispositivo. Inténtalo más tarde."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence هنوز روی این دستگاه در حال آماده شدن است. بعداً دوباره امتحان کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence valmistautuu vielä tällä laitteella. Yritä myöhemmin uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Inihahanda pa ang Apple Intelligence sa device na ito. Subukan ulit mamaya."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence est encore en préparation sur cet appareil. Réessayez plus tard."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence עדיין מתכונן במכשיר הזה. נסה שוב מאוחר יותר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence अभी इस डिवाइस पर तैयार हो रहा है। बाद में फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence još se priprema na ovom uređaju. Pokušajte kasnije."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple Intelligence még készül ezen az eszközön. Próbálja újra később."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence masih disiapkan di perangkat ini. Coba lagi nanti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence si sta ancora preparando su questo dispositivo. Riprova più tardi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligenceはこのデバイスでまだ準備中です。あとでもう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence가 이 기기에서 아직 준비 중입니다. 나중에 다시 시도하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence masih bersedia pada peranti ini. Cuba lagi kemudian."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence gjøres fortsatt klar på denne enheten. Prøv igjen senere."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence wordt nog voorbereid op dit apparaat. Probeer het later opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence wciąż przygotowuje się na tym urządzeniu. Spróbuj później."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple Intelligence ainda está sendo preparada neste dispositivo. Tente novamente mais tarde."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence încă se pregătește pe acest dispozitiv. Încearcă mai târziu."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence на этом устройстве ещё готовится. Повторите попытку позже."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence sa na tomto zariadení ešte pripravuje. Skúste to neskôr."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence се још припрема на овом уређају. Покушајте касније."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence förbereds fortfarande på den här enheten. Försök igen senare."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence bado inajiandaa kwenye kifaa hiki. Jaribu tena baadaye."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ఇంకా ఈ పరికరంలో సిద్ధమవుతోంది. తర్వాత మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence ยังเตรียมความพร้อมอยู่บนอุปกรณ์นี้ ลองอีกครั้งในภายหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence bu aygıtta hâlâ hazırlanıyor. Daha sonra yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence на цьому пристрої ще готується. Спробуйте пізніше."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence اس ڈیوائس پر ابھی تیار ہو رہی ہے۔ بعد میں دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence vẫn đang được chuẩn bị trên thiết bị này. Hãy thử lại sau."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 仍在此设备上准备中。请稍后再试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Intelligence 仍在此裝置上準備中。請稍後再試一次。"
          }
        }
      }
    },
