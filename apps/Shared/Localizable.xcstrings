    "Can I get back to you later?": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ek later na jou terugkom?"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل يمكنني الرد عليك لاحقًا؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি কি পরে আপনাকে জানাতে পারি?"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Et puc respondre més tard?"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Můžu se ozvat později?"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan jeg vende tilbage senere?"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Kann ich mich später melden?"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μπορώ να σας απαντήσω αργότερα;"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Te respondo más tarde?"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "می‌توانم بعداً جوابتان را بدهم؟"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Voinko palata asiaan myöhemmin?"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Puwede ba kitang balikan mamaya?"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je peux vous répondre plus tard ?"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לחזור אליך מאוחר יותר?"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "क्या मैं आपको बाद में जवाब दूँ?"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Mogu li vam se javiti kasnije?"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Később visszatérhetek rá?"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Boleh saya kabari nanti?"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso risponderti più tardi?"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "あとで連絡してもいいですか?"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "나중에 연락드려도 될까요?"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Boleh saya hubungi anda kemudian?"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan jeg komme tilbake til deg senere?"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan ik later bij je terugkomen?"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mogę odpisać później?"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Posso te responder mais tarde?"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Pot să revin mai târziu?"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Можно я отвечу позже?"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Môžem sa ozvať neskôr?"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Могу ли да вам се јавим касније?"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan jag återkomma senare?"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Naweza kukujibu baadaye?"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేను తర్వాత మీకు చెప్పవచ్చా?"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ขอติดต่อกลับภายหลังได้ไหม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonra dönüş yapabilir miyim?"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Можна я відповім пізніше?"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کیا میں آپ کو بعد میں جواب دے سکتا ہوں؟"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
