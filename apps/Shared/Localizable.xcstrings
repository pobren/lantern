          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto je jediný štítok tejto správy. Radšej ju archivujte alebo presuňte."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
