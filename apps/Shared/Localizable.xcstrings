    "Opens the JMAP Connect community, where people help each other and we answer.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak die JMAP Connect-gemeenskap oop, waar mense mekaar help en ons antwoord."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يفتح مجتمع JMAP Connect، حيث يساعد الناس بعضهم ونجيب نحن أيضًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP Connect কমিউনিটি খোলে, যেখানে লোকজন একে অপরকে সাহায্য করে আর আমরা উত্তর দিই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre la comunitat de JMAP Connect, on la gent s'ajuda i nosaltres responem."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře komunitu JMAP Connect, kde si lidé navzájem pomáhají a my odpovídáme."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbner JMAP Connect-fællesskabet, hvor folk hjælper hinanden, og vi svarer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffnet die JMAP Connect-Community, wo sich Leute gegenseitig helfen und wir antworten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει την κοινότητα του JMAP Connect, όπου οι χρήστες βοηθούν ο ένας τον άλλον και απαντάμε κι εμείς."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre la comunidad de JMAP Connect, donde la gente se ayuda y nosotros respondemos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انجمن JMAP Connect را باز می‌کند، جایی که افراد به هم کمک می‌کنند و ما هم پاسخ می‌دهیم."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa JMAP Connect -yhteisön, jossa ihmiset auttavat toisiaan ja me vastaamme."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Binubuksan ang JMAP Connect community, kung saan nagtutulungan ang mga tao at sumasagot kami."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvre la communauté JMAP Connect, où les gens s’entraident et où nous répondons."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פותח את קהילת JMAP Connect, שבה אנשים עוזרים זה לזה וגם אנחנו עונים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP Connect कम्युनिटी खोलता है, जहाँ लोग एक-दूसरे की मदद करते हैं और हम जवाब देते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara zajednicu JMAP Connect, gdje ljudi pomažu jedni drugima, a i mi odgovaramo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyitja a JMAP Connect közösséget, ahol a felhasználók segítik egymást, és mi is válaszolunk."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka komunitas JMAP Connect, tempat orang saling membantu dan kami menjawab."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apre la community di JMAP Connect, dove le persone si aiutano a vicenda e noi rispondiamo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP Connectのコミュニティを開きます。ユーザ同士で助け合い、私たちも回答します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자들이 서로 돕고 저희가 답변하는 JMAP Connect 커뮤니티를 엽니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuka komuniti JMAP Connect, tempat orang saling membantu dan kami menjawab."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpner JMAP Connect-fellesskapet, der folk hjelper hverandre og vi svarer."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opent de JMAP Connect-community, waar mensen elkaar helpen en wij antwoorden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwiera społeczność JMAP Connect, gdzie ludzie sobie pomagają, a my odpowiadamy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre a comunidade do JMAP Connect, onde as pessoas se ajudam e nós respondemos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide comunitatea JMAP Connect, unde oamenii se ajută între ei și răspundem și noi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открывает сообщество JMAP Connect, где люди помогают друг другу, а мы отвечаем."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorí komunitu JMAP Connect, kde si ľudia navzájom pomáhajú a my odpovedáme."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвара JMAP Connect заједницу, где људи помажу једни другима, а и ми одговарамо."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppnar JMAP Connect-communityn, där folk hjälper varandra och vi svarar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hufungua jumuiya ya JMAP Connect, ambapo watu husaidiana na sisi hujibu."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP Connect కమ్యూనిటీని తెరుస్తుంది, అక్కడ వ్యక్తులు ఒకరికొకరు సహాయం చేసుకుంటారు, మేము సమాధానం ఇస్తాము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิดชุมชน JMAP Connect ที่ผู้ใช้ช่วยเหลือกันและเราคอยตอบคำถาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İnsanların birbirine yardım ettiği ve bizim de yanıt verdiğimiz JMAP Connect topluluğunu açar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриває спільноту JMAP Connect, де люди допомагають одне одному, а ми відповідаємо."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP Connect کمیونٹی کھولتا ہے، جہاں لوگ ایک دوسرے کی مدد کرتے ہیں اور ہم بھی جواب دیتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở cộng đồng JMAP Connect, nơi mọi người giúp nhau và chúng tôi trả lời."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开 JMAP Connect 社区,大家在这里互相帮助,我们也会解答。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "打開 JMAP Connect 社群,大家在這裡互相幫忙,我們也會回答。"
          }
        }
      }
    },
    "Or add a new account:": {
