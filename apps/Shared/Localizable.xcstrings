        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আনসাবস্ক্রাইব করা হয়েছে। প্রেরকের বন্ধ করতে কয়েক দিন লাগতে পারে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Subscripció cancel·lada. El remitent pot trigar uns dies a parar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odběr odhlášen. Odesílateli může trvat pár dní, než přestane."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Afmeldt. Det kan tage afsenderen et par dage at stoppe."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abbestellt. Es kann ein paar Tage dauern, bis der Absender aufhört."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Καταργήθηκε η εγγραφή. Ο αποστολέας μπορεί να χρειαστεί λίγες μέρες για να σταματήσει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Suscripción cancelada. El remitente puede tardar unos días en dejar de enviar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اشتراک لغو شد. ممکن است چند روز طول بکشد تا فرستنده متوقف شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilaus peruttu. Voi kestää muutaman päivän, ennen kuin lähettäjä lopettaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-unsubscribe na. Puwedeng ilang araw bago tumigil ang sender."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désabonné. L’expéditeur peut mettre quelques jours à arrêter."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המינוי בוטל. ייתכן שיעברו כמה ימים עד שהשולח יפסיק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनसब्सक्राइब किया गया। प्रेषक को रोकने में कुछ दिन लग सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odjavljeno. Pošiljatelju može trebati nekoliko dana da prestane."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Leiratkozva. Eltarthat néhány napig, mire a feladó leáll."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Berhenti berlangganan. Pengirim mungkin perlu beberapa hari untuk berhenti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Iscrizione annullata. Il mittente potrebbe metterci qualche giorno a smettere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信を停止しました。差出人が停止するまで数日かかることがあります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독이 취소되었습니다. 발신자가 발송을 중단하는 데 며칠이 걸릴 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dinyahlanggan. Penghantar mungkin mengambil beberapa hari untuk berhenti."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonnementet er avsluttet. Det kan ta noen dager før avsenderen slutter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afgemeld. Het kan een paar dagen duren voordat de afzender stopt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wypisano. Nadawca może potrzebować kilku dni, by przestać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assinatura cancelada. Pode levar alguns dias para o remetente parar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezabonat. Expeditorului îi poate lua câteva zile să se oprească."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписка отменена. Отправителю может понадобиться несколько дней, чтобы перестать писать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odber odhlásený. Odosielateľovi môže trvať pár dní, kým prestane."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Претплата отказана. Пошиљаоцу може бити потребно неколико дана да престане."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Prenumerationen avslutad. Det kan ta några dagar innan avsändaren slutar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Umejiondoa. Huenda mtumaji akachukua siku chache kuacha."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్‌సబ్‌స్క్రైబ్ చేయబడింది. పంపినవారు ఆపడానికి కొన్ని రోజులు పట్టవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยกเลิกการสมัครแล้ว ผู้ส่งอาจใช้เวลาสองสามวันจึงจะหยุดส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelikten çıkıldı. Göndericinin durması birkaç gün sürebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ви відписалися. Відправнику може знадобитися кілька днів, щоб припинити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان سبسکرائب ہو گیا۔ بھیجنے والے کو رکنے میں چند دن لگ سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã hủy đăng ký. Người gửi có thể cần vài ngày để dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已退订。发件人可能需要几天才会停止发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已取消訂閱。寄件人可能需要幾天才會停止寄送。"
          }
        }
      }
    },
