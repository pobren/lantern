    "%@ hasn't been opened before, so it needs a connection.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is nog nie voorheen oopgemaak nie, so dit het 'n verbinding nodig."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يُفتح %@ من قبل، لذا يحتاج إلى اتصال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ আগে কখনো খোলা হয়নি, তাই এর জন্য সংযোগ দরকার।"
