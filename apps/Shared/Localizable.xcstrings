        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email crea una adreça privada per a cada lloc web. Les respostes de Fora de l'oficina es desen al servidor de correu, així que funcionen amb tots els dispositius apagats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email vytvoří soukromou adresu pro každý web. Odpovědi v nepřítomnosti se ukládají na poštovním serveru, takže fungují, i když jsou všechna zařízení vypnutá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email opretter en privat adresse til hvert websted. Fraværssvar gemmes på din mailserver, så de virker, selv når alle enheder er slukket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email erstellt eine private Adresse für jede Website. Abwesenheitsnotizen werden auf deinem Mailserver gespeichert und funktionieren so auch bei ausgeschalteten Geräten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Masked Email δημιουργεί μια ιδιωτική διεύθυνση για κάθε ιστότοπο. Οι απαντήσεις Εκτός γραφείου αποθηκεύονται στον διακομιστή email σας, οπότε λειτουργούν ακόμα και με όλες τις συσκευές κλειστές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email crea una dirección privada para cada web. Las respuestas de fuera de la oficina se guardan en tu servidor de correo, así que funcionan con todos los dispositivos apagados."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email برای هر وب‌سایت یک نشانی خصوصی می‌سازد. پاسخ‌های خارج از دفتر روی سرور ایمیل شما ذخیره می‌شوند، پس حتی وقتی همه دستگاه‌ها خاموش‌اند کار می‌کنند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email luo jokaiselle sivustolle oman yksityisen osoitteen. Poissaolovastaukset tallennetaan sähköpostipalvelimellesi, joten ne toimivat, vaikka kaikki laitteet olisivat pois päältä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagawa ang Masked Email ng pribadong address para sa bawat website. Naka-save sa mail server mo ang mga Out of office reply, kaya gumagana ang mga ito kahit naka-off ang lahat ng device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email crée une adresse privée pour chaque site web. Les réponses d’absence sont enregistrées sur votre serveur de messagerie et fonctionnent même avec tous vos appareils éteints."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email יוצר כתובת פרטית לכל אתר. תשובות בהיעדרות נשמרות בשרת הדואר שלך, כך שהן פועלות גם כשכל המכשירים כבויים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email हर वेबसाइट के लिए एक निजी पता बनाता है। ऑफ़िस से बाहर वाले जवाब आपके मेल सर्वर पर सहेजे जाते हैं, इसलिए हर डिवाइस बंद होने पर भी काम करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email izrađuje privatnu adresu za svaku web-stranicu. Odgovori Izvan ureda spremaju se na vašem poslužitelju e-pošte, pa rade i kad su svi uređaji isključeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Masked Email minden webhelyhez privát címet hoz létre. A Házon kívül válaszok a levelezőszerveren vannak mentve, így akkor is működnek, ha minden eszköze ki van kapcsolva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email membuat alamat pribadi untuk setiap situs web. Balasan di luar kantor disimpan di server email Anda, jadi tetap berfungsi meski semua perangkat dimatikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email crea un indirizzo privato per ogni sito web. Le risposte Fuori sede sono salvate sul tuo server di posta, quindi funzionano anche con tutti i dispositivi spenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked EmailはWebサイトごとに専用のアドレスを作成します。不在通知はメールサーバに保存されるため、すべてのデバイスの電源が切れていても機能します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email은 웹 사이트마다 전용 주소를 만듭니다. 부재중 응답은 메일 서버에 저장되므로 모든 기기가 꺼져 있어도 작동합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email membuat alamat peribadi untuk setiap laman web. Balasan Di luar pejabat disimpan pada pelayan mel anda, jadi ia berfungsi walaupun semua peranti dimatikan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email lager en privat adresse for hvert nettsted. Fraværssvar lagres på e-postserveren din, så de virker selv om alle enhetene er slått av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email maakt een privéadres voor elke website. Afwezigheidsberichten worden op je mailserver bewaard, dus ze werken ook met al je apparaten uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email tworzy prywatny adres dla każdej witryny. Odpowiedzi o nieobecności są zapisane na serwerze poczty, więc działają nawet przy wyłączonych wszystkich urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Masked Email cria um endereço privado para cada site. As respostas de ausência ficam salvas no seu servidor de e-mail, então funcionam mesmo com todos os dispositivos desligados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email creează o adresă privată pentru fiecare site. Răspunsurile Absent de la birou sunt salvate pe serverul de e-mail, deci funcționează chiar și cu toate dispozitivele oprite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email создаёт отдельный адрес для каждого сайта. Автоответы хранятся на почтовом сервере, поэтому работают, даже когда все устройства выключены."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email vytvorí súkromnú adresu pre každý web. Odpovede v neprítomnosti sa ukladajú na poštovom serveri, takže fungujú, aj keď sú všetky zariadenia vypnuté."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email прави приватну адресу за сваки веб-сајт. Одговори Ван канцеларије чувају се на вашем серверу поште, па раде и када су сви уређаји искључени."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email skapar en privat adress för varje webbplats. Frånvarosvar sparas på din e-postserver, så de fungerar även när alla enheter är avstängda."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email hutengeneza anwani ya faragha kwa kila tovuti. Majibu ya Sipo ofisini huhifadhiwa kwenye seva yako ya barua, kwa hivyo hufanya kazi hata vifaa vyote vikiwa vimezimwa."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email ప్రతి వెబ్‌సైట్‌కు ఒక ప్రైవేట్ అడ్రస్ తయారు చేస్తుంది. ఆఫీస్‌లో లేను రిప్లైలు మీ మెయిల్ సర్వర్‌లో సేవ్ అవుతాయి, కాబట్టి అన్ని పరికరాలు ఆఫ్‌లో ఉన్నా పనిచేస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email สร้างที่อยู่ส่วนตัวสำหรับแต่ละเว็บไซต์ การตอบกลับเมื่อไม่อยู่จะบันทึกไว้บนเซิร์ฟเวอร์อีเมลของคุณ จึงทำงานได้แม้ทุกอุปกรณ์จะปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email her web sitesi için özel bir adres oluşturur. İzin yanıtları posta sunucunuzda kaydedilir, böylece tüm aygıtlar kapalıyken de çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email створює окрему адресу для кожного сайту. Автовідповіді зберігаються на поштовому сервері, тож працюють, навіть коли всі пристрої вимкнено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email ہر ویب سائٹ کے لیے ایک نجی پتہ بناتا ہے۔ دفتر سے باہر کے جوابات آپ کے میل سرور پر محفوظ ہوتے ہیں، اس لیے تمام ڈیوائسز بند ہونے پر بھی کام کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email tạo một địa chỉ riêng cho mỗi trang web. Trả lời vắng mặt được lưu trên máy chủ thư nên vẫn hoạt động khi mọi thiết bị đều tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email 为每个网站创建专用地址。外出回复保存在你的邮件服务器上,所有设备关机时也能运作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Masked Email 會為每個網站製作專用地址。外出回覆儲存在你的郵件伺服器上,即使所有裝置都關機也能運作。"
          }
        }
      }
    },
