    "In your Thundermail dashboard, open Email Settings and press Create app password. Use your Thundermail address and that app password.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak in jou Thundermail-paneelbord E-posinstellings oop en druk Skep app-wagwoord. Gebruik jou Thundermail-adres en daardie app-wagwoord."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "في لوحة تحكم Thundermail، افتح إعدادات البريد واضغط على إنشاء كلمة سر تطبيق. استخدم عنوان Thundermail وكلمة سر التطبيق تلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Thundermail ড্যাশবোর্ডে Email Settings খুলুন আর Create app password চাপুন। আপনার Thundermail ঠিকানা ও সেই অ্যাপ পাসওয়ার্ড ব্যবহার করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Al tauler de Thundermail, obre Configuració del correu i prem Crear contrasenya d'app. Fes servir la teva adreça de Thundermail i aquesta contrasenya d'app."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na nástěnce Thundermail otevřete Email Settings a stiskněte Create app password. Použijte svou adresu Thundermail a toto heslo pro aplikaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn Email Settings i dit Thundermail-dashboard, og tryk på Create app password. Brug din Thundermail-adresse og den app-adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne in deinem Thundermail-Dashboard „Email Settings“ und tippe auf „Create app password“. Verwende deine Thundermail-Adresse und dieses App-Passwort."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στον πίνακα ελέγχου του Thundermail, ανοίξτε Email Settings και πατήστε Create app password. Χρησιμοποιήστε τη διεύθυνση Thundermail σας και αυτό το συνθηματικό εφαρμογής."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "En tu panel de Thundermail, abre Email Settings y pulsa Create app password. Usa tu dirección de Thundermail y esa contraseña de app."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در داشبورد Thundermail، تنظیمات ایمیل را باز کنید و ایجاد رمز برنامه را بزنید. از نشانی Thundermail خود و همان رمز برنامه استفاده کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa Thundermailin hallintapaneelissa Email Settings ja paina Create app password. Käytä Thundermail-osoitettasi ja sitä sovelluksen salasanaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa Thundermail dashboard mo, buksan ang Email Settings at pindutin ang Create app password. Gamitin ang Thundermail address mo at ang app password na iyon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dans votre tableau de bord Thundermail, ouvrez Email Settings et appuyez sur Create app password. Utilisez votre adresse Thundermail et ce mot de passe d’app."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלוח הבקרה של Thundermail, פתח את הגדרות הדוא״ל ולחץ על יצירת סיסמת יישום. השתמש בכתובת Thundermail שלך ובסיסמת היישום הזו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Thundermail डैशबोर्ड में, Email Settings खोलें और Create app password दबाएँ। अपना Thundermail पता और वह ऐप पासवर्ड इस्तेमाल करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Na nadzornoj ploči Thundermaila otvorite Email Settings i pritisnite Create app password. Upotrijebite svoju Thundermail adresu i tu lozinku za aplikaciju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Thundermail irányítópultján nyissa meg az Email Settings részt, és nyomja meg a Create app password gombot. Használja a Thundermail-címét és ezt az alkalmazásjelszót."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Di dasbor Thundermail, buka Email Settings dan tekan Create app password. Gunakan alamat Thundermail Anda dan kata sandi app tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nella dashboard di Thundermail, apri Email Settings e premi Create app password. Usa il tuo indirizzo Thundermail e quella password per app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Thundermailのダッシュボードで「Email Settings」を開き、「Create app password」を押します。ThundermailのアドレスとそのApp用パスワードを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Thundermail 대시보드에서 Email Settings를 열고 Create app password를 누르십시오. Thundermail 주소와 해당 앱 암호를 사용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dalam papan pemuka Thundermail anda, buka Email Settings dan tekan Create app password. Gunakan alamat Thundermail anda dan kata laluan app itu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne Email Settings i Thundermail-oversikten, og trykk på Create app password. Bruk Thundermail-adressen din og det app-passordet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in je Thundermail-dashboard Email Settings en druk op Create app password. Gebruik je Thundermail-adres en dat app-wachtwoord."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W panelu Thundermail otwórz Email Settings i naciśnij Create app password. Użyj swojego adresu Thundermail i tego hasła aplikacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "No painel do Thundermail, abra Email Settings e toque em Create app password. Use seu endereço Thundermail e essa senha de app."
          }
        },
        "ro": {
          "stringUnit": {
