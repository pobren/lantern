          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你打开的邮件中的图片和发件人照片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你打開的郵件中的圖片和寄件人照片。"
          }
