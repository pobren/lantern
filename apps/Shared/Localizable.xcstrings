        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo server di posta conserva l’email e la invia a quell’ora, anche se questo dispositivo è spento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
