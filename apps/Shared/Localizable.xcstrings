    "Open JMAP Connect on your iPhone and add your mail account. Your inbox then shows here.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak JMAP Connect op jou iPhone oop en voeg jou posrekening by. Jou inkassie wys dan hier."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح JMAP Connect على iPhone وأضف حساب بريدك. سيظهر بريدك الوارد هنا بعد ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার iPhone-এ JMAP Connect খুলে আপনার মেল অ্যাকাউন্ট যোগ করুন। তারপর আপনার ইনবক্স এখানে দেখাবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre JMAP Connect a l'iPhone i afegeix el teu compte de correu. Després la safata d'entrada es mostrarà aquí."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete JMAP Connect na iPhonu a přidejte poštovní účet. Pak se tu zobrazí Přijaté."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn JMAP Connect på din iPhone, og tilføj din e-mailkonto. Så vises din indbakke her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne JMAP Connect auf deinem iPhone und füge deinen Mail-Account hinzu. Dann erscheint hier dein Posteingang."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίξτε το JMAP Connect στο iPhone σας και προσθέστε τον λογαριασμό email σας. Τα Εισερχόμενα θα εμφανιστούν εδώ."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre JMAP Connect en tu iPhone y añade tu cuenta de correo. Tu bandeja de entrada aparecerá aquí."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "JMAP Connect را در iPhone باز کنید و حساب ایمیل خود را اضافه کنید. سپس صندوق ورودی شما اینجا نمایش داده می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avaa JMAP Connect iPhonessa ja lisää sähköpostitilisi. Sitten Saapuneet näkyvät täällä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Buksan ang JMAP Connect sa iPhone mo at idagdag ang mail account mo. Lalabas dito ang inbox mo pagkatapos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ouvrez JMAP Connect sur votre iPhone et ajoutez votre compte de messagerie. Votre boîte de réception s’affichera ici."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "פתח את JMAP Connect ב-iPhone והוסף את חשבון הדואר שלך. הדואר הנכנס יופיע כאן אחר כך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने iPhone पर JMAP Connect खोलें और अपना मेल खाता जोड़ें। फिर आपका इनबॉक्स यहाँ दिखेगा।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorite JMAP Connect na iPhoneu i dodajte račun e-pošte. Tada će se ovdje prikazati ulazna pošta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyissa meg a JMAP Connectet az iPhone-on, és adja hozzá e-mail-fiókját. Ezután itt látható a Bejövő."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka JMAP Connect di iPhone dan tambahkan akun email Anda. Kotak masuk Anda lalu muncul di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apri JMAP Connect su iPhone e aggiungi il tuo account di posta. La tua casella apparirà qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhoneでJMAP Connectを開いて、メールアカウントを追加してください。追加すると受信ボックスがここに表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone에서 JMAP Connect를 열고 메일 계정을 추가하십시오. 그러면 받은 편지함이 여기에 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Buka JMAP Connect pada iPhone anda dan tambah akaun mel anda. Peti masuk anda kemudian ditunjukkan di sini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Åpne JMAP Connect på iPhonen og legg til e-postkontoen din. Da vises innboksen her."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Open JMAP Connect op je iPhone en voeg je mailaccount toe. Je inkomende post verschijnt dan hier."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otwórz JMAP Connect na iPhonie i dodaj konto pocztowe. Wtedy pojawią się tu Odebrane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abra o JMAP Connect no iPhone e adicione sua conta de e-mail. Sua Caixa de Entrada aparecerá aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Deschide JMAP Connect pe iPhone și adaugă contul de e-mail. Apoi Intrările apar aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откройте JMAP Connect на iPhone и добавьте почтовую учетную запись. Тогда здесь появятся «Входящие»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorte JMAP Connect na iPhone a pridajte poštový účet. Potom sa tu zobrazia Prijaté."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Отворите JMAP Connect на iPhone-у и додајте налог поште. Пријемно сандуче ће се затим приказати овде."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Öppna JMAP Connect på din iPhone och lägg till ditt e-postkonto. Sedan visas inkorgen här."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fungua JMAP Connect kwenye iPhone yako na uongeze akaunti yako ya barua. Kikasha chako kitaonekana hapa."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ iPhoneలో JMAP Connect తెరిచి మీ మెయిల్ ఖాతాను జోడించండి. ఆ తర్వాత మీ ఇన్‌బాక్స్ ఇక్కడ కనిపిస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด JMAP Connect บน iPhone และเพิ่มบัญชีอีเมลของคุณ แล้วกล่องจดหมายเข้าจะแสดงที่นี่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "iPhone'unuzda JMAP Connect'i açın ve posta hesabınızı ekleyin. Gelen kutunuz ardından burada görünür."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкрийте JMAP Connect на iPhone і додайте поштовий обліковий запис. Тоді тут з’являться «Вхідні»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے iPhone پر JMAP Connect کھولیں اور اپنا میل اکاؤنٹ شامل کریں۔ پھر آپ کا ان باکس یہاں دکھائی دے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mở JMAP Connect trên iPhone và thêm tài khoản thư. Hộp thư đến sẽ hiện ở đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上打开 JMAP Connect 并添加你的邮件账户,收件箱随后会显示在这里。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 iPhone 上打開 JMAP Connect 並加入你的郵件帳號,收件匣隨後就會顯示在這裡。"
          }
        }
      }
    },
