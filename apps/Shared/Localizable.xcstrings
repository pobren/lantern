        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ قبلاً باز نشده است، پس به اتصال نیاز دارد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kohdetta %@ ei ole avattu aiemmin, joten tarvitaan yhteys."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa nabubuksan ang %@ dati, kaya kailangan nito ng koneksyon."
