    "That's the only label on this email. Archive or move it instead.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit is die enigste etiket op hierdie e-pos. Argiveer of skuif dit eerder."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا هو التصنيف الوحيد على هذه الرسالة. أرشفها أو انقلها بدلًا من ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ইমেলে এটিই একমাত্র লেবেল। এর বদলে আর্কাইভ করুন বা সরান।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "És l'única etiqueta d'aquest correu. Arxiva'l o mou-lo."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tohle je jediný štítek této zprávy. Raději ji archivujte nebo přesuňte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det er den eneste etiket på denne e-mail. Arkivér eller flyt den i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das ist das einzige Label dieser E-Mail. Archiviere oder bewege sie stattdessen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αυτή είναι η μόνη ετικέτα αυτού του email. Αρχειοθετήστε ή μετακινήστε το."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Es la única etiqueta de este correo. Archívalo o muévelo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این تنها برچسب این ایمیل است. به‌جای آن بایگانی یا منتقلش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tämä on viestin ainoa tunniste. Arkistoi tai siirrä viesti sen sijaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Iyan lang ang label sa email na ito. I-archive o ilipat na lang ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "C’est le seul libellé de cet e-mail. Archivez-le ou déplacez-le plutôt."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זו התווית היחידה בהודעה. העבר אותה לארכיון או לתיקייה אחרת במקום זאת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस ईमेल पर यही एकमात्र लेबल है। इसके बजाय आर्काइव या मूव करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "To je jedina oznaka na ovoj e-poruci. Umjesto toga je arhivirajte ili premjestite."
