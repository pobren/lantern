    "Your mail server didn't accept the sign in. Open JMAP Connect on your iPhone, or let the Watch sign in on its own in Settings, Apple Watch.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou posbediener het nie die aanmelding aanvaar nie. Maak JMAP Connect op jou iPhone oop, of laat die Watch self aanmeld in Instellings, Apple Watch."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقبل خادم البريد تسجيل الدخول. افتح JMAP Connect على iPhone، أو دع الساعة تسجّل الدخول بنفسها من الإعدادات، Apple Watch."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার মেল সার্ভার সাইন ইন গ্রহণ করেনি। আপনার iPhone-এ JMAP Connect খুলুন, বা সেটিংস, Apple Watch-এ Watch-কে নিজে সাইন ইন করতে দিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de correu no ha acceptat l'inici de sessió. Obre JMAP Connect a l'iPhone, o deixa que el Watch iniciï sessió pel seu compte a Configuració, Apple Watch."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poštovní server nepřijal přihlášení. Otevřete JMAP Connect na iPhonu, nebo nechte hodinky přihlásit se samostatně v Nastavení, Apple Watch."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din mailserver accepterede ikke login. Åbn JMAP Connect på din iPhone, eller lad dit Watch logge ind selv under Indstillinger, Apple Watch."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mailserver hat die Anmeldung nicht akzeptiert. Öffne JMAP Connect auf deinem iPhone oder lass die Watch sich selbst anmelden unter „Einstellungen“ > „Apple Watch“."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής email δεν δέχτηκε τη σύνδεση. Ανοίξτε το JMAP Connect στο iPhone ή αφήστε το Watch να συνδεθεί μόνο του στις Ρυθμίσεις, Apple Watch."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor de correo no ha aceptado el inicio de sesión. Abre JMAP Connect en tu iPhone o deja que el Watch inicie sesión por su cuenta en Ajustes, Apple Watch."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرور ایمیل شما ورود را نپذیرفت. JMAP Connect را در iPhone باز کنید، یا بگذارید Watch در تنظیمات، Apple Watch خودش وارد شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sähköpostipalvelimesi ei hyväksynyt kirjautumista. Avaa JMAP Connect iPhonessa tai anna Watchin kirjautua itse kohdassa Asetukset, Apple Watch."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi tinanggap ng mail server mo ang pag-sign in. Buksan ang JMAP Connect sa iPhone mo, o hayaang mag-sign in nang sarili ang Watch sa Settings, Apple Watch."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur de messagerie n’a pas accepté la connexion. Ouvrez JMAP Connect sur votre iPhone, ou laissez la Watch se connecter seule dans Réglages, Apple Watch."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שרת הדואר לא קיבל את ההתחברות. פתח את JMAP Connect ב-iPhone, או אפשר ל-Watch להתחבר בעצמו ב״הגדרות״, Apple Watch."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके मेल सर्वर ने साइन इन स्वीकार नहीं किया। अपने iPhone पर JMAP Connect खोलें, या सेटिंग्ज़, Apple Watch में Watch को खुद साइन इन करने दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš poslužitelj e-pošte nije prihvatio prijavu. Otvorite JMAP Connect na iPhoneu ili dopustite da se Watch sam prijavi u Postavkama, Apple Watch."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A levelezőszerver nem fogadta el a bejelentkezést. Nyissa meg a JMAP Connectet az iPhone-on, vagy engedje, hogy a Watch saját maga jelentkezzen be: Beállítások, Apple Watch."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Server email Anda tidak menerima proses masuk. Buka JMAP Connect di iPhone, atau biarkan Watch masuk sendiri di Pengaturan, Apple Watch."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo server di posta non ha accettato l’accesso. Apri JMAP Connect su iPhone, oppure lascia che il Watch acceda da solo in Impostazioni, Apple Watch."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールサーバがサインインを受け付けませんでした。iPhoneでJMAP Connectを開くか、設定の「Apple Watch」でApple Watch単独でサインインしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메일 서버가 로그인을 수락하지 않았습니다. iPhone에서 JMAP Connect를 열거나, 설정 > Apple Watch에서 Apple Watch가 자체적으로 로그인하도록 하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelayan mel anda tidak menerima daftar masuk. Buka JMAP Connect pada iPhone anda, atau benarkan Watch mendaftar masuk sendiri dalam Seting, Apple Watch."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "E-postserveren din godtok ikke påloggingen. Åpne JMAP Connect på iPhonen, eller la Watch logge på selv under Innstillinger, Apple Watch."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je mailserver accepteerde de inlog niet. Open JMAP Connect op je iPhone, of laat de Watch zelf inloggen in Instellingen, Apple Watch."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Serwer poczty nie zaakceptował logowania. Otwórz JMAP Connect na iPhonie lub pozwól Watchowi logować się samodzielnie w Ustawieniach, Apple Watch."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu servidor de e-mail não aceitou o login. Abra o JMAP Connect no iPhone ou deixe o Watch entrar por conta própria em Ajustes, Apple Watch."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serverul de e-mail nu a acceptat autentificarea. Deschide JMAP Connect pe iPhone sau lasă Watch să se autentifice singur în Configurări, Apple Watch."
          }
        },
        "ru": {
