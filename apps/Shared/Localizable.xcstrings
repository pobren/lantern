          "stringUnit": {
            "state": "translated",
            "value": "Số email chưa đọc trong các hộp thư đến của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收件箱中未读邮件的数量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收件匣中未讀郵件的數量。"
          }
        }
      }
    },
    "I use labels, not folders": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ek gebruik etikette, nie vouers nie"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أستخدم التصنيفات، لا المجلدات"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি ফোল্ডার নয়, লেবেল ব্যবহার করি"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Faig servir etiquetes, no carpetes"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používám štítky, ne složky"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg bruger etiketter, ikke mapper"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich nutze Labels statt Ordnern"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιώ ετικέτες, όχι φακέλους"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso etiquetas, no carpetas"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از برچسب استفاده می‌کنم، نه پوشه"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytän tunnisteita, en kansioita"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Labels ang gamit ko, hindi folders"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’utilise des libellés, pas des dossiers"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני משתמש בתוויות, לא בתיקיות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं फ़ोल्डर नहीं, लेबल इस्तेमाल करता/करती हूँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Koristim oznake, a ne mape"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Címkéket használok, nem mappákat"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya pakai label, bukan folder"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso etichette, non cartelle"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "フォルダではなくラベルを使う"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "폴더 대신 레이블 사용"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya guna label, bukan folder"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg bruker etiketter, ikke mapper"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik gebruik labels, geen mappen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używam etykiet, nie folderów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uso etiquetas, não pastas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosesc etichete, nu dosare"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я использую метки, а не папки"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Používam štítky, nie priečinky"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Користим ознаке, а не фасцикле"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag använder etiketter, inte mappar"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Natumia lebo, si folda"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేను ఫోల్డర్‌లు కాదు, లేబుల్‌లు ఉపయోగిస్తాను"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันใช้ป้ายกำกับ ไม่ใช่โฟลเดอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör değil, etiket kullanıyorum"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я використовую мітки, а не папки"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میں فولڈرز نہیں، لیبلز استعمال کرتا ہوں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi dùng nhãn, không dùng thư mục"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我使用标签,而非文件夹"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我使用標籤,而非資料夾"
          }
        }
      }
    },
    "I'm away until Monday and will reply when I'm back.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ek is weg tot Maandag en sal antwoord wanneer ek terug is."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أنا خارج المكتب حتى يوم الاثنين وسأرد عند عودتي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি সোমবার পর্যন্ত বাইরে আছি, ফিরে এসে উত্তর দেব।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Soc fora fins dilluns i respondré quan torni."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Do pondělí jsem pryč, odpovím po návratu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg er væk indtil mandag og svarer, når jeg er tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich bin bis Montag nicht da und antworte, wenn ich zurück bin."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Λείπω μέχρι τη Δευτέρα και θα απαντήσω όταν επιστρέψω."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estoy fuera hasta el lunes y responderé a mi vuelta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا دوشنبه در دسترس نیستم و پس از بازگشت پاسخ می‌دهم."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Olen poissa maanantaihin asti ja vastaan, kun palaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala ako hanggang Lunes at sasagot ako pagbalik ko."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Je suis absent jusqu’à lundi et je répondrai à mon retour."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אני לא במשרד עד יום שני ואענה כשאחזור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैं सोमवार तक बाहर हूँ और लौटकर जवाब दूँगा/दूँगी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odsutan sam do ponedjeljka i odgovorit ću kad se vratim."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Hétfőig távol vagyok, és visszatérésem után válaszolok."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya tidak di kantor sampai Senin dan akan membalas saat kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Sono via fino a lunedì e risponderò al mio ritorno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "月曜日まで不在のため、戻り次第返信いたします。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "월요일까지 부재중이며 돌아와서 답장드리겠습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya tiada sehingga Isnin dan akan membalas apabila saya kembali."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg er borte til mandag og svarer når jeg er tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik ben tot maandag weg en antwoord als ik terug ben."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jestem nieobecny do poniedziałku i odpowiem po powrocie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estou ausente até segunda-feira e respondo quando voltar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunt plecat până luni și voi răspunde când revin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Меня не будет до понедельника, отвечу, когда вернусь."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Do pondelka som preč, odpoviem po návrate."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Одсутан сам до понедељка и одговорићу када се вратим."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Jag är borta till måndag och svarar när jag är tillbaka."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sipo hadi Jumatatu na nitajibu nikirudi."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "నేను సోమవారం వరకు అందుబాటులో లేను, తిరిగి వచ్చాక రిప్లై ఇస్తాను."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันไม่อยู่จนถึงวันจันทร์ และจะตอบกลับเมื่อกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pazartesiye kadar uzaktayım, döndüğümde yanıt vereceğim."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Мене не буде до понеділка, відповім, коли повернуся."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میں پیر تک دستیاب نہیں ہوں اور واپس آ کر جواب دوں گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi vắng mặt đến thứ Hai và sẽ trả lời khi quay lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我在周一前不在,回来后会回复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我在週一前不在,回來後會回覆。"
          }
        }
      }
    },
