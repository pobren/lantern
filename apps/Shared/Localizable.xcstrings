        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ er ikke blevet åbnet før, så der skal være forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ wurde noch nie geöffnet und braucht daher eine Verbindung."
          }
        },
        "el": {
          "stringUnit": {
