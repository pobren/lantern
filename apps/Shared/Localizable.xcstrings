    "Instant alerts are paused for now. New mail is still checked in the background.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kitswaarskuwings is vir eers onderbreek. Nuwe pos word steeds in die agtergrond nagegaan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التنبيهات الفورية متوقفة مؤقتًا. لا يزال البريد الجديد يُفحص في الخلفية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তাৎক্ষণিক অ্যালার্ট আপাতত বন্ধ আছে। নতুন মেল এখনো ব্যাকগ্রাউন্ডে চেক করা হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Els avisos instantanis estan en pausa de moment. El correu nou es continua comprovant en segon pla."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Okamžitá upozornění jsou zatím pozastavená. Nová pošta se dál kontroluje na pozadí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Øjeblikkelige notifikationer er sat på pause lige nu. Der tjekkes stadig efter ny post i baggrunden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sofortmitteilungen sind vorerst pausiert. Neue E-Mails werden weiter im Hintergrund abgerufen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι άμεσες ειδοποιήσεις έχουν διακοπεί προς το παρόν. Τα νέα email ελέγχονται ακόμα στο παρασκήνιο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas instantáneas están en pausa por ahora. El correo nuevo se sigue comprobando en segundo plano."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هشدارهای فوری فعلاً متوقف‌اند. ایمیل جدید همچنان در پس‌زمینه بررسی می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Välittömät ilmoitukset ovat toistaiseksi tauolla. Uudet viestit tarkistetaan yhä taustalla."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-pause muna ang mga instant alert. Tinitingnan pa rin ang bagong mail sa background."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes instantanées sont en pause. Les nouveaux e-mails sont toujours relevés en arrière-plan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתראות המיידיות מושהות כרגע. דואר חדש עדיין נבדק ברקע."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुरंत अलर्ट अभी रुके हुए हैं। नई मेल अब भी बैकग्राउंड में जाँची जाती है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trenutačna upozorenja zasad su pauzirana. Nova pošta i dalje se provjerava u pozadini."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az azonnali értesítések most szünetelnek. Az új leveleket továbbra is ellenőrizzük a háttérben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan instan dijeda untuk saat ini. Email baru tetap diperiksa di latar belakang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi istantanei sono in pausa per ora. La nuova posta viene comunque controllata in background."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インスタント通知は一時停止中です。新着メールはバックグラウンドで引き続き確認されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즉시 알림이 일시 정지되었습니다. 새로운 메일은 계속 백그라운드에서 확인됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Amaran segera dijeda buat masa ini. Mel baharu masih disemak di latar belakang."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Direktevarsler er satt på pause inntil videre. Ny e-post sjekkes fortsatt i bakgrunnen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Directe meldingen zijn voorlopig gepauzeerd. Nieuwe mail wordt nog steeds op de achtergrond gecontroleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Natychmiastowe alerty są na razie wstrzymane. Nowa poczta nadal jest sprawdzana w tle."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os alertas instantâneos estão pausados por enquanto. Os novos e-mails continuam sendo verificados em segundo plano."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertele instantanee sunt întrerupte deocamdată. E-mailurile noi sunt verificate în continuare în fundal."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мгновенные уведомления пока приостановлены. Новая почта по-прежнему проверяется в фоне."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Okamžité upozornenia sú zatiaľ pozastavené. Nová pošta sa naďalej kontroluje na pozadí."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Тренутна обавештења су за сада паузирана. Нова пошта се и даље проверава у позадини."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Direktaviseringar är pausade just nu. Ny post hämtas fortfarande i bakgrunden."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Arifa za papo hapo zimesitishwa kwa sasa. Barua mpya bado hukaguliwa chinichini."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తక్షణ అలర్ట్‌లు ప్రస్తుతానికి పాజ్ చేయబడ్డాయి. కొత్త మెయిల్ ఇప్పటికీ బ్యాక్‌గ్రౌండ్‌లో చెక్ చేయబడుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนทันทีหยุดชั่วคราวอยู่ ยังคงตรวจหาอีเมลใหม่ในพื้นหลัง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anında uyarılar şimdilik duraklatıldı. Yeni postalar yine arka planda denetleniyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Миттєві сповіщення поки призупинено. Нова пошта й надалі перевіряється у фоні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فوری الرٹس فی الحال روکے گئے ہیں۔ نئی میل اب بھی بیک گراؤنڈ میں چیک ہو رہی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông báo tức thì đang tạm dừng. Thư mới vẫn được kiểm tra ở chế độ nền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "即时提醒暂时暂停。仍会在后台检查新邮件。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "即時提醒目前已暫停。仍會在背景檢查新郵件。"
          }
        }
      }
    },
    "It's removed from your address book everywhere, including Fastmail on the web.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit word oral uit jou adresboek verwyder, ook Fastmail op die web."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستُزال من دفتر عناوينك في كل مكان، بما في ذلك Fastmail على الويب."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি সব জায়গায় আপনার ঠিকানা বই থেকে সরানো হবে, ওয়েবে Fastmail থেকেও।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'elimina de la llibreta d'adreces a tot arreu, també a Fastmail al web."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraní se z adresáře všude, včetně Fastmailu na webu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fjernes fra din adressebog overalt, også i Fastmail på nettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wird überall aus deinem Adressbuch entfernt, auch in Fastmail im Web."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαιρείται από το βιβλίο διευθύνσεών σας παντού, και από το Fastmail στο web."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se elimina de tu agenda en todas partes, incluido Fastmail en la web."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از دفترچه نشانی شما در همه‌جا حذف می‌شود، از جمله Fastmail در وب."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Se poistetaan osoitekirjastasi kaikkialta, myös Fastmailista verkossa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Aalisin ito sa address book mo sa lahat ng lugar, kasama ang Fastmail sa web."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il est supprimé de votre carnet d’adresses partout, y compris dans Fastmail sur le web."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "איש הקשר יוסר מפנקס הכתובות בכל מקום, כולל Fastmail באינטרנט."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे हर जगह आपकी एड्रेस बुक से हटा दिया जाता है, वेब पर Fastmail से भी।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanja se iz adresara posvuda, uključujući Fastmail na webu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Mindenhol törlődik a címjegyzékből, a webes Fastmailből is."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontak ini dihapus dari buku alamat Anda di mana saja, termasuk Fastmail di web."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Viene rimosso dalla tua rubrica ovunque, anche da Fastmail sul web."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webで使うFastmailを含め、すべての場所のアドレスブックから削除されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹의 Fastmail을 포함한 모든 곳의 주소록에서 제거됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia dialih keluar daripada buku alamat anda di semua tempat, termasuk Fastmail di web."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Den fjernes fra adresseboken din overalt, også i Fastmail på nettet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het wordt overal uit je adresboek verwijderd, ook uit Fastmail op het web."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zostanie usunięty z książki adresowej wszędzie, także w Fastmail w przeglądarce."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ele será removido do seu catálogo de endereços em todos os lugares, inclusive no Fastmail na web."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Este eliminat din agendă peste tot, inclusiv din Fastmail pe web."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Контакт будет удалён из адресной книги везде, включая веб-версию Fastmail."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstráni sa z adresára všade, vrátane Fastmailu na webe."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Уклања се из адресара свуда, укључујући Fastmail на вебу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Den tas bort från din adressbok överallt, även i Fastmail på webben."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huondolewa kwenye kitabu chako cha anwani kila mahali, ikiwemo Fastmail kwenye wavuti."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది అన్ని చోట్లా మీ అడ్రస్ బుక్ నుండి తీసివేయబడుతుంది, వెబ్‌లోని Fastmailతో సహా."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รายชื่อนี้จะถูกลบออกจากสมุดที่อยู่ทุกที่ รวมถึง Fastmail บนเว็บ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail web dahil her yerde adres defterinizden kaldırılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Контакт буде видалено з адресної книги всюди, зокрема у вебверсії Fastmail."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ آپ کی ایڈریس بک سے ہر جگہ ہٹا دیا جائے گا، بشمول ویب پر Fastmail۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên hệ sẽ bị xóa khỏi sổ địa chỉ ở mọi nơi, kể cả Fastmail trên web."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它将从所有位置的通讯录中移除,包括网页版 Fastmail。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它會從所有位置的通訊錄中移除,包括網頁版 Fastmail。"
          }
        }
      }
    },
