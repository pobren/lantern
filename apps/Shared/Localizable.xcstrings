          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু অপঠিত, তারকা দেওয়া বা সংযুক্তিসহ দেখান"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar només els no llegits, destacats o amb adjunts"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobrazit jen nepřečtené, s hvězdičkou nebo s přílohami"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis kun ulæste, med stjerne eller med bilag"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur ungelesene, markierte oder mit Anhängen anzeigen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μόνο μη αναγνωσμένα, με αστέρι ή με συνημμένα"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar solo no leídos, con estrella o con adjuntos"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط خوانده‌نشده، ستاره‌دار یا دارای پیوست"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Näytä vain lukemattomat, tähdelliset tai liitteelliset"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipakita lang ang hindi pa nababasa, may star o may attachment"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Afficher seulement les non lus, avec étoile ou avec pièces jointes"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הצג רק לא נקראו, מסומנים בכוכב או עם קבצים מצורפים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सिर्फ़ अपठित, स्टार वाले या अटैचमेंट वाले दिखाएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prikaži samo nepročitane, sa zvjezdicom ili s privicima"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Csak olvasatlan, csillagozott vagy mellékletes"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampilkan hanya yang belum dibaca, berbintang, atau berlampiran"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostra solo non lette, con stella o con allegati"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未読、スター付き、添付ファイル付きのみ表示"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽지 않음, 별표 또는 첨부 파일 있는 항목만 보기"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tunjukkan yang belum dibaca, berbintang atau berlampiran sahaja"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vis bare uleste, stjernemerkede eller med vedlegg"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Toon alleen ongelezen, met ster of met bijlagen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Pokaż tylko nieprzeczytane, z gwiazdką lub z załącznikami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostrar só não lidos, com estrela ou com anexos"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Afișează doar necitite, cu stea sau cu atașamente"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только непрочитанные, со звёздочкой или с вложениями"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Zobraziť iba neprečítané, s hviezdičkou alebo s prílohami"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Прикажи само непрочитане, са звездицом или са прилозима"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Visa bara olästa, stjärnmärkta eller med bilagor"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Onyesha zisizosomwa, zenye nyota au zenye viambatisho pekee"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "చదవనివి, స్టార్ చేసినవి లేదా అటాచ్‌మెంట్‌లు ఉన్నవి మాత్రమే చూపించు"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แสดงเฉพาะที่ยังไม่ได้อ่าน ติดดาว หรือมีไฟล์แนบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca okunmamış, yıldızlı veya ekli olanları göster"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише непрочитані, із зірочкою або з вкладеннями"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف غیر پڑھی، ستارہ لگی یا منسلکات والی دکھائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ hiện thư chưa đọc, có gắn sao hoặc có tệp đính kèm"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅显示未读、星标或带附件的邮件"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只顯示未讀、加星號或含附件的郵件"
          }
        }
      }
    },
