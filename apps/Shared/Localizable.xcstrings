    "Fastmail didn't sign you in (%@). Try again, or use an API token instead.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail het jou nie aangemeld nie (%@). Probeer weer, of gebruik eerder 'n API-token."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يسجّل Fastmail دخولك (%@). حاول مرة أخرى، أو استخدم رمز API بدلًا من ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail আপনাকে সাইন ইন করায়নি (%@)। আবার চেষ্টা করুন, বা এর বদলে API টোকেন ব্যবহার করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail no ha iniciat la teva sessió (%@). Torna-ho a provar, o fes servir un testimoni d'API."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail vás nepřihlásil (%@). Zkuste to znovu, nebo použijte token API."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail loggede dig ikke ind (%@). Prøv igen, eller brug en API-token i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail hat dich nicht angemeldet (%@). Versuche es erneut oder verwende stattdessen einen API-Token."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Fastmail δεν σας συνέδεσε (%@). Δοκιμάστε ξανά ή χρησιμοποιήστε token API."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail no ha iniciado tu sesión (%@). Inténtalo de nuevo o usa un token de API."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail شما را وارد نکرد (%@). دوباره امتحان کنید، یا به‌جای آن از توکن API استفاده کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail ei kirjannut sinua sisään (%@). Yritä uudelleen tai käytä API-tunnusta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ka na-sign in ng Fastmail (%@). Subukan ulit, o gumamit na lang ng API token."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail ne vous a pas connecté (%@). Réessayez ou utilisez plutôt un jeton API."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail לא חיבר אותך (%@). נסה שוב, או השתמש במקום זאת באסימון API."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail ने आपको साइन इन नहीं किया (%@)। फिर कोशिश करें, या इसके बजाय API टोकन इस्तेमाल करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail vas nije prijavio (%@). Pokušajte ponovno ili upotrijebite API token."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Fastmail nem jelentkeztette be (%@). Próbálja újra, vagy használjon inkább API-tokent."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail tidak memasukkan Anda (%@). Coba lagi, atau gunakan token API sebagai gantinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail non ti ha fatto accedere (%@). Riprova o usa invece un token API."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmailでサインインできませんでした(%@)。もう一度お試しいただくか、代わりにAPIトークンを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail에서 로그인하지 못했습니다(%@). 다시 시도하거나 대신 API 토큰을 사용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail tidak mendaftarkan anda masuk (%@). Cuba lagi, atau gunakan token API sebaliknya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail logget deg ikke på (%@). Prøv igjen, eller bruk en API-token i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail heeft je niet ingelogd (%@). Probeer het opnieuw of gebruik in plaats daarvan een API-token."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail Cię nie zalogował (%@). Spróbuj ponownie lub użyj tokenu API."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Fastmail não fez seu login (%@). Tente novamente ou use um token de API."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail nu te-a autentificat (%@). Încearcă din nou sau folosește un token API."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail не выполнил вход (%@). Повторите попытку или используйте токен API."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail vás neprihlásil (%@). Skúste to znova alebo použite token API."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail вас није пријавио (%@). Покушајте поново или уместо тога користите API токен."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail loggade inte in dig (%@). Försök igen eller använd en API-token i stället."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail haikukuingiza (%@). Jaribu tena, au tumia tokeni ya API badala yake."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail మిమ్మల్ని సైన్ ఇన్ చేయలేదు (%@). మళ్లీ ప్రయత్నించండి, లేదా బదులుగా API టోకెన్ ఉపయోగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail ไม่ได้ลงชื่อเข้าให้คุณ (%@) ลองอีกครั้ง หรือใช้โทเค็น API แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail giriş yapmanızı sağlamadı (%@). Yeniden deneyin veya bunun yerine bir API token'ı kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail не виконав вхід (%@). Спробуйте ще раз або скористайтеся токеном API."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail نے آپ کو سائن ان نہیں کیا (%@)۔ دوبارہ کوشش کریں، یا اس کے بجائے API ٹوکن استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail không đăng nhập cho bạn (%@). Hãy thử lại hoặc dùng token API."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail 未能让你登录(%@)。请重试,或改用 API 令牌。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail 未能讓你登入(%@)。請再試一次,或改用 API 權杖。"
          }
        }
      }
    },
    "Fastmail makes a new random address that delivers to your inbox. You can turn it off any time.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail maak 'n nuwe ewekansige adres wat by jou inkassie aflewer. Jy kan dit enige tyd afskakel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينشئ Fastmail عنوانًا عشوائيًا جديدًا يصل إلى بريدك الوارد. يمكنك إيقافه في أي وقت."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail একটি নতুন এলোমেলো ঠিকানা তৈরি করে যা আপনার ইনবক্সে আসে। আপনি যেকোনো সময় এটি বন্ধ করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail crea una adreça aleatòria nova que arriba a la teva safata d'entrada. La pots desactivar quan vulguis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail vytvoří novou náhodnou adresu, která doručuje do Přijatých. Kdykoli ji můžete vypnout."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail opretter en ny tilfældig adresse, der leverer til din indbakke. Du kan slå den fra når som helst."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail erstellt eine neue zufällige Adresse, die in deinen Posteingang zustellt. Du kannst sie jederzeit abschalten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Fastmail δημιουργεί μια νέα τυχαία διεύθυνση που παραδίδει στα Εισερχόμενά σας. Μπορείτε να την απενεργοποιήσετε οποτεδήποτε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail crea una nueva dirección aleatoria que llega a tu bandeja de entrada. Puedes desactivarla cuando quieras."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail یک نشانی تصادفی جدید می‌سازد که به صندوق ورودی شما می‌رسد. هر وقت خواستید می‌توانید خاموشش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail luo uuden satunnaisen osoitteen, jonka viestit tulevat Saapuneisiin. Voit poistaa sen käytöstä milloin tahansa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumagawa ang Fastmail ng bagong random na address na naghahatid sa inbox mo. Puwede mo itong i-off kahit kailan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail crée une nouvelle adresse aléatoire qui arrive dans votre boîte de réception. Vous pouvez la désactiver à tout moment."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail יוצר כתובת אקראית חדשה שמגיעה לדואר הנכנס שלך. אפשר לכבות אותה בכל עת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail एक नया रैंडम पता बनाता है जो आपके इनबॉक्स में आता है। आप इसे कभी भी बंद कर सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail izrađuje novu nasumičnu adresu koja isporučuje u vašu ulaznu poštu. Možete je isključiti bilo kada."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Fastmail létrehoz egy új véletlenszerű címet, amely a Bejövő mappába kézbesít. Bármikor kikapcsolhatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail membuat alamat acak baru yang dikirim ke kotak masuk Anda. Anda dapat mematikannya kapan saja."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail crea un nuovo indirizzo casuale che recapita nella tua casella. Puoi disattivarlo quando vuoi."
          }
        },
        "ja": {
          "stringUnit": {
