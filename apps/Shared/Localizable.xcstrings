        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvas na sua conta de e-mail, para ficarem iguais na web e em outros apps."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvate în contul de e-mail, deci sunt la fel pe web și în alte aplicații."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняются в почтовой учетной записи, поэтому совпадают в веб-версии и других приложениях."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukladá sa do poštového účtu, takže sedí aj na webe a v iných apkách."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Сачувано на вашем налогу поште, па је исто на вебу и у другим апликацијама."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparas i ditt e-postkonto, så att de är likadana på webben och i andra appar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imehifadhiwa kwenye akaunti yako ya barua, ili zilingane kwenye wavuti na katika programu nyingine."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ మెయిల్ ఖాతాలో సేవ్ అవుతాయి, కాబట్టి వెబ్‌లో, ఇతర యాప్‌లలో ఒకేలా ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกไว้ในบัญชีอีเมลของคุณ จึงตรงกันทั้งบนเว็บและในแอปอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Posta hesabınıza kaydedilir; web'de ve diğer uygulamalarda aynı olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігаються в поштовому обліковому записі, тож збігаються у вебверсії та інших програмах."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے میل اکاؤنٹ میں محفوظ، اس لیے ویب اور دوسری ایپس میں ایک جیسے رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được lưu vào tài khoản thư nên giống nhau trên web và trong các ứng dụng khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存到你的邮件账户,因此在网页和其他 App 中保持一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存到你的郵件帳號,因此在網頁和其他 App 中都會一致。"
          }
        }
      }
    },
