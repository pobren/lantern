          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ван мреже. Приказује се пошта сачувана на овом уређају"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline. Visar post som sparats på den här enheten"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nje ya mtandao. Inaonyesha barua zilizohifadhiwa kwenye kifaa hiki"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆఫ్‌లైన్. ఈ పరికరంలో సేవ్ చేసిన మెయిల్ చూపిస్తోంది"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ออฟไลน์ กำลังแสดงอีเมลที่บันทึกไว้บนอุปกรณ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı. Bu aygıtta kayıtlı postalar gösteriliyor"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Офлайн. Показано пошту, збережену на цьому пристрої"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آف لائن۔ اس ڈیوائس پر محفوظ میل دکھائی جا رہی ہے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ngoại tuyến. Đang hiện thư đã lưu trên thiết bị này"
          }
        },
        "zh-Hans": {
