    "An automatic reply, saved in Fastmail, so it works with every device switched off.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Outomatiese antwoord, in Fastmail gestoor, so dit werk met elke toestel afgeskakel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رد تلقائي محفوظ في Fastmail، فيعمل حتى مع إيقاف كل الأجهزة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail-এ সেভ করা একটি স্বয়ংক্রিয় উত্তর, তাই সব ডিভাইস বন্ধ থাকলেও কাজ করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una resposta automàtica, desada a Fastmail, perquè funcioni amb tots els dispositius apagats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatická odpověď uložená ve Fastmailu, takže funguje, i když jsou všechna zařízení vypnutá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et automatisk svar, gemt i Fastmail, så det virker, selv når alle enheder er slukket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine automatische Antwort, in Fastmail gespeichert, damit sie auch bei ausgeschalteten Geräten funktioniert."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια αυτόματη απάντηση, αποθηκευμένη στο Fastmail, που λειτουργεί ακόμα και με όλες τις συσκευές κλειστές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una respuesta automática guardada en Fastmail, así que funciona con todos los dispositivos apagados."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پاسخ خودکاری که در Fastmail ذخیره می‌شود، پس حتی وقتی همه دستگاه‌ها خاموش‌اند کار می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaattinen vastaus, tallennettu Fastmailiin, joten se toimii, vaikka kaikki laitteet olisivat pois päältä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isang automatic reply, naka-save sa Fastmail, kaya gumagana ito kahit naka-off ang lahat ng device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une réponse automatique, enregistrée dans Fastmail, qui fonctionne même avec tous vos appareils éteints."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תשובה אוטומטית שנשמרת ב-Fastmail, כך שהיא פועלת גם כשכל המכשירים כבויים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail में सहेजा गया एक ऑटोमैटिक जवाब, जो हर डिवाइस बंद होने पर भी काम करता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatski odgovor spremljen u Fastmailu, pa radi i kad su svi uređaji isključeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatikus válasz, a Fastmailben mentve, így akkor is működik, ha minden eszköze ki van kapcsolva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Balasan otomatis yang disimpan di Fastmail, jadi tetap berfungsi meski semua perangkat dimatikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una risposta automatica, salvata in Fastmail, che funziona anche con tutti i dispositivi spenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmailに保存される自動返信です。すべてのデバイスの電源が切れていても機能します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail에 저장되는 자동 응답으로, 모든 기기가 꺼져 있어도 작동합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Balasan automatik, disimpan dalam Fastmail, jadi ia berfungsi walaupun semua peranti dimatikan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Et automatisk svar, lagret i Fastmail, så det virker selv om alle enhetene er slått av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een automatisch antwoord, bewaard in Fastmail, dus het werkt ook met al je apparaten uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatyczna odpowiedź zapisana w Fastmail, więc działa nawet przy wyłączonych wszystkich urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma resposta automática, salva no Fastmail, para funcionar mesmo com todos os dispositivos desligados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un răspuns automat, salvat în Fastmail, care funcționează chiar și cu toate dispozitivele oprite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоответ, сохранённый в Fastmail, поэтому он работает, даже когда все устройства выключены."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatická odpoveď uložená vo Fastmaile, takže funguje, aj keď sú všetky zariadenia vypnuté."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Аутоматски одговор, сачуван у Fastmail-у, па ради и када су сви уређаји искључени."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett automatiskt svar, sparat i Fastmail, så det fungerar även när alla enheter är avstängda."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jibu la kiotomatiki, lililohifadhiwa kwenye Fastmail, kwa hivyo hufanya kazi hata vifaa vyote vikiwa vimezimwa."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmailలో సేవ్ చేసిన ఆటోమేటిక్ రిప్లై, కాబట్టి అన్ని పరికరాలు ఆఫ్‌లో ఉన్నా పనిచేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตอบกลับอัตโนมัติที่บันทึกไว้ใน Fastmail จึงทำงานได้แม้ทุกอุปกรณ์จะปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail'de kayıtlı otomatik bir yanıt; tüm aygıtlar kapalıyken de çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автовідповідь, збережена у Fastmail, тож вона працює, навіть коли всі пристрої вимкнено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail میں محفوظ ایک خودکار جواب، اس لیے یہ تمام ڈیوائسز بند ہونے پر بھی کام کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả lời tự động lưu trong Fastmail, nên vẫn hoạt động khi mọi thiết bị đều tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存在 Fastmail 中的自动回复,所有设备关机时也能运作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存在 Fastmail 中的自動回覆,即使所有裝置都關機也能運作。"
          }
        }
      }
    },
    "An email asking to unsubscribe opens, ready to send.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n E-pos wat vra om die intekening te kanselleer maak oop, gereed om te stuur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُفتح رسالة تطلب إلغاء الاشتراك، جاهزة للإرسال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আনসাবস্ক্রাইব করতে বলা একটি ইমেল পাঠানোর জন্য তৈরি অবস্থায় খোলে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "S'obre un correu demanant la baixa, a punt per enviar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevře se zpráva s žádostí o odhlášení, připravená k odeslání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En e-mail, der beder om afmelding, åbnes klar til at sende."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine E-Mail zum Abbestellen wird geöffnet, bereit zum Senden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ανοίγει ένα email αίτησης κατάργησης εγγραφής, έτοιμο για αποστολή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se abre un correo para darte de baja, listo para enviar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ایمیلی برای درخواست لغو اشتراک، آماده ارسال باز می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Avautuu viesti, jossa pyydetään perumaan tilaus, valmiina lähetettäväksi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Magbubukas ang isang email na humihiling mag-unsubscribe, handa nang ipadala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un e-mail de désabonnement s’ouvre, prêt à être envoyé."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תיפתח הודעה שמבקשת לבטל את המינוי, מוכנה לשליחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनसब्सक्राइब करने का अनुरोध करने वाला ईमेल भेजने के लिए तैयार खुलता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvara se e-poruka za odjavu, spremna za slanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Megnyílik egy leiratkozást kérő e-mail, küldésre készen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Email permintaan berhenti langganan terbuka, siap dikirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Si apre un’email per annullare l’iscrizione, pronta da inviare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信停止を依頼するメールが、送信できる状態で開きます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구독 취소를 요청하는 이메일이 보낼 준비가 된 상태로 열립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mel meminta untuk nyahlanggan dibuka, sedia untuk dihantar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En e-post som ber om å avslutte abonnementet åpnes, klar til å sendes."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er opent een e-mail om je af te melden, klaar om te versturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Otworzy się wiadomość z prośbą o wypisanie, gotowa do wysłania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Abre um e-mail pedindo o cancelamento da assinatura, pronto para enviar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Se deschide un e-mail de dezabonare, gata de trimis."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Откроется письмо с запросом на отписку, готовое к отправке."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Otvorí sa správa so žiadosťou o odhlásenie, pripravená na odoslanie."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Отвара се имејл за отказивање претплате, спреман за слање."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett mejl som ber om att avsluta prenumerationen öppnas, klart att skicka."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Barua pepe ya kuomba kujiondoa itafunguka, tayari kutumwa."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్‌సబ్‌స్క్రైబ్ చేయమని అడిగే ఈమెయిల్ పంపడానికి సిద్ధంగా తెరుచుకుంటుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีเมลขอยกเลิกการสมัครจะเปิดขึ้นพร้อมส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Abonelikten çıkma isteyen bir e-posta gönderilmeye hazır olarak açılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відкриється лист із запитом на відписку, готовий до надсилання."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ان سبسکرائب کی درخواست والی ای میل بھیجنے کے لیے تیار کھلتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một email yêu cầu hủy đăng ký sẽ mở ra, sẵn sàng để gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将打开一封请求退订的邮件,可直接发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將打開一封要求取消訂閱的郵件,可直接傳送。"
          }
        }
      }
    },
