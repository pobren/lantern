          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail이 받은 편지함으로 전달되는 새로운 무작위 주소를 만듭니다. 언제든지 끌 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail membuat alamat rawak baharu yang dihantar ke peti masuk anda. Anda boleh mematikannya bila-bila masa."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail lager en ny tilfeldig adresse som leverer til innboksen din. Du kan slå den av når som helst."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail maakt een nieuw willekeurig adres dat in Inkomend aankomt. Je kunt het altijd uitzetten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail tworzy nowy losowy adres, który dostarcza pocztę do Odebranych. Możesz go wyłączyć w każdej chwili."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Fastmail cria um novo endereço aleatório que entrega na sua Caixa de Entrada. Você pode desativá-lo quando quiser."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail creează o adresă aleatorie nouă care livrează în Intrări. O poți dezactiva oricând."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail создаёт новый случайный адрес с доставкой во «Входящие». Его можно отключить в любой момент."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail vytvorí novú náhodnú adresu, ktorá doručuje do Prijatých. Kedykoľvek ju môžete vypnúť."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail прави нову насумичну адресу која стиже у ваше Пријемно сандуче. Можете је искључити било када."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail skapar en ny slumpmässig adress som levereras till din inkorg. Du kan stänga av den när som helst."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail hutengeneza anwani mpya ya nasibu inayofika kwenye kikasha chako. Unaweza kuizima wakati wowote."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail మీ ఇన్‌బాక్స్‌కు వచ్చే కొత్త రాండమ్ అడ్రస్ తయారు చేస్తుంది. మీరు దాన్ని ఎప్పుడైనా ఆఫ్ చేయవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail จะสร้างที่อยู่แบบสุ่มใหม่ที่ส่งถึงกล่องจดหมายเข้าของคุณ คุณสามารถปิดได้ทุกเมื่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail, gelen kutunuza ulaşan yeni ve rastgele bir adres oluşturur. İstediğiniz zaman kapatabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail створює нову випадкову адресу з доставкою у «Вхідні». Її можна вимкнути будь-коли."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail ایک نیا بے ترتیب پتہ بناتا ہے جو آپ کے ان باکس میں آتا ہے۔ آپ اسے کسی بھی وقت بند کر سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail tạo một địa chỉ ngẫu nhiên mới gửi về hộp thư đến của bạn. Bạn có thể tắt nó bất cứ lúc nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail 会创建一个新的随机地址,邮件送到你的收件箱。你可以随时将其关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail 會製作一個新的隨機地址,郵件會送到你的收件匣。你可以隨時將其關閉。"
          }
        }
      }
    },
