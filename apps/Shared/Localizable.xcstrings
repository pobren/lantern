    "Sign in on Fastmail's own page. JMAP Connect never sees your password.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Meld aan op Fastmail se eie bladsy. JMAP Connect sien nooit jou wagwoord nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل الدخول في صفحة Fastmail نفسها. لا يرى JMAP Connect كلمة السر أبدًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail-এর নিজস্ব পেজে সাইন ইন করুন। JMAP Connect কখনো আপনার পাসওয়ার্ড দেখে না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sessió a la pàgina de Fastmail. JMAP Connect no veu mai la teva contrasenya."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlaste se na stránce Fastmailu. JMAP Connect vaše heslo nikdy neuvidí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Log ind på Fastmails egen side. JMAP Connect ser aldrig din adgangskode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Melde dich auf der Seite von Fastmail an. JMAP Connect sieht dein Passwort nie."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Συνδεθείτε στη σελίδα του Fastmail. Το JMAP Connect δεν βλέπει ποτέ το συνθηματικό σας."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia sesión en la página de Fastmail. JMAP Connect nunca ve tu contraseña."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در صفحه خود Fastmail وارد شوید. JMAP Connect هرگز رمز شما را نمی‌بیند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjaudu Fastmailin omalla sivulla. JMAP Connect ei koskaan näe salasanaasi."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mag-sign in sa sariling page ng Fastmail. Hindi kailanman nakikita ng JMAP Connect ang password mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Connectez-vous sur la page de Fastmail. JMAP Connect ne voit jamais votre mot de passe."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התחבר בדף של Fastmail עצמו. JMAP Connect אף פעם לא רואה את הסיסמה שלך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail के अपने पेज पर साइन इन करें। JMAP Connect कभी आपका पासवर्ड नहीं देखता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prijavite se na Fastmailovoj stranici. JMAP Connect nikad ne vidi vašu lozinku."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Jelentkezzen be a Fastmail saját oldalán. A JMAP Connect sosem látja a jelszavát."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masuk di halaman Fastmail sendiri. JMAP Connect tidak pernah melihat kata sandi Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Accedi dalla pagina di Fastmail. JMAP Connect non vede mai la tua password."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail自身のページでサインインします。JMAP Connectがパスワードを見ることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail의 자체 페이지에서 로그인합니다. JMAP Connect는 암호를 볼 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar masuk pada halaman Fastmail sendiri. JMAP Connect tidak pernah melihat kata laluan anda."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Logg på Fastmails egen side. JMAP Connect ser aldri passordet ditt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Log in op de eigen pagina van Fastmail. JMAP Connect ziet je wachtwoord nooit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaloguj się na stronie Fastmail. JMAP Connect nigdy nie widzi Twojego hasła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Entre na própria página do Fastmail. O JMAP Connect nunca vê sua senha."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentifică-te pe pagina Fastmail. JMAP Connect nu îți vede niciodată parola."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход выполняется на странице Fastmail. JMAP Connect не видит ваш пароль."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihláste sa na stránke Fastmailu. JMAP Connect vaše heslo nikdy neuvidí."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Пријавите се на Fastmail-овој страници. JMAP Connect никада не види вашу лозинку."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Logga in på Fastmails egen sida. JMAP Connect ser aldrig ditt lösenord."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingia kwenye ukurasa wa Fastmail wenyewe. JMAP Connect haioni nenosiri lako kamwe."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail సొంత పేజీలో సైన్ ఇన్ చేయండి. JMAP Connect మీ పాస్‌వర్డ్‌ను ఎప్పుడూ చూడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลงชื่อเข้าในหน้าของ Fastmail เอง JMAP Connect จะไม่เห็นรหัสผ่านของคุณ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail'in kendi sayfasında giriş yapın. JMAP Connect parolanızı asla görmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід відбувається на сторінці Fastmail. JMAP Connect не бачить ваш пароль."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail کے اپنے صفحے پر سائن ان کریں۔ JMAP Connect آپ کا پاس ورڈ کبھی نہیں دیکھتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đăng nhập trên trang riêng của Fastmail. JMAP Connect không bao giờ thấy mật khẩu của bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Fastmail 自己的页面上登录。JMAP Connect 永远不会看到你的密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Fastmail 自己的頁面上登入。JMAP Connect 絕不會看到你的密碼。"
          }
        }
      }
    },
