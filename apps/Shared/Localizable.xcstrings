          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "V paneli Thundermail otvorte Email Settings a stlačte Create app password. Použite svoju adresu Thundermail a toto heslo pre apku."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "На контролној табли Thundermail-а отворите Email Settings и притисните Create app password. Користите своју Thundermail адресу и ту лозинку за апликацију."
          }
