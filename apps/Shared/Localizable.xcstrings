        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ای میل پر یہی واحد لیبل ہے۔ اس کے بجائے اسے آرکائیو یا منتقل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là nhãn duy nhất trên email này. Hãy lưu trữ hoặc di chuyển nó."
