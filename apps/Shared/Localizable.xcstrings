    "Too late to undo: the email has gone.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Te laat om te ontdoen: die e-pos is weg."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فات أوان التراجع: أُرسلت الرسالة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পূর্বাবস্থায় ফেরানোর সময় নেই: ইমেলটি চলে গেছে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Massa tard per desfer: el correu ja ha sortit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na odvolání je pozdě: zpráva už odešla."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For sent at fortryde: e-mailen er sendt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu spät zum Widerrufen: Die E-Mail ist schon raus."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πολύ αργά για αναίρεση: το email έφυγε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiado tarde para deshacer: el correo ya ha salido."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای واگرد دیر است: ایمیل رفته است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liian myöhäistä kumota: viesti on lähtenyt."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Huli na para i-undo: naipadala na ang email."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop tard pour annuler : l’e-mail est parti."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מאוחר מדי לבטל: ההודעה כבר נשלחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूर्ववत करने में देर हो गई: ईमेल जा चुका है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Prekasno za poništavanje: e-poruka je otišla."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Túl késő a visszavonáshoz: az e-mail elment."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlambat untuk mengurungkan: email sudah terkirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Troppo tardi per annullare: l’email è partita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取り消すには遅すぎます。メールは送信されました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "실행 취소하기에 너무 늦었습니다. 이메일이 전송되었습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Terlambat untuk buat asal: e-mel sudah dihantar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "For sent å angre: e-posten er sendt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Te laat om te herstellen: de e-mail is al weg."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Za późno na cofnięcie: wiadomość już wyszła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarde demais para desfazer: o e-mail já foi enviado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prea târziu pentru anulare: e-mailul a plecat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Слишком поздно отменять: письмо уже ушло."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Na vrátenie je neskoro: správa už odišla."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Прекасно за опозив: имејл је отишао."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "För sent att ångra: mejlet har skickats."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Umechelewa kutendua: barua pepe imeshatumwa."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "రద్దు చేయడానికి ఆలస్యమైంది: ఈమెయిల్ వెళ్లిపోయింది."
          }
        },
        "th": {
