    "Open JMAP Connect to fill this in.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Maak JMAP Connect oop om dit in te vul."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "افتح JMAP Connect لملء هذا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি পূরণ করতে JMAP Connect খুলুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Obre JMAP Connect per omplir això."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Otevřete JMAP Connect, aby se to vyplnilo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Åbn JMAP Connect for at udfylde dette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffne JMAP Connect, um dies zu füllen."
          }
        },
        "el": {
