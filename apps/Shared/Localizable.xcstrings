    "The server didn't accept that sign in. Check the token or app password and try again.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Die bediener het daardie aanmelding nie aanvaar nie. Kontroleer die token of app-wagwoord en probeer weer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يقبل الخادم تسجيل الدخول هذا. تحقق من الرمز أو كلمة سر التطبيق وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সার্ভার সেই সাইন ইন গ্রহণ করেনি। টোকেন বা অ্যাপ পাসওয়ার্ড দেখে আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no ha acceptat l'inici de sessió. Comprova el testimoni o la contrasenya d'app i torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Server přihlášení nepřijal. Zkontrolujte token nebo heslo pro aplikaci a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Serveren accepterede ikke det login. Tjek token eller app-adgangskoden, og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Server hat die Anmeldung nicht akzeptiert. Prüfe den Token oder das App-Passwort und versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής δεν δέχτηκε τη σύνδεση. Ελέγξτε το token ή το συνθηματικό εφαρμογής και δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor no ha aceptado ese inicio de sesión. Comprueba el token o la contraseña de app e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرور آن ورود را نپذیرفت. توکن یا رمز برنامه را بررسی کنید و دوباره امتحان کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Palvelin ei hyväksynyt kirjautumista. Tarkista tunnus tai sovelluksen salasana ja yritä uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi tinanggap ng server ang pag-sign in na iyon. Tingnan ang token o app password at subukan ulit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le serveur n’a pas accepté cette connexion. Vérifiez le jeton ou le mot de passe d’app et réessayez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השרת לא קיבל את ההתחברות. בדוק את האסימון או את סיסמת היישום ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सर्वर ने वह साइन इन स्वीकार नहीं किया। टोकन या ऐप पासवर्ड जाँचें और फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslužitelj nije prihvatio prijavu. Provjerite token ili lozinku za aplikaciju i pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A szerver nem fogadta el a bejelentkezést. Ellenőrizze a tokent vagy az alkalmazásjelszót, és próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
