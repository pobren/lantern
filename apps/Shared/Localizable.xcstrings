    "Sent to %@, which isn't set up for sending.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestuur na %@, wat nie opgestel is om van te stuur nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُرسلت إلى %@، وهو غير مُعدّ للإرسال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@-এ পাঠানো হয়েছিল, যা পাঠানোর জন্য সেট আপ করা নেই।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviat a %@, que no està configurada per enviar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Posláno na %@, odkud odesílání není nastavené."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendt til %@, som ikke er sat op til afsendelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "An %@ gesendet, die nicht zum Senden eingerichtet ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Στάλθηκε στο %@, που δεν έχει ρυθμιστεί για αποστολή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado a %@, que no está configurada para enviar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به %@ فرستاده شده که برای ارسال تنظیم نشده است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lähetetty osoitteeseen %@, jota ei ole määritetty lähettämistä varten."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinadala sa %@, na hindi naka-set up para sa pagpapadala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Envoyé à %@, qui n’est pas configurée pour l’envoi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשלח אל %@, שלא מוגדרת לשליחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पर भेजा गया, जो भेजने के लिए सेट नहीं है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Poslano na %@, koja nije postavljena za slanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ide érkezett: %@, de ez nincs beállítva küldésre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dikirim ke %@, yang belum diatur untuk mengirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviata a %@, che non è configurato per l’invio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@宛てに届いたメールですが、このアドレスは送信用に設定されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@(으)로 받은 메일이지만, 이 주소는 보내기용으로 설정되어 있지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dihantar kepada %@, yang tidak disediakan untuk menghantar."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Sendt til %@, som ikke er satt opp for sending."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verstuurd naar %@, dat niet is ingesteld om te versturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysłane na %@, który nie jest skonfigurowany do wysyłania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Enviado para %@, que não está configurado para envio."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Trimis către %@, care nu este configurată pentru trimitere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отправлено на %@, но с этого адреса отправка не настроена."
          }
        },
        "sk": {
          "stringUnit": {
