          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שרת הדואר דחה את הבקשה: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके मेल सर्वर ने अनुरोध ठुकरा दिया: %@"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš poslužitelj e-pošte odbio je zahtjev: %@"
          }
        },
        "hu": {
