    "Your mail goes straight between this device and your provider. Not affiliated with any provider.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou pos gaan reguit tussen hierdie toestel en jou verskaffer. Nie aan enige verskaffer verbonde nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينتقل بريدك مباشرة بين هذا الجهاز ومزودك. غير تابع لأي مزود."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার মেল সরাসরি এই ডিভাইস আর আপনার প্রদানকারীর মধ্যে যায়। কোনো প্রদানকারীর সাথে সম্পর্কিত নয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El teu correu va directament entre aquest dispositiu i el teu proveïdor. Sense afiliació amb cap proveïdor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše pošta jde přímo mezi tímto zařízením a vaším poskytovatelem. Nemá nic společného s žádným poskytovatelem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din post går direkte mellem denne enhed og din udbyder. Ikke tilknyttet nogen udbyder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine E-Mails gehen direkt zwischen diesem Gerät und deinem Anbieter hin und her. Mit keinem Anbieter verbunden."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Τα email σας πηγαίνουν απευθείας μεταξύ αυτής της συσκευής και του παρόχου σας. Δεν συνδέεται με κανέναν πάροχο."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu correo va directamente entre este dispositivo y tu proveedor. No afiliado a ningún proveedor."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ایمیل شما مستقیم بین این دستگاه و ارائه‌دهنده‌تان جابه‌جا می‌شود. وابسته به هیچ ارائه‌دهنده‌ای نیست."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Postisi kulkee suoraan tämän laitteen ja palveluntarjoajasi välillä. Ei yhteydessä mihinkään palveluntarjoajaan."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Diretsong dumadaan ang mail mo sa pagitan ng device na ito at ng provider mo. Hindi kaugnay ng anumang provider."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos e-mails passent directement entre cet appareil et votre fournisseur. Non affilié à un fournisseur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדואר שלך עובר ישירות בין המכשיר הזה לספק שלך. לא קשור לאף ספק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी मेल सीधे इस डिवाइस और आपके प्रदाता के बीच जाती है। किसी प्रदाता से संबद्ध नहीं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša pošta ide izravno između ovog uređaja i vašeg pružatelja. Nije povezano ni s jednim pružateljem."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A levelei közvetlenül az eszköz és a szolgáltató között mennek. Egyik szolgáltatóhoz sem kapcsolódik."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Email Anda langsung bergerak antara perangkat ini dan penyedia Anda. Tidak berafiliasi dengan penyedia mana pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La tua posta va direttamente tra questo dispositivo e il tuo provider. Non affiliato ad alcun provider."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールはこのデバイスとプロバイダの間で直接やり取りされます。どのプロバイダとも提携していません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메일은 이 기기와 제공업체 간에 직접 전송됩니다. 어떤 제공업체와도 제휴하지 않았습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mel anda terus antara peranti ini dan penyedia anda. Tidak bergabung dengan mana-mana penyedia."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "E-posten din går rett mellom denne enheten og leverandøren din. Ikke tilknyttet noen leverandør."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je mail gaat rechtstreeks tussen dit apparaat en je aanbieder. Niet verbonden aan een aanbieder."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja poczta idzie prosto między tym urządzeniem a dostawcą. Niepowiązane z żadnym dostawcą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus e-mails vão direto entre este dispositivo e o seu provedor. Não afiliado a nenhum provedor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mailurile circulă direct între acest dispozitiv și furnizor. Nu este afiliat cu niciun furnizor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почта идёт напрямую между этим устройством и вашим провайдером. Не связано ни с одним провайдером."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaša pošta ide priamo medzi týmto zariadením a vaším poskytovateľom. Nemá nič spoločné so žiadnym poskytovateľom."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваша пошта иде директно између овог уређаја и вашег добављача. Није повезано ни са једним добављачем."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Din post går direkt mellan den här enheten och din leverantör. Inte associerad med någon leverantör."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Barua zako huenda moja kwa moja kati ya kifaa hiki na mtoa huduma wako. Haihusiani na mtoa huduma yeyote."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ మెయిల్ ఈ పరికరం మరియు మీ ప్రొవైడర్ మధ్య నేరుగా వెళ్తుంది. ఏ ప్రొవైడర్‌తోనూ అనుబంధం లేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีเมลของคุณส่งตรงระหว่างอุปกรณ์นี้กับผู้ให้บริการ ไม่ได้เป็นพันธมิตรกับผู้ให้บริการรายใด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Postalarınız doğrudan bu aygıt ile sağlayıcınız arasında gider. Hiçbir sağlayıcıyla bağlantılı değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошта йде напряму між цим пристроєм і вашим провайдером. Не пов’язано з жодним провайдером."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی میل سیدھی اس ڈیوائس اور آپ کے فراہم کنندہ کے درمیان جاتی ہے۔ کسی فراہم کنندہ سے وابستہ نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư đi thẳng giữa thiết bị này và nhà cung cấp của bạn. Không liên kết với nhà cung cấp nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的邮件直接在此设备和提供商之间传输。与任何提供商均无关联。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的郵件直接在此裝置和供應商之間傳輸。與任何供應商均無關聯。"
          }
        }
      }
    },
