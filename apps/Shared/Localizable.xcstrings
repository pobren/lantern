          "stringUnit": {
            "state": "translated",
            "value": "మీ Watch కనెక్ట్ కాలేదు. మీ Watchలో JMAP Connect తెరిచి మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch ของคุณไม่ได้เชื่อมต่อ เปิด JMAP Connect บน Apple Watch แล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch'unuz bağlı değil. Watch'unuzda JMAP Connect'i açın ve yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch не підключено. Відкрийте JMAP Connect на Watch і спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کی Watch کنیکٹ نہیں ہے۔ اپنی Watch پر JMAP Connect کھولیں، پھر دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch chưa được kết nối. Hãy mở JMAP Connect trên Watch rồi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Apple Watch 未连接。请在 Apple Watch 上打开 JMAP Connect,然后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的 Apple Watch 未連線。請在 Apple Watch 上打開 JMAP Connect,然後再試一次。"
          }
        }
      }
    },
