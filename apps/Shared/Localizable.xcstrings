    "Without dates, the reply goes out from now until you turn it off.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonder datums gaan die antwoord uit van nou af totdat jy dit afskakel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من دون تواريخ، يُرسل الرد من الآن حتى توقفه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তারিখ ছাড়া, উত্তরটি এখন থেকে আপনি বন্ধ না করা পর্যন্ত যায়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense dates, la resposta s'envia des d'ara fins que la desactivis."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez dat se odpověď posílá od teď, dokud ji nevypnete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden datoer sendes svaret fra nu, indtil du slår det fra."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Datum wird die Antwort ab sofort gesendet, bis du sie ausschaltest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς ημερομηνίες, η απάντηση στέλνεται από τώρα μέχρι να την απενεργοποιήσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin fechas, la respuesta se envía desde ahora hasta que la desactives."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون تاریخ، پاسخ از الان تا وقتی خاموشش کنید فرستاده می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman päivämääriä vastaus lähtee nyt ja siihen asti, kunnes poistat sen käytöstä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung walang petsa, ipapadala ang reply mula ngayon hanggang i-off mo ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans dates, la réponse est envoyée dès maintenant jusqu’à ce que vous la désactiviez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלי תאריכים, התשובה נשלחת מעכשיו ועד שתכבה אותה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तारीखों के बिना, जवाब अभी से तब तक जाता है जब तक आप उसे बंद न करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez datuma odgovor se šalje od sada dok ga ne isključite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Dátumok nélkül a válasz mostantól megy, amíg ki nem kapcsolja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa tanggal, balasan dikirim mulai sekarang sampai Anda mematikannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza date, la risposta parte da ora finché non la disattivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "日付を指定しない場合、今からオフにするまで自動返信が送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "날짜를 지정하지 않으면 지금부터 끌 때까지 자동 응답이 전송됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa tarikh, balasan dihantar dari sekarang sehingga anda mematikannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten datoer sendes svaret fra nå til du slår det av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder datums gaat het antwoord vanaf nu uit tot je het uitzet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez dat odpowiedź jest wysyłana od teraz, dopóki jej nie wyłączysz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem datas, a resposta é enviada a partir de agora até você desativá-la."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără date, răspunsul se trimite de acum până îl dezactivezi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без дат автоответ работает с этого момента, пока вы его не выключите."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez dátumov sa odpoveď posiela odteraz, kým ju nevypnete."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Без датума, одговор се шаље од сада док га не искључите."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan datum skickas svaret från och med nu tills du stänger av det."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bila tarehe, jibu hutumwa kuanzia sasa hadi utakapolizima."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తేదీలు లేకుంటే, రిప్లై ఇప్పటి నుండి మీరు ఆఫ్ చేసే వరకు వెళ్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่ระบุวันที่ การตอบกลับจะส่งตั้งแต่ตอนนี้จนกว่าคุณจะปิด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tarih olmadan yanıt, şimdiden siz kapatana dek gönderilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без дат автовідповідь працює відтепер, доки ви її не вимкнете."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تاریخوں کے بغیر، جواب ابھی سے تب تک جاتا ہے جب تک آپ اسے بند نہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có ngày, thư trả lời sẽ được gửi từ bây giờ cho tới khi bạn tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不设日期时,自动回复从现在起发送,直到你将其关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "未設定日期時,自動回覆會從現在起寄出,直到你將其關閉。"
          }
        }
      }
    },
    "Without instant alerts, iPhone and iPad check for mail in the background when iOS allows, usually every 15 minutes or so.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonder kitswaarskuwings kyk iPhone en iPad in die agtergrond vir pos wanneer iOS dit toelaat, gewoonlik so elke 15 minute."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من دون التنبيهات الفورية، يتحقق iPhone وiPad من البريد في الخلفية عندما يسمح iOS، عادةً كل 15 دقيقة تقريبًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তাৎক্ষণিক অ্যালার্ট ছাড়া, iPhone ও iPad iOS অনুমতি দিলে ব্যাকগ্রাউন্ডে মেল চেক করে, সাধারণত প্রায় প্রতি 15 মিনিটে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense avisos instantanis, l'iPhone i l'iPad comproven el correu en segon pla quan iOS ho permet, normalment cada 15 minuts o així."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez okamžitých upozornění kontrolují iPhone a iPad poštu na pozadí, když to iOS dovolí, obvykle zhruba každých 15 minut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden øjeblikkelige notifikationer tjekker iPhone og iPad efter post i baggrunden, når iOS tillader det, normalt cirka hvert 15. minut."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne Sofortmitteilungen suchen iPhone und iPad im Hintergrund nach E-Mails, wenn iOS es erlaubt, meist etwa alle 15 Minuten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς άμεσες ειδοποιήσεις, το iPhone και το iPad ελέγχουν για email στο παρασκήνιο όταν το επιτρέπει το iOS, συνήθως κάθε 15 λεπτά περίπου."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin alertas instantáneas, el iPhone y el iPad buscan correo en segundo plano cuando iOS lo permite, normalmente cada 15 minutos o así."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون هشدار فوری، iPhone و iPad هر وقت iOS اجازه دهد ایمیل را در پس‌زمینه بررسی می‌کنند، معمولاً حدود هر ۱۵ دقیقه."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman välittömiä ilmoituksia iPhone ja iPad tarkistavat postin taustalla, kun iOS sallii, yleensä noin 15 minuutin välein."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung walang instant alert, tinitingnan ng iPhone at iPad ang mail sa background kapag pinapayagan ng iOS, karaniwang bawat 15 minuto o higit pa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans alertes instantanées, l’iPhone et l’iPad relèvent les e-mails en arrière-plan quand iOS le permet, en général toutes les 15 minutes environ."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלי התראות מיידיות, iPhone ו-iPad בודקים דואר ברקע כש-iOS מאפשר, בדרך כלל בערך כל 15 דקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "तुरंत अलर्ट के बिना, iPhone और iPad बैकग्राउंड में मेल तब जाँचते हैं जब iOS अनुमति दे, आमतौर पर लगभग हर 15 मिनट में।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez trenutačnih upozorenja iPhone i iPad provjeravaju poštu u pozadini kad iOS dopusti, obično otprilike svakih 15 minuta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azonnali értesítések nélkül az iPhone és az iPad a háttérben keres új leveleket, amikor az iOS engedi, általában kb. 15 percenként."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa peringatan instan, iPhone dan iPad memeriksa email di latar belakang saat iOS mengizinkan, biasanya sekitar setiap 15 menit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza avvisi istantanei, iPhone e iPad controllano la posta in background quando iOS lo consente, di solito ogni 15 minuti circa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インスタント通知がない場合、iPhoneとiPadはiOSが許可したときにバックグラウンドでメールを確認します。通常は15分ごとくらいです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "즉시 알림이 없으면 iPhone과 iPad는 iOS가 허용할 때 백그라운드에서 메일을 확인하며, 보통 15분 정도마다 확인합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa amaran segera, iPhone dan iPad menyemak mel di latar belakang apabila iOS membenarkan, biasanya setiap 15 minit atau lebih."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten direktevarsler sjekker iPhone og iPad e-post i bakgrunnen når iOS tillater det, vanligvis omtrent hvert 15. minutt."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder directe meldingen controleren iPhone en iPad op de achtergrond op mail wanneer iOS dat toestaat, meestal ongeveer elke 15 minuten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez natychmiastowych alertów iPhone i iPad sprawdzają pocztę w tle, gdy iOS na to pozwala, zwykle mniej więcej co 15 minut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem alertas instantâneos, o iPhone e o iPad verificam e-mails em segundo plano quando o iOS permite, geralmente a cada 15 minutos ou mais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără alerte instantanee, iPhone și iPad verifică e-mailurile în fundal când permite iOS, de obicei cam la fiecare 15 minute."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без мгновенных уведомлений iPhone и iPad проверяют почту в фоне, когда позволяет iOS, обычно примерно раз в 15 минут."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez okamžitých upozornení kontrolujú iPhone a iPad poštu na pozadí, keď to iOS dovolí, zvyčajne zhruba každých 15 minút."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Без тренутних обавештења, iPhone и iPad проверавају пошту у позадини када iOS дозволи, обично отприлике на сваких 15 минута."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan direktaviseringar hämtar iPhone och iPad post i bakgrunden när iOS tillåter, oftast ungefär var 15:e minut."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bila arifa za papo hapo, iPhone na iPad hukagua barua chinichini iOS inaporuhusu, kwa kawaida kila dakika 15 hivi."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "తక్షణ అలర్ట్‌లు లేకుండా, iOS అనుమతించినప్పుడు iPhone, iPad బ్యాక్‌గ్రౌండ్‌లో మెయిల్ చెక్ చేస్తాయి, సాధారణంగా దాదాపు ప్రతి 15 నిమిషాలకు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่มีการแจ้งเตือนทันที iPhone และ iPad จะตรวจหาอีเมลในพื้นหลังเมื่อ iOS อนุญาต ซึ่งปกติประมาณทุก 15 นาที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anında uyarılar olmadan iPhone ve iPad, iOS izin verdiğinde postaları arka planda denetler; genellikle 15 dakikada bir kadar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без миттєвих сповіщень iPhone та iPad перевіряють пошту у фоні, коли дозволяє iOS, зазвичай приблизно раз на 15 хвилин."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فوری الرٹس کے بغیر، iPhone اور iPad جب iOS اجازت دے بیک گراؤنڈ میں میل چیک کرتے ہیں، عام طور پر تقریباً ہر 15 منٹ بعد۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có thông báo tức thì, iPhone và iPad kiểm tra thư ở chế độ nền khi iOS cho phép, thường khoảng 15 phút một lần."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有即时提醒时,iPhone 和 iPad 会在 iOS 允许时于后台检查邮件,通常约每 15 分钟一次。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "沒有即時提醒時,iPhone 和 iPad 會在 iOS 允許時於背景檢查郵件,通常約每 15 分鐘一次。"
          }
        }
      }
    },
    "Without this, your Watch uses your iPhone's Fastmail sign in, which lasts about an hour once your iPhone is out of reach. Sign in once more here and the Watch gets a sign in of its own, so it keeps checking mail over Wi-Fi or mobile signal. It goes straight to your Watch; nothing is kept on this iPhone or sent anywhere else.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiersonder gebruik jou Watch jou iPhone se Fastmail-aanmelding, wat omtrent 'n uur hou sodra jou iPhone buite bereik is. Meld hier nog een keer aan en die Watch kry sy eie aanmelding, so dit hou aan om pos oor Wi-Fi of selfoonsein na te gaan. Dit gaan reguit na jou Watch; niks word op hierdie iPhone gehou of elders heen gestuur nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "من دون هذا، تستخدم ساعتك تسجيل دخول Fastmail على iPhone، والذي يدوم نحو ساعة بعد ابتعاد iPhone. سجّل الدخول مرة أخرى هنا لتحصل الساعة على تسجيل دخول خاص بها، فتواصل التحقق من البريد عبر Wi-Fi أو الشبكة الخلوية. يذهب مباشرة إلى ساعتك؛ لا يُحفظ شيء على هذا الـ iPhone ولا يُرسل إلى أي مكان آخر."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি ছাড়া আপনার Watch আপনার iPhone-এর Fastmail সাইন ইন ব্যবহার করে, যা iPhone নাগালের বাইরে গেলে প্রায় এক ঘণ্টা থাকে। এখানে আরেকবার সাইন ইন করুন, তাহলে Watch নিজের সাইন ইন পাবে, যাতে Wi-Fi বা মোবাইল সিগন্যালে মেল চেক করতে থাকে। এটি সরাসরি আপনার Watch-এ যায়; এই iPhone-এ কিছু রাখা হয় না বা অন্য কোথাও পাঠানো হয় না।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Sense això, el Watch fa servir l'inici de sessió de Fastmail de l'iPhone, que dura una hora més o menys quan l'iPhone és fora d'abast. Inicia sessió un cop més aquí i el Watch tindrà el seu propi inici de sessió, perquè continuï comprovant el correu per Wi-Fi o dades mòbils. Va directament al Watch; no es guarda res en aquest iPhone ni s'envia enlloc."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez tohoto používají hodinky Watch přihlášení k Fastmailu z iPhonu, které vydrží asi hodinu, když je iPhone mimo dosah. Přihlaste se tu ještě jednou a Watch dostanou vlastní přihlášení, takže budou dál kontrolovat poštu přes Wi-Fi nebo mobilní síť. Jde přímo do Watch; nic se neukládá na tomto iPhonu ani neposílá jinam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Uden dette bruger dit Watch din iPhones Fastmail-login, som holder cirka en time, når din iPhone er uden for rækkevidde. Log ind én gang mere her, så får dit Watch sit eget login og bliver ved med at tjekke post via Wi-Fi eller mobilnetværk. Det går direkte til dit Watch; intet gemmes på denne iPhone eller sendes andre steder hen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ohne dies nutzt deine Watch die Fastmail-Anmeldung deines iPhone, die etwa eine Stunde hält, sobald dein iPhone außer Reichweite ist. Melde dich hier noch einmal an, dann bekommt die Watch eine eigene Anmeldung und ruft weiter über WLAN oder Mobilfunk E-Mails ab. Sie geht direkt an deine Watch; nichts wird auf diesem iPhone gespeichert oder anderswohin gesendet."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χωρίς αυτό, το Watch χρησιμοποιεί τη σύνδεση Fastmail του iPhone, που διαρκεί περίπου μία ώρα όταν το iPhone είναι εκτός εμβέλειας. Συνδεθείτε άλλη μία φορά εδώ και το Watch αποκτά δική του σύνδεση, ώστε να ελέγχει email μέσω Wi-Fi ή δικτύου κινητής. Πηγαίνει απευθείας στο Watch· τίποτα δεν κρατιέται σε αυτό το iPhone ούτε στέλνεται αλλού."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Sin esto, tu Watch usa el inicio de sesión de Fastmail de tu iPhone, que dura alrededor de una hora cuando el iPhone está fuera de alcance. Inicia sesión una vez más aquí y el Watch tendrá su propio inicio de sesión, para seguir comprobando el correo por wifi o datos móviles. Va directamente a tu Watch; no se guarda nada en este iPhone ni se envía a ningún otro sitio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بدون این، Watch شما از ورود Fastmail در iPhone استفاده می‌کند که پس از دور شدن iPhone حدود یک ساعت دوام دارد. یک بار دیگر اینجا وارد شوید تا Watch ورود خودش را داشته باشد و از طریق Wi-Fi یا شبکه تلفن همراه به بررسی ایمیل ادامه دهد. مستقیم به Watch شما می‌رود؛ چیزی روی این iPhone نگه داشته یا به جای دیگری فرستاده نمی‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilman tätä Watch käyttää iPhonen Fastmail-kirjautumista, joka kestää noin tunnin, kun iPhone on kantaman ulkopuolella. Kirjaudu tässä vielä kerran, niin Watch saa oman kirjautumisen ja tarkistaa postia edelleen Wi-Fin tai mobiiliverkon kautta. Se menee suoraan Watchiin; mitään ei säilytetä tällä iPhonella eikä lähetetä muualle."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kung wala ito, ginagamit ng Watch mo ang Fastmail sign-in ng iPhone mo, na tumatagal nang mga isang oras kapag malayo na ang iPhone mo. Mag-sign in muli dito at magkakaroon ang Watch ng sariling sign-in, kaya patuloy itong titingin ng mail sa Wi-Fi o mobile signal. Diretso ito sa Watch mo; walang itinatago sa iPhone na ito o ipinapadala kahit saan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sans cela, votre Watch utilise la connexion Fastmail de votre iPhone, qui dure environ une heure une fois l’iPhone hors de portée. Connectez-vous encore une fois ici et la Watch obtient sa propre connexion, pour continuer à relever les e-mails en Wi-Fi ou en réseau cellulaire. Elle va directement à votre Watch ; rien n’est conservé sur cet iPhone ni envoyé ailleurs."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בלי זה, ה-Watch משתמש בהתחברות ל-Fastmail של ה-iPhone, שנמשכת כשעה אחרי שה-iPhone יוצא מטווח. התחבר כאן פעם נוספת וה-Watch יקבל התחברות משלו, כך שימשיך לבדוק דואר דרך Wi-Fi או רשת סלולרית. היא עוברת ישירות ל-Watch; שום דבר לא נשמר ב-iPhone הזה ולא נשלח לשום מקום אחר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके बिना, आपकी Watch आपके iPhone का Fastmail साइन इन इस्तेमाल करती है, जो iPhone के पहुँच से बाहर होने पर लगभग एक घंटा चलता है। यहाँ एक बार और साइन इन करें और Watch को अपना साइन इन मिल जाएगा, ताकि वह Wi-Fi या मोबाइल सिग्नल पर मेल जाँचती रहे। यह सीधे आपकी Watch पर जाता है; इस iPhone पर कुछ नहीं रखा जाता और कहीं और नहीं भेजा जाता।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez ovoga Watch koristi Fastmail prijavu s iPhonea, koja traje oko sat vremena nakon što je iPhone izvan dometa. Prijavite se još jednom ovdje i Watch dobiva vlastitu prijavu, pa nastavlja provjeravati poštu preko Wi-Fi ili mobilne mreže. Ide izravno na Watch; ništa se ne čuva na ovom iPhoneu niti šalje drugamo."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Enélkül a Watch az iPhone Fastmail-bejelentkezését használja, amely kb. egy óráig tart, ha az iPhone nincs a közelben. Jelentkezzen be itt még egyszer, és a Watch saját bejelentkezést kap, így Wi-Fin vagy mobilhálózaton is tovább ellenőrzi a leveleket. Egyenesen a Watchra kerül; semmi sem marad ezen az iPhone-on, és máshová sem jut."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa ini, Watch Anda menggunakan akses masuk Fastmail dari iPhone, yang bertahan sekitar satu jam setelah iPhone di luar jangkauan. Masuk sekali lagi di sini dan Watch mendapat akses masuknya sendiri, jadi tetap memeriksa email lewat Wi-Fi atau sinyal seluler. Akses ini langsung dikirim ke Watch; tidak ada yang disimpan di iPhone ini atau dikirim ke tempat lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Senza questo, il tuo Watch usa l’accesso a Fastmail dell’iPhone, che dura circa un’ora quando l’iPhone è fuori portata. Accedi ancora una volta qui e il Watch avrà un accesso tutto suo, così continua a controllare la posta via Wi-Fi o rete cellulare. Va direttamente al tuo Watch; niente viene conservato su questo iPhone o inviato altrove."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを設定しない場合、Apple WatchはiPhoneのFastmailサインインを使用しますが、iPhoneが圏外になると約1時間で切れます。ここでもう一度サインインすると、Apple Watch専用のサインインが作成され、Wi-Fiやモバイル通信でメールを確認し続けられます。サインイン情報はApple Watchに直接送られ、このiPhoneに保存されたりほかの場所に送信されたりすることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 설정이 없으면 Apple Watch는 iPhone의 Fastmail 로그인을 사용하며, iPhone이 범위를 벗어나면 약 1시간 동안 유지됩니다. 여기에서 한 번 더 로그인하면 Apple Watch가 자체 로그인을 얻어 Wi-Fi나 셀룰러로 계속 메일을 확인할 수 있습니다. 로그인 정보는 Apple Watch로 바로 전송되며, 이 iPhone에 보관되거나 다른 곳으로 전송되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanpa ini, Watch anda menggunakan daftar masuk Fastmail iPhone anda, yang bertahan kira-kira sejam sebaik iPhone anda di luar jangkauan. Daftar masuk sekali lagi di sini dan Watch mendapat daftar masuknya sendiri, jadi ia terus menyemak mel melalui Wi-Fi atau isyarat mudah alih. Ia terus ke Watch anda; tiada apa-apa disimpan pada iPhone ini atau dihantar ke tempat lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Uten dette bruker Watch iPhonens Fastmail-pålogging, som varer omtrent en time når iPhonen er utenfor rekkevidde. Logg på én gang til her, så får Watch sin egen pålogging og fortsetter å sjekke e-post over Wi-Fi eller mobilnett. Den går rett til Watch; ingenting lagres på denne iPhonen eller sendes noe annet sted."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zonder dit gebruikt je Watch de Fastmail-inlog van je iPhone, die ongeveer een uur werkt zodra je iPhone buiten bereik is. Log hier nog één keer in en de Watch krijgt een eigen inlog, zodat hij mail blijft controleren via wifi of mobiel netwerk. Die gaat rechtstreeks naar je Watch; er wordt niets op deze iPhone bewaard of ergens anders naartoe gestuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez tego Watch używa logowania Fastmail z iPhone’a, które działa około godziny, gdy iPhone jest poza zasięgiem. Zaloguj się tu jeszcze raz, a Watch dostanie własne logowanie i będzie sprawdzać pocztę przez Wi-Fi lub sieć komórkową. Trafia ono prosto do Watcha; nic nie jest przechowywane na tym iPhonie ani wysyłane gdzie indziej."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Sem isto, seu Watch usa o login do Fastmail do iPhone, que dura cerca de uma hora quando o iPhone está fora de alcance. Entre mais uma vez aqui e o Watch ganha um login próprio, para continuar verificando e-mails por Wi-Fi ou rede celular. Ele vai direto para o seu Watch; nada fica guardado neste iPhone nem é enviado para outro lugar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fără asta, Watch folosește autentificarea Fastmail a iPhone-ului, care ține cam o oră după ce iPhone-ul nu mai e în apropiere. Autentifică-te încă o dată aici și Watch primește propria autentificare, așa că verifică în continuare e-mailurile prin Wi-Fi sau rețea mobilă. Ajunge direct pe Watch; nimic nu e păstrat pe acest iPhone și nici trimis altundeva."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Без этого Watch использует вход Fastmail с iPhone, который действует около часа, когда iPhone вне досягаемости. Войдите ещё раз здесь, и у Watch будет собственный вход, чтобы проверять почту по Wi-Fi или сотовой сети. Он передаётся прямо на Watch; на iPhone ничего не хранится и никуда больше не отправляется."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bez tohto používajú hodinky Watch prihlásenie k Fastmailu z iPhonu, ktoré vydrží asi hodinu, keď je iPhone mimo dosahu. Prihláste sa tu ešte raz a Watch dostanú vlastné prihlásenie, takže budú ďalej kontrolovať poštu cez Wi-Fi alebo mobilnú sieť. Ide priamo do Watch; nič sa neukladá na tomto iPhone ani neposiela inam."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Без овога, Watch користи Fastmail пријаву са iPhone-а, која траје око сат времена када је iPhone ван домета. Пријавите се још једном овде и Watch добија сопствену пријаву, па наставља да проверава пошту преко Wi-Fi или мобилне мреже. Иде директно на Watch; ништа се не чува на овом iPhone-у нити шаље негде другде."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Utan det här använder din Watch iPhonens Fastmail-inloggning, som räcker ungefär en timme när iPhone är utom räckhåll. Logga in en gång till här så får Watch en egen inloggning och fortsätter hämta post via Wi-Fi eller mobilnät. Den går direkt till din Watch; inget sparas på den här iPhonen eller skickas någon annanstans."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bila hii, Watch yako hutumia kuingia kwa Fastmail kwa iPhone yako, ambako hudumu takriban saa moja iPhone yako ikiwa mbali. Ingia mara moja zaidi hapa na Watch itapata kuingia kwake yenyewe, ili iendelee kukagua barua kupitia Wi-Fi au mtandao wa simu. Huenda moja kwa moja kwenye Watch yako; hakuna kinachohifadhiwa kwenye iPhone hii au kutumwa mahali pengine."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఇది లేకుండా, మీ Watch మీ iPhone యొక్క Fastmail సైన్ ఇన్‌ను ఉపయోగిస్తుంది, మీ iPhone అందుబాటులో లేనప్పుడు అది దాదాపు ఒక గంట ఉంటుంది. ఇక్కడ మరోసారి సైన్ ఇన్ చేస్తే Watchకు సొంత సైన్ ఇన్ వస్తుంది, కాబట్టి అది Wi-Fi లేదా మొబైల్ సిగ్నల్ ద్వారా మెయిల్ చెక్ చేస్తూనే ఉంటుంది. ఇది నేరుగా మీ Watchకు వెళ్తుంది; ఈ iPhoneలో ఏమీ ఉంచబడదు, ఇంకెక్కడికీ పంపబడదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หากไม่ตั้งค่านี้ Apple Watch จะใช้การลงชื่อเข้า Fastmail ของ iPhone ซึ่งใช้ได้ประมาณหนึ่งชั่วโมงเมื่อ iPhone อยู่นอกระยะ ลงชื่อเข้าอีกครั้งที่นี่แล้ว Apple Watch จะมีการลงชื่อเข้าของตัวเอง จึงตรวจหาอีเมลต่อได้ผ่าน Wi-Fi หรือเครือข่ายเซลลูลาร์ ข้อมูลนี้ส่งตรงไปยัง Apple Watch โดยไม่มีสิ่งใดเก็บไว้บน iPhone เครื่องนี้หรือส่งไปที่อื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu olmadan Watch'unuz iPhone'unuzun Fastmail girişini kullanır; bu giriş iPhone'unuz erişim dışına çıktıktan sonra yaklaşık bir saat sürer. Burada bir kez daha giriş yapın, Watch kendi girişini alsın ve Wi-Fi veya hücresel ağ üzerinden postaları denetlemeye devam etsin. Doğrudan Watch'unuza gider; bu iPhone'da hiçbir şey saklanmaz veya başka bir yere gönderilmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Без цього Watch використовує вхід Fastmail з iPhone, який діє близько години, коли iPhone поза зоною досяжності. Увійдіть тут ще раз, і Watch матиме власний вхід, щоб перевіряти пошту через Wi-Fi або мобільну мережу. Він передається просто на Watch; на iPhone нічого не зберігається й нікуди більше не надсилається."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس کے بغیر، آپ کی Watch آپ کے iPhone کا Fastmail سائن ان استعمال کرتی ہے، جو iPhone کے پہنچ سے باہر ہونے کے بعد تقریباً ایک گھنٹہ چلتا ہے۔ یہاں ایک بار پھر سائن ان کریں تو Watch کو اپنا سائن ان مل جاتا ہے، اور وہ Wi-Fi یا موبائل سگنل پر میل چیک کرتی رہتی ہے۔ یہ سیدھا آپ کی Watch پر جاتا ہے؛ اس iPhone پر کچھ نہیں رکھا جاتا اور نہ کہیں اور بھیجا جاتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nếu không có mục này, Watch dùng phiên đăng nhập Fastmail của iPhone, chỉ kéo dài khoảng một giờ khi iPhone ở ngoài tầm. Đăng nhập thêm một lần ở đây để Watch có phiên đăng nhập riêng, nhờ đó tiếp tục kiểm tra thư qua Wi-Fi hoặc mạng di động. Thông tin được gửi thẳng tới Watch; không có gì được lưu trên iPhone này hay gửi đi nơi khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "不进行此设置时,Apple Watch 使用 iPhone 的 Fastmail 登录,当 iPhone 不在附近时约可维持一小时。在此再登录一次,Apple Watch 就会获得自己的登录,可通过无线局域网或蜂窝网络持续检查邮件。登录信息直接发送到 Apple Watch,不会保留在此 iPhone 上,也不会发送到其他任何地方。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "若不設定此項,Apple Watch 會使用 iPhone 的 Fastmail 登入,當 iPhone 不在範圍內時約可維持一小時。在這裡再登入一次,Apple Watch 就會取得自己的登入,可透過 Wi-Fi 或行動網路持續檢查郵件。登入資訊會直接傳送到 Apple Watch,不會保留在此 iPhone 上,也不會傳送到其他地方。"
          }
        }
      }
    },
