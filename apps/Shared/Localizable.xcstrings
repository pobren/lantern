    "Apple didn't give this device a push address. Check notifications are on for JMAP Connect in the Settings app.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple het nie vir hierdie toestel 'n push-adres gegee nie. Kyk of kennisgewings vir JMAP Connect aan is in die Instellings-app."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم تمنح Apple هذا الجهاز عنوان إشعارات. تأكد من تشغيل الإشعارات لـ JMAP Connect في تطبيق الإعدادات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple এই ডিভাইসকে কোনো পুশ ঠিকানা দেয়নি। সেটিংস অ্যাপে JMAP Connect-এর বিজ্ঞপ্তি চালু আছে কিনা দেখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no ha donat cap adreça push a aquest dispositiu. Comprova que les notificacions de JMAP Connect estiguin activades a l'app Configuració."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple tomuto zařízení nepřidělil adresu pro push. Zkontrolujte, že jsou pro JMAP Connect zapnutá oznámení v aplikaci Nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple gav ikke denne enhed en push-adresse. Tjek, at notifikationer er slået til for JMAP Connect i appen Indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple hat diesem Gerät keine Push-Adresse gegeben. Prüfe in der App „Einstellungen“, ob Mitteilungen für JMAP Connect aktiviert sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Apple δεν έδωσε διεύθυνση push σε αυτή τη συσκευή. Ελέγξτε ότι οι γνωστοποιήσεις είναι ενεργές για το JMAP Connect στην εφαρμογή Ρυθμίσεις."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple no ha dado a este dispositivo una dirección push. Comprueba en la app Ajustes que las notificaciones están activadas para JMAP Connect."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple به این دستگاه نشانی اعلان نداد. بررسی کنید اعلان‌های JMAP Connect در برنامه تنظیمات روشن باشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ei antanut tälle laitteelle push-osoitetta. Tarkista Asetukset-apista, että JMAP Connectin ilmoitukset ovat päällä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi binigyan ng Apple ng push address ang device na ito. Tingnan kung naka-on ang notifications para sa JMAP Connect sa Settings app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple n’a pas donné d’adresse push à cet appareil. Vérifiez que les notifications sont activées pour JMAP Connect dans l’app Réglages."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple לא נתנה למכשיר הזה כתובת לדחיפת התראות. בדוק שהעדכונים מופעלים עבור JMAP Connect ביישום ״הגדרות״."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ने इस डिवाइस को पुश पता नहीं दिया। सेटिंग्ज़ ऐप में देखें कि JMAP Connect के लिए सूचनाएँ चालू हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ovom uređaju nije dao push adresu. Provjerite jesu li obavijesti za JMAP Connect uključene u aplikaciji Postavke."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Apple nem adott push-címet ennek az eszköznek. Ellenőrizze a Beállítások appban, hogy a JMAP Connect értesítései be vannak-e kapcsolva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple tidak memberikan alamat push untuk perangkat ini. Periksa apakah notifikasi JMAP Connect sudah aktif di app Pengaturan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple non ha fornito un indirizzo push a questo dispositivo. Controlla che le notifiche siano attive per JMAP Connect nell’app Impostazioni."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Appleがこのデバイスにプッシュアドレスを割り当てませんでした。設定AppでJMAP Connectの通知がオンになっているか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple이 이 기기에 푸시 주소를 제공하지 않았습니다. 설정 앱에서 JMAP Connect의 알림이 켜져 있는지 확인하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple tidak memberikan alamat tolak kepada peranti ini. Pastikan pemberitahuan dihidupkan untuk JMAP Connect dalam app Seting."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ga ikke denne enheten en push-adresse. Sjekk at varslinger er på for JMAP Connect i Innstillinger-appen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple heeft dit apparaat geen pushadres gegeven. Controleer in de Instellingen-app of meldingen aanstaan voor JMAP Connect."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple nie przydzieliło temu urządzeniu adresu push. Sprawdź, czy powiadomienia dla JMAP Connect są włączone w aplikacji Ustawienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A Apple não deu um endereço de push a este dispositivo. Verifique se as notificações do JMAP Connect estão ativadas no app Ajustes."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple nu a oferit acestui dispozitiv o adresă push. Verifică dacă notificările sunt activate pentru JMAP Connect în aplicația Configurări."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple не выдала этому устройству push-адрес. Проверьте, что уведомления для JMAP Connect включены в приложении «Настройки»."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple nepridelil tomuto zariadeniu adresu pre push. Skontrolujte, či sú pre JMAP Connect zapnuté hlásenia v apke Nastavenia."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple није дао push адресу овом уређају. Проверите да ли су обавештења за JMAP Connect укључена у апликацији Подешавања."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple gav inte enheten någon push-adress. Kontrollera att notiser är på för JMAP Connect i appen Inställningar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple haikupa kifaa hiki anwani ya push. Hakikisha arifa zimewashwa kwa JMAP Connect katika programu ya Mipangilio."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ఈ పరికరానికి పుష్ అడ్రస్ ఇవ్వలేదు. సెట్టింగ్‌లు యాప్‌లో JMAP Connect కోసం నోటిఫికేషన్‌లు ఆన్‌లో ఉన్నాయో చూడండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple ไม่ได้ให้ที่อยู่สำหรับพุชแก่อุปกรณ์นี้ ตรวจสอบว่าเปิดการแจ้งเตือนสำหรับ JMAP Connect ในแอปการตั้งค่าแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple bu aygıta bir anlık bildirim adresi vermedi. Ayarlar uygulamasında JMAP Connect bildirimlerinin açık olduğunu denetleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple не надала цьому пристрою push-адресу. Перевірте, чи ввімкнено сповіщення для JMAP Connect у Параметрах."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple نے اس ڈیوائس کو پُش پتہ نہیں دیا۔ سیٹنگز ایپ میں چیک کریں کہ JMAP Connect کے لیے اطلاعات آن ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple không cấp địa chỉ đẩy cho thiết bị này. Hãy kiểm tra thông báo cho JMAP Connect đã bật trong ứng dụng Cài đặt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 未给此设备分配推送地址。请在“设置”App 中检查 JMAP Connect 的通知是否已打开。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple 沒有提供推播位址給此裝置。請在「設定」App 中確認 JMAP Connect 的通知已開啟。"
          }
        }
      }
    },
