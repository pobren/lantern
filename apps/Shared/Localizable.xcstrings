    "That sign in didn't come back from Fastmail as expected, so it wasn't used. Please try again.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Daardie aanmelding het nie soos verwag van Fastmail teruggekom nie, so dit is nie gebruik nie. Probeer asseblief weer."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يعد تسجيل الدخول هذا من Fastmail كما هو متوقع، لذا لم يُستخدم. يُرجى المحاولة مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সেই সাইন ইন Fastmail থেকে প্রত্যাশামতো ফেরেনি, তাই ব্যবহার করা হয়নি। আবার চেষ্টা করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "L'inici de sessió no ha tornat de Fastmail com s'esperava, així que no s'ha fet servir. Torna-ho a provar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přihlášení se z Fastmailu nevrátilo podle očekávání, a tak nebylo použito. Zkuste to prosím znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Det login kom ikke tilbage fra Fastmail som forventet, så det blev ikke brugt. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anmeldung kam nicht wie erwartet von Fastmail zurück und wurde daher nicht verwendet. Bitte versuche es erneut."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η σύνδεση δεν επέστρεψε από το Fastmail όπως αναμενόταν, οπότε δεν χρησιμοποιήθηκε. Δοκιμάστε ξανά."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ese inicio de sesión no volvió de Fastmail como se esperaba, así que no se ha usado. Inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آن ورود آن‌طور که انتظار می‌رفت از Fastmail برنگشت، پس استفاده نشد. لطفاً دوباره امتحان کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kirjautuminen ei palannut Fastmailista odotetusti, joten sitä ei käytetty. Yritä uudelleen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi bumalik nang tama mula sa Fastmail ang pag-sign in na iyon, kaya hindi ito ginamit. Pakisubukan ulit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette connexion n’est pas revenue de Fastmail comme prévu, elle n’a donc pas été utilisée. Veuillez réessayer."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההתחברות לא חזרה מ-Fastmail כמצופה, ולכן לא נעשה בה שימוש. נסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह साइन इन Fastmail से उम्मीद के मुताबिक वापस नहीं आया, इसलिए इस्तेमाल नहीं किया गया। कृपया फिर कोशिश करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ta se prijava nije vratila iz Fastmaila kako je očekivano, pa nije upotrijebljena. Pokušajte ponovno."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A bejelentkezés nem a várt módon érkezett vissza a Fastmailtől, ezért nem használtuk. Próbálja újra."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Proses masuk itu tidak kembali dari Fastmail seperti seharusnya, jadi tidak digunakan. Silakan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Quell’accesso non è tornato da Fastmail come previsto, quindi non è stato usato. Riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmailからのサインインが想定どおりに戻らなかったため、使用されませんでした。もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail에서 로그인이 예상대로 돌아오지 않아 사용되지 않았습니다. 다시 시도하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Daftar masuk itu tidak kembali daripada Fastmail seperti yang dijangka, jadi ia tidak digunakan. Sila cuba lagi."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Påloggingen kom ikke tilbake fra Fastmail som ventet, så den ble ikke brukt. Prøv igjen."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Die inlog kwam niet terug van Fastmail zoals verwacht, dus hij is niet gebruikt. Probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To logowanie nie wróciło z Fastmail zgodnie z oczekiwaniami, więc nie zostało użyte. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esse login não voltou do Fastmail como esperado, então não foi usado. Tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Autentificarea nu a revenit de la Fastmail cum era de așteptat, deci nu a fost folosită. Încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вход через Fastmail завершился не так, как ожидалось, поэтому не использован. Повторите попытку."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Prihlásenie sa z Fastmailu nevrátilo podľa očakávania, a tak nebolo použité. Skúste to znova."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "То пријављивање се није вратило са Fastmail-а како је очекивано, па није коришћено. Покушајте поново."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Inloggningen kom inte tillbaka från Fastmail som väntat, så den användes inte. Försök igen."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuingia huko hakukurudi kutoka Fastmail kama ilivyotarajiwa, kwa hivyo hakukutumika. Tafadhali jaribu tena."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆ సైన్ ఇన్ Fastmail నుండి ఆశించినట్లు తిరిగి రాలేదు, కాబట్టి ఉపయోగించలేదు. దయచేసి మళ్లీ ప్రయత్నించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การลงชื่อเข้านั้นไม่ได้กลับมาจาก Fastmail ตามที่คาดไว้ จึงไม่ได้นำมาใช้ โปรดลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu giriş Fastmail'den beklendiği gibi dönmedi, bu yüzden kullanılmadı. Lütfen yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вхід через Fastmail завершився не так, як очікувалося, тож його не використано. Спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ سائن ان Fastmail سے توقع کے مطابق واپس نہیں آیا، اس لیے استعمال نہیں ہوا۔ براہ کرم دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lần đăng nhập đó không trả về từ Fastmail như mong đợi nên không được dùng. Vui lòng thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "来自 Fastmail 的登录结果与预期不符,因此未被使用。请重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "來自 Fastmail 的登入結果與預期不符,因此未被使用。請再試一次。"
          }
        }
      }
    },
