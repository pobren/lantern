    "Fastmail signed this account out. Sign in again to carry on.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail het hierdie rekening afgemeld. Meld weer aan om voort te gaan."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سجّل Fastmail الخروج من هذا الحساب. سجّل الدخول مجددًا للمتابعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail এই অ্যাকাউন্ট থেকে সাইন আউট করেছে। চালিয়ে যেতে আবার সাইন ইন করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail ha tancat la sessió d'aquest compte. Torna a iniciar sessió per continuar."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail tento účet odhlásil. Pokračujte opětovným přihlášením."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail loggede denne konto ud. Log ind igen for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail hat diesen Account abgemeldet. Melde dich erneut an, um fortzufahren."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Το Fastmail αποσύνδεσε αυτόν τον λογαριασμό. Συνδεθείτε ξανά για να συνεχίσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail ha cerrado la sesión de esta cuenta. Vuelve a iniciar sesión para continuar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail این حساب را خارج کرد. برای ادامه دوباره وارد شوید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
