    "a working key: it was deleted in %@, so make a new one": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n werkende sleutel: dit is in %@ geskrap, so maak 'n nuwe een"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "مفتاح صالح: حُذف في %@، لذا أنشئ مفتاحًا جديدًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একটি কাজের কী: এটি %@-এ মুছে ফেলা হয়েছে, তাই নতুন একটি বানান"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "una clau vàlida: es va eliminar a %@, així que crea'n una de nova"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "funkční klíč: byl smazán v %@, vytvořte nový"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "en gyldig nøgle: den blev slettet i %@, så opret en ny"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "ein funktionierender Schlüssel: Er wurde in %@ gelöscht, erstelle also einen neuen"
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "ένα έγκυρο κλειδί: διαγράφηκε στο %@, οπότε φτιάξτε νέο"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "una clave válida: se eliminó en %@, así que crea una nueva"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید معتبر: در %@ حذف شده، پس کلید جدیدی بسازید"
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "toimiva avain: se poistettiin palvelussa %@, joten luo uusi"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "isang gumaganang key: na-delete ito sa %@, kaya gumawa ng bago"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "une clé valide : elle a été supprimée dans %@, créez-en une nouvelle"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מפתח תקף: הוא נמחק ב-%@, אז צור חדש"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "काम करने वाली की: इसे %@ में डिलीट किया गया, इसलिए नई बनाएँ"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "ispravan ključ: obrisan je u %@, pa izradite novi"
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "egy működő kulcsot: törölve lett itt: %@, ezért hozzon létre újat"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "kunci yang berfungsi: kunci dihapus di %@, jadi buat yang baru"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "una chiave valida: è stata eliminata in %@, quindi creane una nuova"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なキー(%@で削除されたため、新しいキーを作成してください)"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "유효한 키(%@에서 삭제되었으니 새 키를 만드십시오)"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "kunci yang berfungsi: ia telah dipadam dalam %@, jadi buat yang baharu"
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "en gyldig nøkkel: den ble slettet i %@, så lag en ny"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "een werkende sleutel: die is verwijderd in %@, dus maak een nieuwe"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "działający klucz: został usunięty w %@, więc utwórz nowy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "uma chave válida: ela foi apagada no %@, então crie uma nova"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "o cheie validă: a fost ștearsă în %@, deci creează una nouă"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "рабочий ключ: он удалён в %@, создайте новый"
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "funkčný kľúč: bol vymazaný v %@, vytvorte nový"
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "важећи кључ: избрисан је у %@, па направите нови"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "en fungerande nyckel: den raderades i %@, så skapa en ny"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "ufunguo unaofanya kazi: ulifutwa katika %@, kwa hivyo tengeneza mpya"
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పనిచేసే కీ: ఇది %@లో తొలగించబడింది, కాబట్టి కొత్తది తయారు చేయండి"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คีย์ที่ใช้งานได้: คีย์ถูกลบใน %@ ให้สร้างคีย์ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "çalışan bir anahtar: %@ içinde silindi, yeni bir tane oluşturun"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "робочий ключ: його видалено в %@, створіть новий"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک کام کرنے والی کلید: یہ %@ میں ڈیلیٹ کی گئی، اس لیے نئی بنائیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "khóa còn dùng được: khóa đã bị xóa trong %@, hãy tạo khóa mới"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有效的密钥:它已在%@中删除,请创建新密钥"
          }
