        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@はまだ開いたことがないため、接続が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@은(는) 이전에 연 적이 없으므로 연결이 필요합니다."
