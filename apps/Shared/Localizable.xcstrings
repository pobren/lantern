    "Pictures and sender photos in the emails you open.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Prente en senderfoto's in die e-posse wat jy oopmaak."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصور وصور المرسلين في الرسائل التي تفتحها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার খোলা ইমেলের ছবি ও প্রেরকদের ছবি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Imatges i fotos dels remitents als correus que obres."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrázky a fotky odesílatelů ve zprávách, které otevřete."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Billeder og afsenderfotos i de e-mails, du åbner."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder und Absenderfotos in den E-Mails, die du öffnest."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Εικόνες και φωτογραφίες αποστολέων στα email που ανοίγετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Imágenes y fotos de remitentes en los correos que abres."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تصاویر و عکس فرستندگان در ایمیل‌هایی که باز می‌کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuvat ja lähettäjien kuvat avaamissasi viesteissä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga larawan at larawan ng sender sa mga email na binubuksan mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les images et photos d’expéditeurs dans les e-mails que vous ouvrez."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תמונות ותמונות שולחים בהודעות שאתה פותח."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके खोले गए ईमेल में तस्वीरें और प्रेषकों की फ़ोटो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Slike i fotografije pošiljatelja u e-porukama koje otvorite."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Képek és feladófotók a megnyitott e-mailekben."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar dan foto pengirim di email yang Anda buka."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Immagini e foto dei mittenti nelle email che apri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "開いたメールの画像と差出人の写真。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "열어 본 이메일의 사진과 발신자 사진."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gambar dan foto penghantar dalam e-mel yang anda buka."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder og avsenderbilder i e-postene du åpner."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afbeeldingen en afzenderfoto’s in de e-mails die je opent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrazki i zdjęcia nadawców w otwieranych wiadomościach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Imagens e fotos de remetentes nos e-mails que você abre."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Imaginile și pozele expeditorilor din e-mailurile pe care le deschizi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Изображения и фото отправителей в открываемых письмах."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Obrázky a fotky odosielateľov v správach, ktoré otvoríte."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Слике и фотографије пошиљалаца у имејловима које отварате."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Bilder och avsändarfoton i mejl du öppnar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Picha na picha za watumaji katika barua pepe unazofungua."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు తెరిచే ఈమెయిల్‌లలో చిత్రాలు మరియు పంపినవారి ఫోటోలు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รูปภาพและรูปผู้ส่งในอีเมลที่คุณเปิด"
