    "No contacts yet. Press + to add one.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Nog geen kontakte nie. Druk + om een by te voeg."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد جهات اتصال بعد. اضغط على + لإضافة واحدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এখনো কোনো পরিচিতি নেই। যোগ করতে + চাপুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Encara no hi ha contactes. Prem + per afegir-ne un."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím žádné kontakty. Přidejte je pomocí +."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen kontakter endnu. Tryk på + for at tilføje en."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine Kontakte. Tippe auf +, um einen hinzuzufügen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν υπάρχουν επαφές ακόμα. Πατήστε + για προσθήκη."
          }
        },
