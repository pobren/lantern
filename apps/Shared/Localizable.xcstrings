      }
    },
    "Takes out the hidden pictures that tell senders when and where you opened their email, and says how many were blocked. Done on this device.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Haal die versteekte prente uit wat senders vertel wanneer en waar jy hul e-pos oopgemaak het, en sê hoeveel geblokkeer is. Op hierdie toestel gedoen."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يزيل الصور المخفية التي تُعلم المرسلين متى وأين فتحت رسائلهم، ويخبرك كم منها حُظر. يتم ذلك على هذا الجهاز."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লুকানো ছবিগুলো সরিয়ে দেয় যা প্রেরককে জানায় আপনি কখন ও কোথায় তাদের ইমেল খুলেছেন, আর কতগুলো ব্লক হয়েছে তা জানায়। এই ডিভাইসেই হয়।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Treu les imatges amagades que diuen als remitents quan i on has obert el seu correu, i indica quantes s'han bloquejat. Es fa en aquest dispositiu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraní skryté obrázky, které odesílatelům prozradí, kdy a kde jste jejich zprávu otevřeli, a ukáže, kolik jich bylo zablokováno. Probíhá na tomto zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner de skjulte billeder, der fortæller afsendere, hvornår og hvor du åbnede deres e-mail, og viser, hvor mange der blev blokeret. Sker på denne enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernt die versteckten Bilder, die Absendern verraten, wann und wo du ihre E-Mail geöffnet hast, und zeigt, wie viele blockiert wurden. Passiert auf diesem Gerät."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αφαιρεί τις κρυφές εικόνες που λένε στους αποστολείς πότε και πού ανοίξατε το email τους και δείχνει πόσες φράχτηκαν. Γίνεται σε αυτή τη συσκευή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita las imágenes ocultas que dicen a los remitentes cuándo y dónde abriste su correo, e indica cuántas se han bloqueado. Se hace en este dispositivo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تصاویر پنهانی را که به فرستندگان می‌گویند کی و کجا ایمیلشان را باز کرده‌اید حذف می‌کند و می‌گوید چند تا مسدود شد. روی همین دستگاه انجام می‌شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poistaa piilotetut kuvat, jotka kertovat lähettäjille, milloin ja missä avasit heidän viestinsä, ja kertoo, montako estettiin. Tehdään tällä laitteella."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Inaalis ang mga nakatagong larawan na nagsasabi sa mga sender kung kailan at saan mo binuksan ang email nila, at sinasabi kung ilan ang na-block. Ginagawa sa device na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retire les images cachées qui indiquent aux expéditeurs quand et où vous avez ouvert leur e-mail, et indique combien ont été bloquées. Fait sur cet appareil."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מסיר את התמונות הנסתרות שמספרות לשולחים מתי ואיפה פתחת את ההודעה שלהם, ומציין כמה נחסמו. נעשה במכשיר הזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उन छिपी तस्वीरों को हटाता है जो प्रेषकों को बताती हैं कि आपने उनका ईमेल कब और कहाँ खोला, और बताता है कि कितनी ब्लॉक हुईं। इसी डिवाइस पर होता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uklanja skrivene slike koje pošiljateljima otkrivaju kad i gdje ste otvorili njihovu e-poruku i pokazuje koliko ih je blokirano. Radi se na ovom uređaju."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Eltávolítja a rejtett képeket, amelyek elárulják a feladónak, mikor és hol nyitotta meg a levelet, és jelzi, hányat tiltott le. Mindez ezen az eszközön."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghapus gambar tersembunyi yang memberi tahu pengirim kapan dan di mana Anda membuka email mereka, dan menunjukkan berapa yang diblokir. Dilakukan di perangkat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuove le immagini nascoste che dicono ai mittenti quando e dove hai aperto la loro email, e indica quante ne sono state bloccate. Tutto su questo dispositivo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メールを開いた時刻や場所を差出人に知らせる非表示の画像を取り除き、ブロックした数を表示します。処理はこのデバイス上で行われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이메일을 언제 어디서 열었는지 발신자에게 알리는 숨겨진 사진을 제거하고 차단된 개수를 알려줍니다. 이 기기에서 처리됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mengeluarkan gambar tersembunyi yang memberitahu penghantar bila dan di mana anda membuka e-mel mereka, dan memberitahu berapa banyak yang disekat. Dilakukan pada peranti ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fjerner de skjulte bildene som forteller avsendere når og hvor du åpnet e-posten deres, og viser hvor mange som ble blokkert. Gjøres på denne enheten."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haalt de verborgen afbeeldingen weg die afzenders vertellen wanneer en waar je hun e-mail hebt geopend, en laat zien hoeveel er zijn geblokkeerd. Gebeurt op dit apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuwa ukryte obrazki, które mówią nadawcom, kiedy i gdzie otworzyłeś ich wiadomość, i pokazuje, ile zablokowano. Działa na tym urządzeniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remove as imagens ocultas que contam aos remetentes quando e onde você abriu o e-mail deles, e diz quantas foram bloqueadas. Feito neste dispositivo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elimină imaginile ascunse care le spun expeditorilor când și unde le-ai deschis e-mailul și arată câte au fost blocate. Totul pe acest dispozitiv."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет скрытые изображения, по которым отправители узнают, когда и где вы открыли письмо, и показывает, сколько заблокировано. Выполняется на этом устройстве."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstráni skryté obrázky, ktoré odosielateľom prezradia, kedy a kde ste ich správu otvorili, a ukáže, koľko ich bolo zablokovaných. Prebieha na tomto zariadení."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Уклања скривене слике које пошиљаоцима откривају када и где сте отворили њихов имејл и приказује колико их је блокирано. Ради се на овом уређају."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tar bort de dolda bilderna som berättar för avsändare när och var du öppnade deras mejl, och visar hur många som blockerades. Görs på den här enheten."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huondoa picha zilizofichwa zinazowaambia watumaji lini na wapi ulifungua barua pepe yao, na husema ngapi zimezuiwa. Hufanywa kwenye kifaa hiki."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు ఈమెయిల్‌ను ఎప్పుడు, ఎక్కడ తెరిచారో పంపినవారికి చెప్పే దాచిన చిత్రాలను తీసివేస్తుంది, ఎన్ని బ్లాక్ అయ్యాయో చెబుతుంది. ఈ పరికరంలోనే జరుగుతుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เอารูปภาพที่ซ่อนอยู่ซึ่งบอกผู้ส่งว่าคุณเปิดอีเมลเมื่อใดและที่ไหนออก และแจ้งจำนวนที่บล็อก ทำงานบนอุปกรณ์นี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göndericilere e-postalarını ne zaman ve nerede açtığınızı bildiren gizli resimleri çıkarır ve kaçının engellendiğini söyler. Bu aygıtta yapılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вилучає приховані зображення, за якими відправники дізнаються, коли й де ви відкрили лист, і показує, скільки заблоковано. Виконується на цьому пристрої."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وہ چھپی ہوئی تصاویر ہٹاتا ہے جو بھیجنے والوں کو بتاتی ہیں کہ آپ نے ان کی ای میل کب اور کہاں کھولی، اور بتاتا ہے کہ کتنی بلاک ہوئیں۔ یہ اسی ڈیوائس پر ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Loại bỏ các hình ảnh ẩn cho người gửi biết bạn mở email khi nào và ở đâu, kèm số lượng đã chặn. Thực hiện trên thiết bị này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "移除那些告诉发件人你在何时何地打开邮件的隐藏图片,并显示阻止的数量。在此设备上完成。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "移除會告訴寄件人你何時、在哪裡打開郵件的隱藏圖片,並顯示阻擋的數量。在此裝置上完成。"
          }
        }
      }
    },
    "Tap one on your Apple Watch under Reply to send it straight away. Swipe left to remove one.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik een op jou Apple Watch onder Antwoord om dit dadelik te stuur. Swiep links om een te verwyder."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على أحدها في Apple Watch تحت رد لإرساله فورًا. اسحب لليسار لإزالة أحدها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সাথে সাথে পাঠাতে আপনার Apple Watch-এ উত্তর দিন-এর নিচে একটিতে ট্যাপ করুন। সরাতে বাঁয়ে সোয়াইপ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca'n una a l'Apple Watch a Respondre per enviar-la a l'instant. Llisca cap a l'esquerra per eliminar-ne una."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na odpověď na Apple Watch v sekci Odpovědět ji hned odešlete. Přejetím doleva ji odstraníte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på et på dit Apple Watch under Svar for at sende det med det samme. Skub til venstre for at fjerne et."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Tippe auf deiner Apple Watch unter „Antworten“ auf eine, um sie sofort zu senden. Streiche nach links, um eine zu entfernen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αγγίξτε μία στο Apple Watch, στην Απάντηση, για να σταλεί αμέσως. Σαρώστε αριστερά για αφαίρεση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una en tu Apple Watch, en Responder, para enviarla al momento. Desliza a la izquierda para quitar una."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در Apple Watch زیر پاسخ روی یکی بزنید تا فوراً ارسال شود. برای برداشتن، به چپ بکشید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Napauta jotain Apple Watchissa kohdassa Vastaa, niin se lähtee heti. Poista pyyhkäisemällä vasemmalle."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-tap ang isa sa Apple Watch mo sa ilalim ng Sumagot para ipadala ito agad. Mag-swipe pakaliwa para mag-alis."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez-en une sur votre Apple Watch sous Répondre pour l’envoyer aussitôt. Balayez vers la gauche pour en retirer une."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקש על אחת מהן ב-Apple Watch תחת ״השב״ כדי לשלוח אותה מיד. החלק שמאלה כדי להסיר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे तुरंत भेजने के लिए अपनी Apple Watch पर जवाब दें के नीचे किसी एक पर टैप करें। हटाने के लिए बाईं ओर स्वाइप करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodirnite jedan na Apple Watchu pod Odgovori da ga odmah pošaljete. Povucite ulijevo za uklanjanje."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Koppintson egyre az Apple Watchon a Válasz alatt, és azonnal elküldi. Balra legyintve eltávolíthatja."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk salah satu di bawah Balas di Apple Watch untuk langsung mengirimnya. Gesek ke kiri untuk menghapusnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Toccane una su Apple Watch in Rispondi per inviarla subito. Scorri a sinistra per rimuoverne una."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watchの「返信」でタップすると、すぐに送信されます。左にスワイプすると削除できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Apple Watch의 답장에서 하나를 탭하면 바로 전송됩니다. 왼쪽으로 쓸어넘기면 제거됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik satu pada Apple Watch anda di bawah Balas untuk menghantarnya serta-merta. Leret ke kiri untuk mengalih keluar satu."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Trykk på et på Apple Watch under Svar for å sende det med en gang. Sveip til venstre for å fjerne et."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik er op je Apple Watch onder Antwoord op een om het meteen te versturen. Veeg naar links om er een te verwijderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stuknij jedną na Apple Watch w sekcji Odpowiedz, aby od razu ją wysłać. Przesuń w lewo, aby usunąć."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em uma no Apple Watch em Responder para enviá-la na hora. Deslize para a esquerda para remover uma."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge unul pe Apple Watch, la Răspunde, ca să-l trimiți imediat. Glisează spre stânga ca să elimini unul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коснитесь ответа на Apple Watch в разделе «Ответить», чтобы сразу его отправить. Смахните влево, чтобы удалить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na odpoveď na Apple Watch v sekcii Odpovedať ju hneď odošlete. Potiahnutím doľava ju odstránite."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Додирните један на Apple Watch-у, под Одговори, да га одмах пошаљете. Превуците улево да уклоните један."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryck på ett på Apple Watch under Svara för att skicka det direkt. Svep åt vänster för att ta bort ett."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gusa moja kwenye Apple Watch yako chini ya Jibu ili kulituma papo hapo. Telezesha kushoto ili kuondoa moja."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "వెంటనే పంపడానికి మీ Apple Watchలో ప్రత్యుత్తరం కింద ఒకదాన్ని ట్యాప్ చేయండి. తీసివేయడానికి ఎడమకు స్వైప్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะรายการหนึ่งใต้ตอบกลับบน Apple Watch เพื่อส่งทันที ปัดไปทางซ้ายเพื่อเอาออก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hemen göndermek için Apple Watch'unuzda Yanıtla altından birine dokunun. Kaldırmak için sola kaydırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Торкніться відповіді на Apple Watch у розділі «Відповісти», щоб одразу її надіслати. Смахніть ліворуч, щоб вилучити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فوراً بھیجنے کے لیے اپنی Apple Watch پر جواب دیں کے نیچے کسی ایک کو ٹیپ کریں۔ ہٹانے کے لیے بائیں سوائپ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào một mục dưới Trả lời trên Apple Watch để gửi ngay. Vuốt sang trái để gỡ bỏ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple Watch 的“回复”下轻点一条即可立即发送。向左轻扫可移除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Apple Watch 的「回覆」下點一下即可立即傳送。向左滑動可移除。"
          }
        }
      }
    },
