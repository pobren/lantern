    "They go to the Bin, and Undo puts them back.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Hulle gaan na die Asblik, en Ontdoen sit hulle terug."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستذهب إلى سلة المهملات، والتراجع يعيدها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এগুলো ট্র্যাশে যায়, আর পূর্বাবস্থা সেগুলো ফিরিয়ে আনে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Van a la Paperera, i Desfer els torna on eren."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Půjdou do Koše a Odvolat je vrátí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "De havner i papirkurven, og Fortryd lægger dem tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie kommen in den Papierkorb, und „Widerrufen“ holt sie zurück."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Πηγαίνουν στον Κάδο και η Αναίρεση τα επαναφέρει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Van a la papelera, y Deshacer los devuelve."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به سطل زباله می‌روند و واگرد آن‌ها را برمی‌گرداند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ne siirtyvät roskakoriin, ja Kumoa palauttaa ne."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mapupunta sila sa Basurahan, at ibinabalik sila ng Undo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ils vont à la corbeille, et Annuler les remet en place."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הן יעברו לפח, ו״ביטול״ מחזיר אותן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये ट्रैश में जाते हैं, और पूर्ववत करें इन्हें वापस ले आता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Idu u Smeće, a Poništi ih vraća."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Kukába kerülnek, és a Visszavonás visszahozza őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Email tersebut masuk ke Tong Sampah, dan Urungkan akan mengembalikannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Finiscono nel Cestino e Annulla le rimette a posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ゴミ箱に移動されます。「取り消す」で元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "휴지통으로 이동되며, 실행 취소하면 되돌릴 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ia masuk ke Tong Sampah, dan Buat Asal mengembalikannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "De havner i papirkurven, og Angre legger dem tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ze gaan naar de prullenmand, en Herstel zet ze terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Trafią do Kosza, a Cofnij je przywróci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Eles vão para o Lixo, e Desfazer os traz de volta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajung în Coș, iar Anulează le readuce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Они попадут в корзину, а «Отменить» вернёт их."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pôjdu do Koša a Späť ich vráti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Иду у Отпад, а Опозови их враћа."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "De hamnar i papperskorgen, och Ångra lägger tillbaka dem."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Zinaenda kwenye Pipa la taka, na Tendua huzirudisha."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అవి ట్రాష్‌కు వెళ్తాయి, రద్దు చేయి వాటిని తిరిగి తెస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีเมลจะไปที่ถังขยะ และเลิกทำจะนำกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çöp Kutusu'na giderler, Geri Al onları geri getirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вони потраплять у смітник, а «Скасувати» поверне їх."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ ردی کی ٹوکری میں جاتی ہیں، اور کالعدم کریں انہیں واپس لے آتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng sẽ vào Thùng rác, và Hoàn tác sẽ đưa chúng trở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "它们会进入废纸篓,“撤销”可将其放回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "它們會進入垃圾桶,「還原」可將其放回。"
          }
        }
      }
    },
