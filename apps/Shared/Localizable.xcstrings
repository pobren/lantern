    "Use Move to first, then Move again repeats it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik eers Skuif na, dan herhaal Skuif weer dit."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم نقل إلى أولًا، ثم يكرره النقل مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগে এখানে সরান ব্যবহার করুন, তারপর আবার সরান সেটি আবার করবে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes servir primer Moure a, i després Tornar a moure ho repeteix."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejdřív použijte Přesunout do, pak to Přesunout znovu zopakuje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug Flyt til først, så gentager Flyt igen det."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nutze zuerst „Bewegen nach“, dann wiederholt „Erneut bewegen“ es."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε πρώτα τη Μετακίνηση σε και μετά η Ξανά μετακίνηση την επαναλαμβάνει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa primero Mover a y luego Volver a mover lo repite."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اول از انتقال به استفاده کنید، سپس انتقال دوباره آن را تکرار می‌کند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä ensin Siirrä-toimintoa, sitten Siirrä uudelleen toistaa sen."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamitin muna ang Ilipat sa, tapos uulitin ito ng Ilipat ulit."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez d’abord Déplacer vers, puis Déplacer à nouveau le répète."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמש קודם ב״העבר אל״, ואז ״העבר שוב״ חוזר על הפעולה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले इसमें मूव करें इस्तेमाल करें, फिर फिर से मूव करें उसे दोहराता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprije upotrijebite Premjesti u, a zatim ga Premjesti ponovno ponavlja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Először használja az Áthelyezés ide parancsot, majd az Áthelyezés újra megismétli."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan Pindahkan ke terlebih dahulu, lalu Pindahkan lagi akan mengulanginya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa prima Sposta in, poi Sposta di nuovo lo ripete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に「移動」を使うと、「もう一度移動」で同じ操作を繰り返せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 이동을 사용하면 다시 이동으로 반복할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan Alihkan ke dahulu, kemudian Alihkan lagi mengulanginya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk Flytt til først, så gjentar Flytt igjen det."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik eerst Verplaats naar, daarna herhaalt Verplaats opnieuw het."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw użyj Przenieś do, a Przenieś ponownie to powtórzy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Mover para primeiro; depois, Mover de novo repete a ação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește mai întâi Mută în, apoi Mută din nou repetă acțiunea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала используйте «Переместить в», тогда «Переместить снова» повторит действие."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Najprv použite Presunúť do, potom to Presunúť znova zopakuje."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Прво користите Премести у, а затим га Премести поново понавља."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd Flytta till först, sedan upprepar Flytta igen det."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumia Hamisha hadi kwanza, kisha Hamisha tena huirudia."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ముందుగా ఇక్కడికి తరలించు ఉపయోగించండి, ఆ తర్వాత మళ్లీ తరలించు దాన్ని పునరావృతం చేస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ย้ายไปที่ก่อน แล้วย้ายอีกครั้งจะทำซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce Taşı'yı kullanın, ardından Yeniden taşı bunu tekrarlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу скористайтеся «Перемістити в», тоді «Перемістити знову» повторить дію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے منتقل کریں استعمال کریں، پھر دوبارہ منتقل کریں اسے دہراتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy dùng Di chuyển tới trước, sau đó Di chuyển lại sẽ lặp lại thao tác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "先使用“移到”,之后“再次移动”会重复该操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "先使用「搬移到」,之後「再次搬移」就會重複該操作。"
          }
        }
      }
    },
