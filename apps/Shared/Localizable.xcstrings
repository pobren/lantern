          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בחר אילו חשבונות דואר JMAP Connect יציג כשמצב הריכוז הזה פועל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "चुनें कि यह फ़ोकस चालू होने पर JMAP Connect कौन से मेल खाते दिखाए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odaberite koje račune e-pošte JMAP Connect prikazuje dok je ovaj Fokus uključen."
          }
        },
        "hu": {
          "stringUnit": {
