    "A private address for each website, delivered to your inbox. Turn any of them off when the spam starts.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "'n Privaat adres vir elke webwerf, afgelewer in jou inkassie. Skakel enige een af wanneer die gemorspos begin."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان خاص لكل موقع ويب، يصل إلى بريدك الوارد. أوقف أيًا منها عندما يبدأ البريد غير الهام."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি ওয়েবসাইটের জন্য একটি ব্যক্তিগত ঠিকানা, যা আপনার ইনবক্সে আসে। স্প্যাম শুরু হলে যেকোনোটি বন্ধ করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Una adreça privada per a cada lloc web, que arriba a la teva safata d'entrada. Desactiva qualsevol quan comenci el correu brossa."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soukromá adresa pro každý web, doručovaná do Přijatých. Kteroukoli vypněte, až začne chodit spam."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En privat adresse til hvert websted, leveret til din indbakke. Slå en af dem fra, når spammen begynder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine private Adresse für jede Website, zugestellt in deinen Posteingang. Schalte sie einfach ab, sobald der Spam beginnt."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Μια ιδιωτική διεύθυνση για κάθε ιστότοπο, που παραδίδεται στα Εισερχόμενά σας. Απενεργοποιήστε όποια θέλετε όταν αρχίσουν τα ανεπιθύμητα."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una dirección privada para cada web, que llega a tu bandeja de entrada. Desactiva cualquiera cuando empiece el spam."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یک نشانی خصوصی برای هر وب‌سایت که به صندوق ورودی شما می‌رسد. هر وقت هرزنامه شروع شد، خاموشش کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Oma yksityinen osoite jokaiselle sivustolle, viestit Saapuneisiin. Poista mikä tahansa käytöstä, kun roskaposti alkaa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pribadong address para sa bawat website, inihahatid sa inbox mo. I-off ang alinman kapag nagsimula na ang spam."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une adresse privée pour chaque site web, livrée dans votre boîte de réception. Désactivez-la dès que le spam commence."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כתובת פרטית לכל אתר, שמגיעה לדואר הנכנס שלך. אפשר לכבות כל אחת מהן כשמתחיל דואר הזבל."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर वेबसाइट के लिए एक निजी पता, जो आपके इनबॉक्स में आता है। स्पैम शुरू होते ही उसे बंद कर दें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Privatna adresa za svaku web-stranicu, isporučena u vašu ulaznu poštu. Isključite bilo koju kad počne neželjena pošta."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Minden webhelyhez egy privát cím, amely a Bejövő mappába kézbesít. Bármelyiket kikapcsolhatja, ha jönni kezd a levélszemét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat pribadi untuk setiap situs web, dikirim ke kotak masuk Anda. Matikan salah satunya saat spam mulai datang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un indirizzo privato per ogni sito web, recapitato nella tua casella. Disattivalo quando arriva lo spam."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Webサイトごとに専用のアドレスを作成し、受信ボックスに届けます。迷惑メールが届き始めたら、いつでもオフにできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "웹 사이트마다 전용 주소를 만들어 받은 편지함으로 전달합니다. 스팸이 오기 시작하면 언제든지 끌 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat peribadi untuk setiap laman web, dihantar ke peti masuk anda. Matikan mana-mana apabila spam bermula."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "En privat adresse for hvert nettsted, levert til innboksen din. Slå av en av dem når søppelposten starter."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een privéadres voor elke website, dat in Inkomend aankomt. Zet er een uit zodra de spam begint."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Prywatny adres dla każdej witryny, dostarczany do Odebranych. Wyłącz dowolny, gdy zacznie się spam."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um endereço privado para cada site, entregue na sua Caixa de Entrada. Desative qualquer um quando o spam começar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O adresă privată pentru fiecare site, livrată în Intrări. Dezactivează oricare dintre ele când încep mesajele nedorite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отдельный адрес для каждого сайта с доставкой во «Входящие». Отключите любой из них, когда начнётся спам."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Súkromná adresa pre každý web, doručovaná do Prijatých. Ktorúkoľvek vypnite, keď začne chodiť spam."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Приватна адреса за сваки веб-сајт, која стиже у ваше Пријемно сандуче. Искључите било коју када почне нежељена пошта."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En privat adress för varje webbplats, som levereras till din inkorg. Stäng av den när skräpposten börjar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Anwani ya faragha kwa kila tovuti, inayofika kwenye kikasha chako. Zima yoyote barua taka zikianza."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ప్రతి వెబ్‌సైట్‌కు ఒక ప్రైవేట్ అడ్రస్, మీ ఇన్‌బాక్స్‌కు వస్తుంది. స్పామ్ మొదలైనప్పుడు దేనినైనా ఆఫ్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ที่อยู่ส่วนตัวสำหรับแต่ละเว็บไซต์ ส่งตรงถึงกล่องจดหมายเข้าของคุณ ปิดที่อยู่ใดก็ได้เมื่อเริ่มมีอีเมลขยะ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her web sitesi için gelen kutunuza ulaşan özel bir adres. Gereksiz e-postalar başladığında istediğinizi kapatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Окрема адреса для кожного сайту з доставкою у «Вхідні». Вимкніть будь-яку з них, коли почнеться спам."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر ویب سائٹ کے لیے ایک نجی پتہ، جو آپ کے ان باکس میں آتا ہے۔ جب اسپام شروع ہو تو کسی کو بھی بند کر دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi trang web một địa chỉ riêng, gửi về hộp thư đến của bạn. Tắt bất kỳ địa chỉ nào khi thư rác bắt đầu tới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "为每个网站提供专用地址,邮件送到你的收件箱。开始收到垃圾邮件时,可随时关闭。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "為每個網站提供專用地址,郵件會送到你的收件匣。開始收到垃圾郵件時,可隨時關閉。"
          }
        }
      }
    },
