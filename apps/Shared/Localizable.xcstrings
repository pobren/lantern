        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ ఈమెయిల్‌పై ఉన్న ఏకైక లేబుల్ ఇదే. బదులుగా ఆర్కైవ్ చేయండి లేదా తరలించండి."
          }
