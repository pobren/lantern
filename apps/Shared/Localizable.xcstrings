    "Your mail server keeps the email and sends it then, even if this device is off.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Jou posbediener hou die e-pos en stuur dit dan, selfs as hierdie toestel af is."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتفظ خادم بريدك بالرسالة ويرسلها في ذلك الوقت، حتى لو كان هذا الجهاز مطفأً."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার মেল সার্ভার ইমেলটি রেখে দেয় আর তখন পাঠায়, এই ডিভাইস বন্ধ থাকলেও।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "El servidor de correu guarda el correu i l'envia en aquell moment, encara que aquest dispositiu estigui apagat."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poštovní server zprávu podrží a odešle ji v tu dobu, i když bude toto zařízení vypnuté."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Din mailserver gemmer e-mailen og sender den på tidspunktet, selv hvis denne enhed er slukket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Mailserver behält die E-Mail und sendet sie dann, auch wenn dieses Gerät aus ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ο διακομιστής email κρατά το email και το στέλνει τότε, ακόμα κι αν αυτή η συσκευή είναι κλειστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu servidor de correo guarda el correo y lo envía en ese momento, aunque este dispositivo esté apagado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرور ایمیل شما ایمیل را نگه می‌دارد و همان موقع می‌فرستد، حتی اگر این دستگاه خاموش باشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sähköpostipalvelimesi säilyttää viestin ja lähettää sen silloin, vaikka tämä laite olisi pois päältä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itatago ng mail server mo ang email at ipapadala ito sa oras na iyon, kahit naka-off ang device na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre serveur de messagerie garde l’e-mail et l’envoie à ce moment-là, même si cet appareil est éteint."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שרת הדואר שומר את ההודעה ושולח אותה בזמן הזה, גם אם המכשיר כבוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका मेल सर्वर ईमेल रखता है और उसी समय भेजता है, भले ही यह डिवाइस बंद हो।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaš poslužitelj e-pošte čuva poruku i tada je šalje, čak i ako je ovaj uređaj isključen."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A levelezőszerver megőrzi az e-mailt, és akkor küldi el, akkor is, ha ez az eszköz ki van kapcsolva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
