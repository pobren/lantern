    "Use the email address and password (or app password) from whoever runs your Cyrus server, and its address.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik die e-posadres en wagwoord (of app-wagwoord) van wie ook al jou Cyrus-bediener bestuur, en sy adres."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم عنوان البريد وكلمة السر (أو كلمة سر التطبيق) من مسؤول خادم Cyrus، وعنوان الخادم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Cyrus সার্ভার যিনি চালান তার দেওয়া ইমেল ঠিকানা ও পাসওয়ার্ড (বা অ্যাপ পাসওয়ার্ড), আর এর ঠিকানা ব্যবহার করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fes servir l'adreça de correu i la contrasenya (o contrasenya d'app) que et doni qui gestiona el teu servidor Cyrus, i la seva adreça."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte e-mailovou adresu a heslo (nebo heslo pro aplikaci) od správce vašeho serveru Cyrus a jeho adresu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug e-mailadressen og adgangskoden (eller app-adgangskoden) fra den, der driver din Cyrus-server, og serverens adresse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende E-Mail-Adresse und Passwort (oder App-Passwort) vom Betreiber deines Cyrus-Servers sowie dessen Adresse."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Χρησιμοποιήστε τη διεύθυνση email και το συνθηματικό (ή συνθηματικό εφαρμογής) από όποιον διαχειρίζεται τον διακομιστή Cyrus σας, και τη διεύθυνσή του."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la dirección de correo y la contraseña (o contraseña de app) de quien gestione tu servidor Cyrus, y su dirección."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از نشانی ایمیل و رمز (یا رمز برنامه) که گرداننده سرور Cyrus به شما داده، و نشانی آن استفاده کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Käytä Cyrus-palvelimesi ylläpitäjältä saamaasi sähköpostiosoitetta ja salasanaa (tai sovelluksen salasanaa) sekä palvelimen osoitetta."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamitin ang email address at password (o app password) mula sa namamahala ng Cyrus server mo, at ang address nito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez l’adresse e-mail et le mot de passe (ou mot de passe d’app) fournis par le gestionnaire de votre serveur Cyrus, ainsi que son adresse."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמש בכתובת הדוא״ל ובסיסמה (או בסיסמת יישום) שקיבלת ממי שמנהל את שרת Cyrus שלך, ובכתובת השרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपने Cyrus सर्वर को चलाने वाले से मिला ईमेल पता और पासवर्ड (या ऐप पासवर्ड), और उसका पता इस्तेमाल करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Upotrijebite e-adresu i lozinku (ili lozinku za aplikaciju) od onoga tko vodi vaš Cyrus poslužitelj, te njegovu adresu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Használja a Cyrus-szerver üzemeltetőjétől kapott e-mail-címet és jelszót (vagy alkalmazásjelszót), valamint a szerver címét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan alamat email dan kata sandi (atau kata sandi app) dari pengelola server Cyrus Anda, serta alamat servernya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa l’indirizzo email e la password (o password per app) forniti da chi gestisce il tuo server Cyrus, e il suo indirizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyrusサーバの管理者から提供されたメールアドレスとパスワード(またはApp用パスワード)、サーバのアドレスを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyrus 서버 관리자에게 받은 이메일 주소와 암호(또는 앱 암호), 서버 주소를 사용하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan alamat e-mel dan kata laluan (atau kata laluan app) daripada sesiapa yang menguruskan pelayan Cyrus anda, serta alamatnya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Bruk e-postadressen og passordet (eller app-passordet) fra den som drifter Cyrus-serveren din, og serverens adresse."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik het e-mailadres en wachtwoord (of app-wachtwoord) van de beheerder van je Cyrus-server, en het adres ervan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj adresu e-mail i hasła (lub hasła aplikacji) od administratora swojego serwera Cyrus oraz jego adresu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o endereço de e-mail e a senha (ou senha de app) de quem administra seu servidor Cyrus, e o endereço dele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește adresa de e-mail și parola (sau parola de aplicație) de la cine administrează serverul Cyrus, plus adresa acestuia."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите адрес e-mail и пароль (или пароль приложения) от администратора вашего сервера Cyrus, а также его адрес."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Použite e-mailovú adresu a heslo (alebo heslo pre apku) od správcu vášho servera Cyrus a jeho adresu."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Користите имејл адресу и лозинку (или лозинку за апликацију) од онога ко одржава ваш Cyrus сервер, као и његову адресу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd e-postadressen och lösenordet (eller applösenordet) från den som driver din Cyrus-server, och serverns adress."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumia anwani ya barua pepe na nenosiri (au nenosiri la programu) kutoka kwa anayesimamia seva yako ya Cyrus, pamoja na anwani yake."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ Cyrus సర్వర్ నడిపేవారు ఇచ్చిన ఈమెయిల్ అడ్రస్, పాస్‌వర్డ్ (లేదా యాప్ పాస్‌వర్డ్), మరియు దాని అడ్రస్ ఉపయోగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ที่อยู่อีเมลและรหัสผ่าน (หรือรหัสผ่านสำหรับแอป) จากผู้ดูแลเซิร์ฟเวอร์ Cyrus ของคุณ พร้อมที่อยู่ของเซิร์ฟเวอร์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cyrus sunucunuzu yöneten kişiden aldığınız e-posta adresini ve parolayı (veya uygulama parolasını) ve sunucunun adresini kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте адресу e-mail і пароль (або пароль програми) від адміністратора вашого сервера Cyrus, а також його адресу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنا Cyrus سرور چلانے والے سے ملا ای میل پتہ اور پاس ورڈ (یا ایپ پاس ورڈ)، اور اس کا پتہ استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng địa chỉ email và mật khẩu (hoặc mật khẩu ứng dụng) từ người quản lý máy chủ Cyrus của bạn, cùng địa chỉ máy chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
