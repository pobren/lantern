    "Saved to your Fastmail account, so they match on the web and in other apps.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "In jou Fastmail-rekening gestoor, sodat hulle op die web en in ander apps ooreenstem."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظة في حساب Fastmail، فتتطابق على الويب وفي التطبيقات الأخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার Fastmail অ্যাকাউন্টে সেভ হয়, তাই ওয়েবে ও অন্য অ্যাপে একই থাকে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Es desen al teu compte de Fastmail, perquè coincideixin al web i en altres apps."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukládá se do účtu Fastmail, takže sedí i na webu a v jiných aplikacích."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemt på din Fastmail-konto, så de er ens på nettet og i andre apps."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In deinem Fastmail-Account gesichert, damit sie im Web und in anderen Apps gleich sind."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Αποθηκεύονται στον λογαριασμό Fastmail σας, ώστε να ταιριάζουν στο web και σε άλλες εφαρμογές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se guardan en tu cuenta de Fastmail, así que coinciden en la web y en otras apps."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در حساب Fastmail شما ذخیره می‌شود، پس در وب و برنامه‌های دیگر یکسان است."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tallennetaan Fastmail-tilillesi, joten ne ovat samat verkossa ja muissa apeissa."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-save sa Fastmail account mo, kaya pareho sila sa web at sa ibang app."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Enregistrés dans votre compte Fastmail, pour être identiques sur le web et dans d’autres apps."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נשמר בחשבון Fastmail שלך, כך שזה זהה באינטרנט וביישומים אחרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके Fastmail खाते में सहेजे जाते हैं, ताकि वेब पर और दूसरे ऐप्स में एक जैसे रहें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Spremljeno u vašem Fastmail računu, pa je isto na webu i u drugim aplikacijama."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Fastmail-fiókjába mentve, így a weben és más appokban is egyeznek."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan ke akun Fastmail Anda, jadi sama di web dan di app lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvati nel tuo account Fastmail, quindi corrispondono sul web e nelle altre app."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmailアカウントに保存されるため、Webやほかのアプリでも同じになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail 계정에 저장되므로 웹 및 다른 앱에서도 동일하게 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Disimpan dalam akaun Fastmail anda, supaya ia sepadan di web dan dalam app lain."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Lagret i Fastmail-kontoen din, så de er like på nettet og i andre apper."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaard in je Fastmail-account, dus ze zijn hetzelfde op het web en in andere apps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane na koncie Fastmail, więc są takie same w przeglądarce i innych aplikacjach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvas na sua conta Fastmail, para ficarem iguais na web e em outros apps."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Salvate în contul Fastmail, deci sunt la fel pe web și în alte aplicații."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохраняются в учетной записи Fastmail, поэтому совпадают в веб-версии и других приложениях."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukladá sa do účtu Fastmail, takže sedí aj na webe a v iných apkách."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Сачувано на вашем Fastmail налогу, па је исто на вебу и у другим апликацијама."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Sparas i ditt Fastmail-konto, så att de är likadana på webben och i andra appar."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imehifadhiwa kwenye akaunti yako ya Fastmail, ili zilingane kwenye wavuti na katika programu nyingine."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ Fastmail ఖాతాలో సేవ్ అవుతాయి, కాబట్టి వెబ్‌లో, ఇతర యాప్‌లలో ఒకేలా ఉంటాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกไว้ในบัญชี Fastmail ของคุณ จึงตรงกันทั้งบนเว็บและในแอปอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fastmail hesabınıza kaydedilir; web'de ve diğer uygulamalarda aynı olur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігаються в обліковому записі Fastmail, тож збігаються у вебверсії та інших програмах."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے Fastmail اکاؤنٹ میں محفوظ، اس لیے ویب اور دوسری ایپس میں ایک جیسے رہتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Được lưu vào tài khoản Fastmail nên giống nhau trên web và trong các ứng dụng khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存到你的 Fastmail 账户,因此在网页和其他 App 中保持一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存到你的 Fastmail 帳號,因此在網頁和其他 App 中都會一致。"
          }
        }
      }
    },
