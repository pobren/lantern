    "Not sent. It's back in Drafts.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie gestuur nie. Dit is terug in Konsepte."
          }
        },
        "ar": {
