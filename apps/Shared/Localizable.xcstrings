    "Made on this device. Your email didn't leave it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Op hierdie toestel gemaak. Jou e-pos het dit nie verlaat nie."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُعدّ على هذا الجهاز. لم يغادره بريدك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসেই তৈরি। আপনার ইমেল এর বাইরে যায়নি।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Fet en aquest dispositiu. El teu correu no n'ha sortit."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvořeno na tomto zařízení. Vaše pošta ho neopustila."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Lavet på denne enhed. Din e-mail forlod den ikke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät erstellt. Deine E-Mail hat es nicht verlassen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Φτιάχτηκε σε αυτή τη συσκευή. Το email σας δεν έφυγε από αυτή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hecho en este dispositivo. Tu correo no ha salido de él."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "روی همین دستگاه ساخته شد. ایمیل شما از آن خارج نشد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tehty tällä laitteella. Viestisi ei lähtenyt siltä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ginawa sa device na ito. Hindi umalis dito ang email mo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fait sur cet appareil. Votre e-mail ne l’a pas quitté."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נוצר במכשיר הזה. הדוא״ל שלך לא יצא ממנו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसी डिवाइस पर बना। आपका ईमेल इससे बाहर नहीं गया।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Izrađeno na ovom uređaju. Vaša e-pošta nije ga napustila."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen az eszközön készült. Az e-mail nem hagyta el."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuat di perangkat ini. Email Anda tidak keluar dari perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creato su questo dispositivo. La tua email non ne è uscita."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このデバイス上で作成。メールはデバイスの外に出ていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에서 만들었습니다. 이메일은 기기 밖으로 나가지 않았습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dibuat pada peranti ini. E-mel anda tidak meninggalkannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Laget på denne enheten. E-posten din forlot den ikke."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemaakt op dit apparaat. Je e-mail heeft het niet verlaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utworzone na tym urządzeniu. Twoja poczta go nie opuściła."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Feito neste dispositivo. Seu e-mail não saiu dele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Realizat pe acest dispozitiv. E-mailul tău nu l-a părăsit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создано на этом устройстве. Ваша почта его не покидала."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvorené na tomto zariadení. Vaša pošta ho neopustila."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Направљено на овом уређају. Ваш имејл га није напустио."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Gjord på den här enheten. Ditt mejl lämnade den aldrig."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imetengenezwa kwenye kifaa hiki. Barua pepe yako haikukiacha."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ పరికరంలోనే తయారైంది. మీ ఈమెయిల్ బయటకు వెళ్లలేదు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สร้างบนอุปกรณ์นี้ อีเมลของคุณไม่ได้ออกไปจากอุปกรณ์"
