    "Couldn't find a JMAP server for that email address. Enter the server's address instead.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kon nie 'n JMAP-bediener vir daardie e-posadres vind nie. Voer eerder die bediener se adres in."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر العثور على خادم JMAP لعنوان البريد هذا. أدخل عنوان الخادم بدلًا منه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওই ইমেল ঠিকানার জন্য কোনো JMAP সার্ভার পাওয়া যায়নি। এর বদলে সার্ভারের ঠিকানা লিখুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "No s'ha trobat cap servidor JMAP per a aquesta adreça de correu. Introdueix l'adreça del servidor."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tuto e-mailovou adresu se nepodařilo najít server JMAP. Zadejte adresu serveru."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunne ikke finde en JMAP-server til den e-mailadresse. Indtast serverens adresse i stedet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese E-Mail-Adresse wurde kein JMAP-Server gefunden. Gib stattdessen die Adresse des Servers ein."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Δεν βρέθηκε διακομιστής JMAP για αυτή τη διεύθυνση email. Εισαγάγετε αντί γι’ αυτό τη διεύθυνση του διακομιστή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado un servidor JMAP para esa dirección de correo. Introduce la dirección del servidor."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرور JMAP برای این نشانی ایمیل پیدا نشد. به‌جای آن نشانی سرور را وارد کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Sähköpostiosoitteelle ei löytynyt JMAP-palvelinta. Anna palvelimen osoite."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang nahanap na JMAP server para sa email address na iyon. Ilagay na lang ang address ng server."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun serveur JMAP trouvé pour cette adresse e-mail. Saisissez plutôt l’adresse du serveur."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נמצא שרת JMAP עבור כתובת הדוא״ל הזו. הזן במקום זאת את כתובת השרת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उस ईमेल पते के लिए कोई JMAP सर्वर नहीं मिला। इसके बजाय सर्वर का पता डालें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za tu e-adresu nije pronađen JMAP poslužitelj. Umjesto toga unesite adresu poslužitelja."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehhez az e-mail-címhez nem található JMAP-szerver. Adja meg inkább a szerver címét."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menemukan server JMAP untuk alamat email itu. Masukkan alamat server sebagai gantinya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun server JMAP trovato per quell’indirizzo email. Inserisci invece l’indirizzo del server."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "そのメールアドレスのJMAPサーバが見つかりませんでした。サーバのアドレスを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "해당 이메일 주소의 JMAP 서버를 찾을 수 없습니다. 대신 서버 주소를 입력하십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menemui pelayan JMAP untuk alamat e-mel itu. Masukkan alamat pelayan sebaliknya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fant ingen JMAP-server for den e-postadressen. Skriv inn serverens adresse i stedet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen JMAP-server gevonden voor dat e-mailadres. Voer in plaats daarvan het adres van de server in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono serwera JMAP dla tego adresu. Wpisz adres serwera."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível encontrar um servidor JMAP para esse endereço de e-mail. Digite o endereço do servidor."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu s-a găsit un server JMAP pentru această adresă de e-mail. Introdu în schimb adresa serverului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось найти сервер JMAP для этого адреса. Введите адрес сервера."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pre túto e-mailovú adresu sa nepodarilo nájsť server JMAP. Zadajte adresu servera."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Није пронађен JMAP сервер за ту имејл адресу. Уместо тога унесите адресу сервера."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunde inte hitta någon JMAP-server för den e-postadressen. Ange serverns adress i stället."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Imeshindwa kupata seva ya JMAP kwa anwani hiyo ya barua pepe. Weka anwani ya seva badala yake."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆ ఈమెయిల్ అడ్రస్ కోసం JMAP సర్వర్ కనుగొనబడలేదు. బదులుగా సర్వర్ అడ్రస్ ఎంటర్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่พบเซิร์ฟเวอร์ JMAP สำหรับที่อยู่อีเมลนั้น ป้อนที่อยู่ของเซิร์ฟเวอร์แทน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu e-posta adresi için JMAP sunucusu bulunamadı. Bunun yerine sunucunun adresini girin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося знайти сервер JMAP для цієї адреси. Введіть адресу сервера."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ای میل پتے کے لیے JMAP سرور نہیں ملا۔ اس کے بجائے سرور کا پتہ درج کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không tìm thấy máy chủ JMAP cho địa chỉ email đó. Hãy nhập địa chỉ máy chủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "找不到该电子邮件地址的 JMAP 服务器。请改为输入服务器地址。"
