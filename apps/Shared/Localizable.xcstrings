          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీ Thundermail డ్యాష్‌బోర్డ్‌లో, Email Settings తెరిచి Create app password నొక్కండి. మీ Thundermail అడ్రస్ మరియు ఆ యాప్ పాస్‌వర్డ్ ఉపయోగించండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ในแดชบอร์ด Thundermail ให้เปิด Email Settings แล้วกด Create app password ใช้ที่อยู่ Thundermail ของคุณและรหัสผ่านสำหรับแอปนั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Thundermail panonuzda E-posta Ayarları'nı açın ve Uygulama parolası oluştur'a basın. Thundermail adresinizi ve bu uygulama parolasını kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На панелі Thundermail відкрийте Email Settings і натисніть Create app password. Використовуйте свою адресу Thundermail і цей пароль програми."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنے Thundermail ڈیش بورڈ میں ای میل سیٹنگز کھولیں اور ایپ پاس ورڈ بنائیں دبائیں۔ اپنا Thundermail پتہ اور وہ ایپ پاس ورڈ استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trong bảng điều khiển Thundermail, mở Email Settings và nhấn Create app password. Dùng địa chỉ Thundermail và mật khẩu ứng dụng đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Thundermail 控制面板中,打开“Email Settings”并点按“Create app password”。使用你的 Thundermail 地址和该 App 专用密码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 Thundermail 控制面板中,打開「Email Settings」並按下「Create app password」。使用你的 Thundermail 地址和該 App 專用密碼。"
          }
        }
      }
