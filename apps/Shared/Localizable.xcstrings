    "Archive all and Delete all only touch this sender's emails still in your inbox. Undo puts them back.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Argiveer almal en Skrap almal raak net hierdie sender se e-posse wat nog in jou inkassie is. Ontdoen sit hulle terug."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا تؤثر أرشفة الكل وحذف الكل إلا على رسائل هذا المرسل التي لا تزال في بريدك الوارد. التراجع يعيدها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব আর্কাইভ করুন ও সব মুছুন শুধু এই প্রেরকের সেই ইমেলগুলোতে কাজ করে যা এখনো আপনার ইনবক্সে আছে। পূর্বাবস্থা সেগুলো ফিরিয়ে আনে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Arxivar-ho tot i Eliminar-ho tot només afecten els correus d'aquest remitent que encara són a la safata d'entrada. Desfer els torna on eren."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivovat vše a Smazat vše se týkají jen zpráv od tohoto odesílatele, které jsou ještě v Přijatých. Odvolat je vrátí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkivér alle og Slet alle berører kun denne afsenders e-mails, der stadig er i din indbakke. Fortryd lægger dem tilbage."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "„Alle archivieren“ und „Alle löschen“ betreffen nur E-Mails dieses Absenders, die noch im Posteingang sind. „Widerrufen“ holt sie zurück."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Η Αρχειοθέτηση όλων και η Διαγραφή όλων αφορούν μόνο τα email αυτού του αποστολέα που είναι ακόμα στα Εισερχόμενα. Η Αναίρεση τα επαναφέρει."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivar todo y Eliminar todo solo afectan a los correos de este remitente que siguen en tu bandeja de entrada. Deshacer los devuelve."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بایگانی همه و حذف همه فقط روی ایمیل‌های این فرستنده که هنوز در صندوق ورودی‌اند اثر دارند. واگرد آن‌ها را برمی‌گرداند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkistoi kaikki ja Poista kaikki koskevat vain tämän lähettäjän viestejä, jotka ovat yhä Saapuneissa. Kumoa palauttaa ne."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang I-archive lahat at I-delete lahat ay para lang sa mga email ng sender na ito na nasa inbox mo pa. Ibinabalik sila ng Undo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tout archiver et Tout supprimer ne concernent que les e-mails de cet expéditeur encore dans votre boîte de réception. Annuler les remet en place."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "״העבר הכל לארכיון״ ו״מחק הכל״ משפיעים רק על ההודעות של השולח הזה שעדיין בדואר הנכנס. ״ביטול״ מחזיר אותן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सभी आर्काइव करें और सभी डिलीट करें सिर्फ़ इस प्रेषक के उन ईमेल पर लागू होते हैं जो अभी आपके इनबॉक्स में हैं। पूर्ववत करें उन्हें वापस ले आता है।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arhiviraj sve i Obriši sve odnose se samo na e-poruke ovog pošiljatelja koje su još u ulaznoj pošti. Poništi ih vraća."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Az Összes archiválása és az Összes törlése csak a feladó Bejövő mappában lévő e-mailjeit érinti. A Visszavonás visszahozza őket."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Arsipkan semua dan Hapus semua hanya berlaku untuk email pengirim ini yang masih di kotak masuk. Urungkan akan mengembalikannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivia tutto ed Elimina tutto riguardano solo le email di questo mittente ancora in In arrivo. Annulla le rimette a posto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「すべてアーカイブ」と「すべて削除」は、受信ボックスに残っているこの差出人のメールだけが対象です。「取り消す」で元に戻せます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 보관 및 모두 삭제는 받은 편지함에 남아 있는 이 발신자의 이메일에만 적용됩니다. 실행 취소하면 되돌릴 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkibkan semua dan Padam semua hanya menyentuh e-mel penghantar ini yang masih dalam peti masuk anda. Buat Asal mengembalikannya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkiver alle og Slett alle gjelder bare e-poster fra denne avsenderen som fortsatt er i innboksen. Angre legger dem tilbake."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiveer alles en Verwijder alles raken alleen e-mails van deze afzender die nog in Inkomend staan. Herstel zet ze terug."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Archiwizuj wszystkie i Usuń wszystkie dotyczą tylko wiadomości tego nadawcy, które są jeszcze w Odebranych. Cofnij przywraca je."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arquivar tudo e Apagar tudo só afetam os e-mails deste remetente que ainda estão na sua Caixa de Entrada. Desfazer os traz de volta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Arhivează tot și Șterge tot afectează doar e-mailurile acestui expeditor aflate încă în Intrări. Anulează le readuce."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "«Архивировать все» и «Удалить все» затрагивают только письма этого отправителя, которые ещё во «Входящих». «Отменить» вернёт их."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Archivovať všetky a Vymazať všetky sa týkajú iba správ od tohto odosielateľa, ktoré sú ešte v Prijatých. Späť ich vráti."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Архивирај све и Избриши све утичу само на имејлове овог пошиљаоца који су још у Пријемном сандучету. Опозови их враћа."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Arkivera alla och Radera alla rör bara den här avsändarens mejl som fortfarande ligger i inkorgen. Ångra lägger tillbaka dem."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hifadhi zote na Futa zote hugusa tu barua pepe za mtumaji huyu ambazo bado ziko kwenye kikasha chako. Tendua huzirudisha."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "అన్నీ ఆర్కైవ్ చేయి మరియు అన్నీ తొలగించు ఈ పంపినవారి ఈమెయిల్‌లలో ఇంకా మీ ఇన్‌బాక్స్‌లో ఉన్నవాటిపై మాత్రమే పనిచేస్తాయి. రద్దు చేయి వాటిని తిరిగి తెస్తుంది."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บถาวรทั้งหมดและลบทั้งหมดมีผลเฉพาะอีเมลของผู้ส่งรายนี้ที่ยังอยู่ในกล่องจดหมายเข้า เลิกทำจะนำกลับมา"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tümünü Arşivle ve Tümünü Sil yalnızca bu göndericinin hâlâ gelen kutunuzdaki e-postalarını etkiler. Geri Al onları geri getirir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "«Архівувати всі» та «Видалити всі» стосуються лише листів цього відправника, що досі у «Вхідних». «Скасувати» поверне їх."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سب آرکائیو کریں اور سب ڈیلیٹ کریں صرف اس بھیجنے والے کی وہ ای میلز متاثر کرتے ہیں جو ابھی آپ کے ان باکس میں ہیں۔ کالعدم کریں انہیں واپس لے آتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lưu trữ tất cả và Xóa tất cả chỉ áp dụng cho các email của người gửi này còn trong hộp thư đến. Hoàn tác sẽ đưa chúng trở lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "“全部归档”和“全部删除”只影响此发件人仍在收件箱中的邮件。“撤销”可将其放回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "「全部封存」和「全部刪除」只會影響此寄件人仍在收件匣中的郵件。「還原」可將其放回。"
          }
        }
      }
    },
