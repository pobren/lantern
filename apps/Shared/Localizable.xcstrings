    "Only you see this. It's saved with the contact in your address book.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Net jy sien dit. Dit word saam met die kontak in jou adresboek gestoor."
