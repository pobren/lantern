    "Turn on Apple Intelligence in System Settings to use this.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel Apple Intelligence aan in Stelselinstellings om dit te gebruik."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شغّل Apple Intelligence في إعدادات النظام لاستخدام هذا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি ব্যবহার করতে সিস্টেম সেটিংসে Apple Intelligence চালু করুন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Apple Intelligence a Configuració del Sistema per fer servir això."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro použití zapněte Apple Intelligence v Nastavení systému."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå Apple Intelligence til i Systemindstillinger for at bruge dette."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiviere Apple Intelligence in den Systemeinstellungen, um dies zu nutzen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Ενεργοποιήστε το Apple Intelligence στις Ρυθμίσεις συστήματος για να το χρησιμοποιήσετε."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa Apple Intelligence en Ajustes del Sistema para usar esto."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای استفاده از این، Apple Intelligence را در تنظیمات سیستم روشن کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ota Apple Intelligence käyttöön Järjestelmäasetuksissa, jotta voit käyttää tätä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-on ang Apple Intelligence sa System Settings para magamit ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Activez Apple Intelligence dans Réglages Système pour utiliser cette fonction."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעל את Apple Intelligence ב״הגדרות המערכת״ כדי להשתמש בזה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसे इस्तेमाल करने के लिए सिस्टम सेटिंग्ज़ में Apple Intelligence चालू करें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Za ovo uključite Apple Intelligence u Postavkama sustava."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ehhez kapcsolja be az Apple Intelligence-t a Rendszerbeállításokban."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nyalakan Apple Intelligence di Pengaturan Sistem untuk menggunakan ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Attiva Apple Intelligence in Impostazioni di Sistema per usare questa funzione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これを使用するには、システム設定でApple Intelligenceをオンにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기능을 사용하려면 시스템 설정에서 Apple Intelligence를 켜십시오."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hidupkan Apple Intelligence dalam Seting Sistem untuk menggunakan ini."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Apple Intelligence i Systeminnstillinger for å bruke dette."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet Apple Intelligence aan in Systeeminstellingen om dit te gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Włącz Apple Intelligence w Ustawieniach systemowych, aby tego używać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ative a Apple Intelligence nos Ajustes do Sistema para usar isto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activează Apple Intelligence în Configurări sistem pentru a folosi asta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Чтобы пользоваться этим, включите Apple Intelligence в Системных настройках."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ak to chcete použiť, zapnite Apple Intelligence v Systémových nastaveniach."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Укључите Apple Intelligence у Системским подешавањима да бисте ово користили."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå på Apple Intelligence i Systeminställningar för att använda det här."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Washa Apple Intelligence katika Mipangilio ya Mfumo ili kutumia hii."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "దీన్ని ఉపయోగించడానికి సిస్టమ్ సెట్టింగ్‌లలో Apple Intelligenceను ఆన్ చేయండి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เปิด Apple Intelligence ในการตั้งค่าระบบเพื่อใช้คุณสมบัตินี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunu kullanmak için Sistem Ayarları'nda Apple Intelligence'ı açın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Щоб користуватися цим, увімкніть Apple Intelligence у Системних параметрах."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اسے استعمال کرنے کے لیے سسٹم سیٹنگز میں Apple Intelligence آن کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bật Apple Intelligence trong Cài đặt hệ thống để dùng tính năng này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在“系统设置”中打开 Apple Intelligence 以使用此功能。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在「系統設定」中開啟 Apple Intelligence 以使用此功能。"
          }
        }
      }
    },
    "Turn this off to stop senders seeing when you open their emails. You can still show pictures on any email.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Skakel dit af om te keer dat senders sien wanneer jy hul e-posse oopmaak. Jy kan steeds prente op enige e-pos wys."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أوقف هذا لتمنع المرسلين من معرفة متى تفتح رسائلهم. لا يزال بإمكانك إظهار الصور في أي رسالة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি কখন ইমেল খোলেন তা প্রেরকদের দেখা বন্ধ করতে এটি বন্ধ করুন। তবুও যেকোনো ইমেলে ছবি দেখাতে পারবেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva això perquè els remitents no vegin quan obres els seus correus. Pots continuar mostrant les imatges de qualsevol correu."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypněte, aby odesílatelé neviděli, kdy otevíráte jejich zprávy. Obrázky můžete u každé zprávy stále zobrazit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå dette fra, så afsendere ikke kan se, hvornår du åbner deres e-mails. Du kan stadig vise billeder i enhver e-mail."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schalte dies aus, damit Absender nicht sehen, wann du ihre E-Mails öffnest. Bilder kannst du bei jeder E-Mail trotzdem anzeigen."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Απενεργοποιήστε το για να μη βλέπουν οι αποστολείς πότε ανοίγετε τα email τους. Μπορείτε πάντα να εμφανίσετε εικόνες σε οποιοδήποτε email."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Desactiva esto para que los remitentes no vean cuándo abres sus correos. Igualmente puedes mostrar las imágenes de cualquier correo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این را خاموش کنید تا فرستندگان نبینند کی ایمیلشان را باز می‌کنید. همچنان می‌توانید تصاویر هر ایمیلی را نشان دهید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poista tämä käytöstä, niin lähettäjät eivät näe, milloin avaat heidän viestinsä. Voit silti näyttää kuvat missä tahansa viestissä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-off ito para hindi makita ng mga sender kapag binuksan mo ang email nila. Puwede mo pa ring ipakita ang mga larawan sa anumang email."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactivez cette option pour que les expéditeurs ne voient pas quand vous ouvrez leurs e-mails. Vous pouvez toujours afficher les images de n’importe quel e-mail."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כבה זאת כדי שהשולחים לא יראו מתי פתחת את ההודעות שלהם. עדיין אפשר להציג תמונות בכל הודעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रेषकों को यह दिखने से रोकने के लिए कि आप उनके ईमेल कब खोलते हैं, इसे बंद करें। आप फिर भी किसी भी ईमेल की तस्वीरें दिखा सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Isključite ovo da pošiljatelji ne vide kad otvarate njihove e-poruke. Slike i dalje možete prikazati na bilo kojoj e-poruci."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Kapcsolja ki, hogy a feladók ne lássák, mikor nyitja meg a leveleiket. A képeket bármely e-mailben így is megjelenítheti."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan ini agar pengirim tidak tahu kapan Anda membuka email mereka. Anda tetap dapat menampilkan gambar di email mana pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattiva questa opzione per non far vedere ai mittenti quando apri le loro email. Puoi comunque mostrare le immagini in qualsiasi email."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフにすると、メールを開いたことが差出人に知られなくなります。メールごとに画像を表示することもできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 옵션을 끄면 발신자가 이메일을 언제 열었는지 알 수 없습니다. 이메일마다 사진을 볼 수도 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Matikan ini untuk menghalang penghantar melihat bila anda membuka e-mel mereka. Anda masih boleh menunjukkan gambar pada mana-mana e-mel."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Slå av dette for å hindre at avsendere ser når du åpner e-postene deres. Du kan fortsatt vise bilder i hvilken som helst e-post."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zet dit uit zodat afzenders niet zien wanneer je hun e-mails opent. Je kunt nog steeds afbeeldingen tonen bij elke e-mail."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłącz, aby nadawcy nie widzieli, kiedy otwierasz ich wiadomości. Nadal możesz pokazać obrazki w każdej wiadomości."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desative para impedir que os remetentes vejam quando você abre os e-mails deles. Você ainda pode mostrar as imagens de qualquer e-mail."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Dezactivează ca expeditorii să nu vadă când le deschizi e-mailurile. Poți afișa totuși imaginile din orice e-mail."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выключите, чтобы отправители не видели, когда вы открываете их письма. Изображения в любом письме всё равно можно показать."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Vypnite, aby odosielatelia nevideli, kedy otvárate ich správy. Obrázky môžete pri každej správe stále zobraziť."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Искључите ово да пошиљаоци не би видели када отварате њихове имејлове. И даље можете приказати слике у било ком имејлу."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Stäng av det här så ser avsändare inte när du öppnar deras mejl. Du kan fortfarande visa bilder i vilket mejl som helst."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Zima hii ili watumaji wasione unapofungua barua pepe zao. Bado unaweza kuonyesha picha kwenye barua pepe yoyote."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "మీరు వారి ఈమెయిల్‌లు ఎప్పుడు తెరుస్తారో పంపినవారు చూడకుండా ఆపడానికి దీన్ని ఆఫ్ చేయండి. మీరు ఇప్పటికీ ఏ ఈమెయిల్‌లోనైనా చిత్రాలను చూపించవచ్చు."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ปิดตัวเลือกนี้เพื่อไม่ให้ผู้ส่งเห็นว่าคุณเปิดอีเมลเมื่อใด คุณยังสามารถแสดงรูปภาพในอีเมลใดก็ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göndericilerin e-postalarını ne zaman açtığınızı görmesini önlemek için bunu kapatın. Resimleri yine de istediğiniz e-postada gösterebilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкніть, щоб відправники не бачили, коли ви відкриваєте їхні листи. Зображення в будь-якому листі все одно можна показати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بھیجنے والوں کو یہ دیکھنے سے روکنے کے لیے کہ آپ ان کی ای میلز کب کھولتے ہیں، اسے بند کریں۔ آپ پھر بھی کسی بھی ای میل پر تصاویر دکھا سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tắt mục này để người gửi không biết khi bạn mở email của họ. Bạn vẫn có thể hiện hình ảnh trên bất kỳ email nào."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "关闭此项可防止发件人知道你何时打开他们的邮件。你仍可在任何邮件上显示图片。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "關閉此項可避免寄件人知道你何時打開他們的郵件。你仍可在任何郵件上顯示圖片。"
          }
        }
      }
    },
