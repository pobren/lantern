    "Choose which mail accounts JMAP Connect shows while this Focus is on.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies watter posrekeninge JMAP Connect wys terwyl hierdie Fokus aan is."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر حسابات البريد التي يعرضها JMAP Connect أثناء تشغيل وضع التركيز هذا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ফোকাস চালু থাকলে JMAP Connect কোন মেল অ্যাকাউন্ট দেখাবে তা বেছে নিন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Tria quins comptes de correu mostra JMAP Connect mentre aquesta Concentració està activada."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte, které poštovní účty JMAP Connect zobrazí, když je zapnutý tento režim soustředění."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg, hvilke e-mailkonti JMAP Connect viser, mens dette fokus er slået til."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle, welche Mail-Accounts JMAP Connect zeigt, während dieser Fokus aktiv ist."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Επιλέξτε ποιους λογαριασμούς δείχνει το JMAP Connect όσο είναι ενεργή αυτή η Εστίαση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige qué cuentas de correo muestra JMAP Connect mientras este modo de concentración está activado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتخاب کنید JMAP Connect هنگام روشن بودن این تمرکز کدام حساب‌های ایمیل را نشان دهد."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
