    "Replies go out from the address the email was sent to, when you can send from it.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoorde gaan uit van die adres waarheen die e-pos gestuur is, wanneer jy daarvandaan kan stuur."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرسل الردود من العنوان الذي أُرسلت إليه الرسالة، إن كان بإمكانك الإرسال منه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইমেলটি যে ঠিকানায় পাঠানো হয়েছিল সেখান থেকে উত্তর যায়, যদি আপনি সেখান থেকে পাঠাতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les respostes surten de l'adreça a la qual es va enviar el correu, quan pots enviar des d'aquesta adreça."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovědi odcházejí z adresy, na kterou zpráva přišla, pokud z ní můžete odesílat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar sendes fra den adresse, e-mailen blev sendt til, når du kan sende fra den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Antworten werden von der Adresse gesendet, an die die E-Mail ging, sofern du von ihr senden kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι απαντήσεις φεύγουν από τη διεύθυνση στην οποία στάλθηκε το email, όταν μπορείτε να στείλετε από αυτή."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas salen desde la dirección a la que se envió el correo, cuando puedes enviar desde ella."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پاسخ‌ها از نشانی‌ای که ایمیل به آن فرستاده شده ارسال می‌شوند، اگر بتوانید از آن بفرستید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Vastaukset lähtevät osoitteesta, johon viesti lähetettiin, jos voit lähettää siitä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipinapadala ang mga reply mula sa address na pinadalhan ng email, kapag puwede kang magpadala mula rito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses partent de l’adresse à laquelle l’e-mail a été envoyé, quand vous pouvez envoyer depuis celle-ci."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תשובות נשלחות מהכתובת שאליה נשלחה ההודעה, כשאפשר לשלוח ממנה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जवाब उस पते से जाते हैं जिस पर ईमेल भेजा गया था, अगर आप उससे भेज सकते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovori se šalju s adrese na koju je e-poruka poslana, ako s nje možete slati."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A válaszok arról a címről mennek ki, amelyre az e-mail érkezett, ha arról küldhet."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Balasan dikirim dari alamat tujuan email tersebut, jika Anda bisa mengirim dari alamat itu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le risposte partono dall’indirizzo a cui è stata inviata l’email, quando puoi inviare da quello."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "返信は、送信可能な場合、メールの宛先だったアドレスから送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보낼 수 있는 경우, 답장은 이메일을 받은 주소에서 보냅니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Balasan dihantar dari alamat yang menerima e-mel itu, apabila anda boleh menghantar daripadanya."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar sendes fra adressen e-posten ble sendt til, når du kan sende fra den."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Antwoorden worden verstuurd vanaf het adres waar de e-mail naartoe ging, als je daarvandaan kunt versturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedzi wychodzą z adresu, na który wysłano wiadomość, jeśli możesz z niego wysyłać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As respostas saem do endereço para o qual o e-mail foi enviado, quando você pode enviar a partir dele."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspunsurile pleacă de la adresa la care a fost trimis e-mailul, când poți trimite de pe ea."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ответы отправляются с адреса, на который пришло письмо, если с него можно отправлять."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovede odchádzajú z adresy, na ktorú správa prišla, ak z nej môžete odosielať."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Одговори се шаљу са адресе на коју је имејл послат, када са ње можете да шаљете."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Svar skickas från adressen mejlet skickades till, om du kan skicka från den."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Majibu hutumwa kutoka kwa anwani ambayo barua pepe ilitumwa kwake, ukiweza kutuma kutoka kwayo."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈమెయిల్ ఏ అడ్రస్‌కు పంపబడిందో, మీరు దాని నుండి పంపగలిగితే, అక్కడి నుండే రిప్లైలు వెళ్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตอบกลับจะส่งจากที่อยู่ที่อีเมลถูกส่งมา หากคุณสามารถส่งจากที่อยู่นั้นได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtlar, gönderebiliyorsanız e-postanın gönderildiği adresten gider."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповіді надсилаються з адреси, на яку прийшов лист, якщо з неї можна надсилати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جوابات اس پتے سے جاتے ہیں جس پر ای میل بھیجی گئی تھی، اگر آپ اس سے بھیج سکتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư trả lời được gửi từ địa chỉ mà email được gửi tới, nếu bạn có thể gửi từ địa chỉ đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "回复将从邮件的收件地址发出(如果你能从该地址发送)。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "回覆會從郵件的收件地址寄出(若你可從該地址傳送)。"
          }
        }
      }
    },
