    "Out of office replies are saved on your mail server, so they work with every device switched off.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Afwesig-antwoorde word op jou posbediener gestoor, so hulle werk met elke toestel afgeskakel."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ ردود خارج المكتب على خادم بريدك، فتعمل حتى مع إيقاف كل الأجهزة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অফিসের বাইরের উত্তর আপনার মেল সার্ভারে সেভ হয়, তাই সব ডিভাইস বন্ধ থাকলেও কাজ করে।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Les respostes de Fora de l'oficina es desen al servidor de correu, així que funcionen amb tots els dispositius apagats."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovědi v nepřítomnosti se ukládají na poštovním serveru, takže fungují, i když jsou všechna zařízení vypnutá."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraværssvar gemmes på din mailserver, så de virker, selv når alle enheder er slukket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Abwesenheitsnotizen werden auf deinem Mailserver gespeichert und funktionieren so auch bei ausgeschalteten Geräten."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Οι απαντήσεις Εκτός γραφείου αποθηκεύονται στον διακομιστή email σας, οπότε λειτουργούν ακόμα και με όλες τις συσκευές κλειστές."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las respuestas de fuera de la oficina se guardan en tu servidor de correo, así que funcionan con todos los dispositivos apagados."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پاسخ‌های خارج از دفتر روی سرور ایمیل شما ذخیره می‌شوند، پس حتی وقتی همه دستگاه‌ها خاموش‌اند کار می‌کنند."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Poissaolovastaukset tallennetaan sähköpostipalvelimellesi, joten ne toimivat, vaikka kaikki laitteet olisivat pois päältä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-save sa mail server mo ang mga Out of office reply, kaya gumagana ang mga ito kahit naka-off ang lahat ng device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les réponses d’absence sont enregistrées sur votre serveur de messagerie et fonctionnent même avec tous vos appareils éteints."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תשובות בהיעדרות נשמרות בשרת הדואר שלך, כך שהן פועלות גם כשכל המכשירים כבויים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ़िस से बाहर वाले जवाब आपके मेल सर्वर पर सहेजे जाते हैं, इसलिए हर डिवाइस बंद होने पर भी काम करते हैं।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odgovori Izvan ureda spremaju se na vašem poslužitelju e-pošte, pa rade i kad su svi uređaji isključeni."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A Házon kívül válaszok a levelezőszerveren vannak mentve, így akkor is működnek, ha minden eszköze ki van kapcsolva."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Balasan di luar kantor disimpan di server email Anda, jadi tetap berfungsi meski semua perangkat dimatikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le risposte Fuori sede sono salvate sul tuo server di posta, quindi funzionano anche con tutti i dispositivi spenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "不在通知はメールサーバに保存されるため、すべてのデバイスの電源が切れていても機能します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "부재중 응답은 메일 서버에 저장되므로 모든 기기가 꺼져 있어도 작동합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Balasan Di luar pejabat disimpan pada pelayan mel anda, jadi ia berfungsi walaupun semua peranti dimatikan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Fraværssvar lagres på e-postserveren din, så de virker selv om alle enhetene er slått av."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Afwezigheidsberichten worden op je mailserver bewaard, dus ze werken ook met al je apparaten uit."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpowiedzi o nieobecności są zapisane na serwerze poczty, więc działają nawet przy wyłączonych wszystkich urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As respostas de ausência ficam salvas no seu servidor de e-mail, então funcionam mesmo com todos os dispositivos desligados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Răspunsurile Absent de la birou sunt salvate pe serverul de e-mail, deci funcționează chiar și cu toate dispozitivele oprite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоответы хранятся на почтовом сервере, поэтому работают, даже когда все устройства выключены."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odpovede v neprítomnosti sa ukladajú na poštovom serveri, takže fungujú, aj keď sú všetky zariadenia vypnuté."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Одговори Ван канцеларије чувају се на вашем серверу поште, па раде и када су сви уређаји искључени."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Frånvarosvar sparas på din e-postserver, så de fungerar även när alla enheter är avstängda."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Majibu ya Sipo ofisini huhifadhiwa kwenye seva yako ya barua, kwa hivyo hufanya kazi hata vifaa vyote vikiwa vimezimwa."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఆఫీస్‌లో లేను రిప్లైలు మీ మెయిల్ సర్వర్‌లో సేవ్ అవుతాయి, కాబట్టి అన్ని పరికరాలు ఆఫ్‌లో ఉన్నా పనిచేస్తాయి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตอบกลับเมื่อไม่อยู่จะบันทึกไว้บนเซิร์ฟเวอร์อีเมลของคุณ จึงทำงานได้แม้ทุกอุปกรณ์จะปิดอยู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İzin yanıtları posta sunucunuzda kaydedilir, böylece tüm aygıtlar kapalıyken de çalışır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автовідповіді зберігаються на поштовому сервері, тож працюють, навіть коли всі пристрої вимкнено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دفتر سے باہر کے جوابات آپ کے میل سرور پر محفوظ ہوتے ہیں، اس لیے تمام ڈیوائسز بند ہونے پر بھی کام کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trả lời vắng mặt được lưu trên máy chủ thư nên vẫn hoạt động khi mọi thiết bị đều tắt."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "外出回复保存在你的邮件服务器上,所有设备关机时也能运作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "外出回覆儲存在你的郵件伺服器上,即使所有裝置都關機也能運作。"
          }
        }
      }
    },
    "Out of office, %@": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Afwesig, %@"
          }
        },
