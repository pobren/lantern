        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n’a jamais été ouvert, une connexion est donc nécessaire."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ לא נפתח בעבר, ולכן נדרש חיבור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ पहले कभी नहीं खोला गया, इसलिए इसे कनेक्शन चाहिए।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ još nije otvoren, pa treba vezu."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "A(z) %@ még nem volt megnyitva, ezért kapcsolat kell hozzá."
