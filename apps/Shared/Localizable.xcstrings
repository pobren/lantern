    "Remove and forget the key": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwyder en vergeet die sleutel"
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إزالة ونسيان المفتاح"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সরান ও কী ভুলে যান"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Eliminar i oblidar la clau"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstranit a zapomenout klíč"
          }
        },
