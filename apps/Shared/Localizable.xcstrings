    "Mail kept on this Mac, so you can read and search without a connection.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Pos op hierdie Mac gehou, sodat jy sonder 'n verbinding kan lees en soek."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بريد محفوظ على هذا الـ Mac، لتقرأ وتبحث دون اتصال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Mac-এ রাখা মেল, যাতে সংযোগ ছাড়াই পড়তে ও সার্চ করতে পারেন।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Correu desat en aquest Mac, perquè puguis llegir i cercar sense connexió."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošta uložená na tomto Macu, abyste mohli číst a hledat bez připojení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Post gemt på denne Mac, så du kan læse og søge uden forbindelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "E-Mails auf diesem Mac, damit du ohne Verbindung lesen und suchen kannst."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Email αποθηκευμένα σε αυτό το Mac, για ανάγνωση και αναζήτηση χωρίς σύνδεση."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Correo guardado en este Mac para leer y buscar sin conexión."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ایمیل‌های نگه‌داشته‌شده روی این Mac، تا بدون اتصال بخوانید و جستجو کنید."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tälle Macille tallennetut viestit, joita voi lukea ja hakea ilman yhteyttä."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail na nakatago sa Mac na ito, para makabasa at makapaghanap ka kahit walang koneksyon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les e-mails conservés sur ce Mac, pour lire et chercher sans connexion."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "דואר שנשמר ב-Mac הזה, כדי לקרוא ולחפש ללא חיבור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Mac पर रखी गई मेल, ताकि आप बिना कनेक्शन के पढ़ और खोज सकें।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošta spremljena na ovom Macu, da možete čitati i pretraživati bez veze."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Ezen a Macen tárolt levelek, hogy kapcsolat nélkül is olvashasson és kereshessen."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Email yang disimpan di Mac ini, agar Anda bisa membaca dan mencari tanpa koneksi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Posta conservata su questo Mac, per leggere e cercare senza connessione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このMacに保存されたメール。接続がなくても読んだり検索したりできます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Mac에 보관된 메일로, 연결 없이도 읽고 검색할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mel disimpan pada Mac ini, supaya anda boleh membaca dan mencari tanpa sambungan."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "E-post lagret på denne Macen, så du kan lese og søke uten tilkobling."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mail die op deze Mac wordt bewaard, zodat je zonder verbinding kunt lezen en zoeken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poczta przechowywana na tym Macu, by czytać i szukać bez połączenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mails guardados neste Mac, para ler e buscar sem conexão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "E-mailuri păstrate pe acest Mac, ca să poți citi și căuta fără conexiune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Почта хранится на этом Mac, чтобы читать и искать без подключения."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Pošta uložená na tomto Macu, aby ste mohli čítať a hľadať bez pripojenia."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошта сачувана на овом Mac-у, да бисте могли да читате и претражујете без везе."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Post som sparas på den här Macen så att du kan läsa och söka utan anslutning."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Barua zilizohifadhiwa kwenye Mac hii, ili uweze kusoma na kutafuta bila muunganisho."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "ఈ Macలో ఉంచిన మెయిల్, కనెక్షన్ లేకుండా చదవడానికి, సెర్చ్ చేయడానికి."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อีเมลที่เก็บไว้บน Mac เครื่องนี้ จึงอ่านและค้นหาได้โดยไม่ต้องเชื่อมต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Mac'te saklanan postalar; bağlantı olmadan okuyup arayabilirsiniz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пошта зберігається на цьому Mac, щоб читати й шукати без підключення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Mac پر رکھی گئی میل، تاکہ آپ کنکشن کے بغیر پڑھ اور تلاش کر سکیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thư lưu trên máy Mac này để bạn đọc và tìm kiếm khi không có kết nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保存在此 Mac 上的邮件,无需联网即可阅读和搜索。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "儲存在此 Mac 上的郵件,無需連線即可閱讀和搜尋。"
          }
        }
      }
    },
