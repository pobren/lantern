          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Det är den enda etiketten på mejlet. Arkivera eller flytta det i stället."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hiyo ndiyo lebo pekee kwenye barua pepe hii. Ihifadhi au uihamishe badala yake."
