        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد حذف كل رسائل %@ في بريدك الوارد؟"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ইনবক্সে %@-এর সব ইমেল মুছবেন?"
