    "We'll tell the sender to stop, straight away.": {
      "extractionState": "manual",
      "localizations": {
        "af": {
          "stringUnit": {
            "state": "translated",
            "value": "Ons sal die sender dadelik sê om op te hou."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سنطلب من المرسل التوقف فورًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমরা প্রেরককে এখনই বন্ধ করতে বলব।"
          }
        },
        "ca": {
          "stringUnit": {
            "state": "translated",
            "value": "Direm al remitent que pari, de seguida."
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odesílateli hned řekneme, ať přestane."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi beder afsenderen om at stoppe med det samme."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wir sagen dem Absender sofort, dass er aufhören soll."
          }
        },
        "el": {
          "stringUnit": {
            "state": "translated",
            "value": "Θα πούμε στον αποστολέα να σταματήσει, αμέσως."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Le diremos al remitente que pare, de inmediato."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همین الان به فرستنده می‌گوییم متوقف شود."
          }
        },
        "fi": {
          "stringUnit": {
            "state": "translated",
            "value": "Pyydämme lähettäjää lopettamaan heti."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sasabihan namin agad ang sender na tumigil."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Nous demanderons à l’expéditeur d’arrêter, tout de suite."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נבקש מהשולח להפסיק, מיד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हम प्रेषक को तुरंत रुकने के लिए कहेंगे।"
          }
        },
        "hr": {
          "stringUnit": {
            "state": "translated",
            "value": "Odmah ćemo reći pošiljatelju da prestane."
          }
        },
        "hu": {
          "stringUnit": {
            "state": "translated",
            "value": "Azonnal szólunk a feladónak, hogy hagyja abba."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami akan langsung meminta pengirim berhenti."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Diremo subito al mittente di smettere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "差出人にすぐに停止を依頼します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "발신자에게 즉시 중단을 요청합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kami akan memberitahu penghantar untuk berhenti, serta-merta."
          }
        },
        "nb": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi ber avsenderen slutte, med en gang."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "We vragen de afzender meteen om te stoppen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Od razu powiemy nadawcy, żeby przestał."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Vamos pedir ao remetente para parar, agora mesmo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Îi vom spune expeditorului să se oprească, imediat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Мы сразу попросим отправителя прекратить."
          }
        },
        "sk": {
          "stringUnit": {
            "state": "translated",
            "value": "Odosielateľovi hneď povieme, nech prestane."
          }
        },
        "sr": {
          "stringUnit": {
            "state": "translated",
            "value": "Одмах ћемо рећи пошиљаоцу да престане."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Vi ber avsändaren att sluta, direkt."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutamwambia mtumaji aache, mara moja."
          }
        },
        "te": {
          "stringUnit": {
            "state": "translated",
            "value": "పంపడం ఆపమని పంపినవారికి వెంటనే చెబుతాము."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เราจะแจ้งให้ผู้ส่งหยุดส่งทันที"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Göndericiye durmasını hemen söyleyeceğiz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ми одразу попросимо відправника припинити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہم بھیجنے والے کو فوراً رکنے کو کہیں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chúng tôi sẽ báo người gửi dừng ngay lập tức."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我们会立即告诉发件人停止发送。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我們會立即通知寄件人停止寄送。"
          }
        }
      }
    },
